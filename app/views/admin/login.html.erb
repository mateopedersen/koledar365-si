<section class="panel tool-panel"><h1>Prijava v uredništvo</h1><% if @error %><p class="error"><%= @error %></p><% end %><%= form_with url:'/upravljanje/prijava/' do |f| %><%= f.label :email,'E-pošta' %><%= f.email_field :email,required:true,autocomplete:'username' %><%= f.label :password,'Geslo' %><%= f.password_field :password,required:true,autocomplete:'current-password' %><%= f.submit 'Prijavi se' %><% end %></section>
