<% festivals = OccasionCatalog.festivals; featured = OccasionCatalog.festival('kurentovanje') %>
<% years = festivals.flat_map { |festival| festival.fetch('editions').flat_map { |edition| dates = OccasionCatalog.date_range(edition); [dates.begin.year, dates.end.year] } }.uniq.sort %>
<article class="festival-directory" data-festival-directory>
  <header class="festival-masthead">
    <div class="festival-masthead__copy">
      <p class="festival-kicker"><%= slovenia_flag %> Po Sloveniji</p>
      <h1><%= @title %></h1>
      <p>Načrtujete obisk pustne povorke, koncerta ali krajevnega praznika? Poiščite prireditev po kraju. Na vsaki strani so zgodba dogodka, opis programa, prizorišče in objavljeni termini.</p>
      <a class="festival-primary" href="#festivalski-katalog">Poišči prireditev <%= ui_icon('arrow') %></a>
    </div>
    <%= link_to OccasionCatalog.festival_detail_path(featured.fetch('slug')), class: 'festival-masthead__photo' do %>
      <%= render 'festival_image', photo: OccasionCatalog.festival_photo(featured), eager: true %>
      <span class="festival-masthead__caption"><span>Iz arhiva · Ptuj</span><strong>Kurentovanje</strong></span>
      <span class="festival-cover-arrow" aria-hidden="true"><%= ui_icon('arrow') %></span>
    <% end %>
  </header>

  <section id="festivalski-katalog" aria-labelledby="festival-catalog-title">
    <div class="festival-results-head"><h2 id="festival-catalog-title">Raziskujte prireditve</h2><p data-festival-count role="status">Prikazane prireditve: <%= festivals.size %></p></div>
    <form class="festival-filters" data-festival-filters hidden>
      <label class="festival-filter-search"><span>Išči</span><input type="search" name="q" placeholder="Ime prireditve ali kraja" maxlength="100" autocomplete="off"></label>
      <label><span>Kraj</span><select name="kraj"><option value="">Vsi kraji</option><% OccasionCatalog.places.each do |place| %><option value="<%= OccasionCatalog.place_key(place) %>"><%= place == 'Slovenija' ? 'Po Sloveniji' : place %></option><% end %></select></label>
      <label><span>Vrsta prireditve</span><select name="vrsta"><option value="">Vse vrste</option><% OccasionCatalog::KINDS.each do |key, title| %><option value="<%= key %>"><%= title %></option><% end %></select></label>
      <label><span>Leto termina</span><select name="leto"><option value="">Vsa leta</option><% years.each do |year| %><option><%= year %></option><% end %></select></label>
      <button type="reset">Počisti filtre</button>
    </form>
    <% upcoming = OccasionCatalog.upcoming(@today, limit: 4) %>
    <% if upcoming.any? %>
      <section class="festival-agenda" data-festival-agenda id="festivalski-koledar" aria-labelledby="festival-agenda-title">
        <h3 id="festival-agenda-title">Naslednji potrjeni termini</h3>
        <div class="festival-agenda__grid">
          <% upcoming.each do |festival, _, dates| %>
            <%= link_to OccasionCatalog.festival_detail_path(festival.fetch('slug')), class: 'festival-agenda__item' do %>
              <span class="festival-agenda__date"><strong><%= dates.begin.day %></strong><span><%= l(dates.begin, format: '%b').delete_suffix('.') %>.</span></span>
              <span class="festival-agenda__copy"><strong><%= festival.fetch('title') %></strong><small><%= festival.fetch('place') %> · <%= occasion_date_label(dates.begin, dates.end) %></small></span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
    <p class="festival-empty" data-festival-empty hidden>Za to izbiro ni prireditev. Poskusite z drugim krajem, izrazom ali letom.</p>
    <div class="festival-grid">
      <% festivals.each do |festival| %>
        <% slug = festival.fetch('slug'); kind = festival.fetch('kind'); photo = OccasionCatalog.festival_photo(festival); editions = festival.fetch('editions').map { |edition| OccasionCatalog.date_range(edition) }; upcoming_dates = editions.find { |range| range.end >= @today } %>
        <% edition_years = editions.flat_map { |range| (range.begin.year..range.end.year).to_a }.uniq %>
        <article class="festival-card" id="<%= slug %>" data-festival-card data-place="<%= OccasionCatalog.festival_places(festival).map { |place| OccasionCatalog.place_key(place) }.join(' ') %>" data-kind="<%= kind %>" data-years="<%= edition_years.join(' ') %>" data-search="<%= OccasionCatalog.festival_search_text(festival) %>">
          <%= link_to OccasionCatalog.festival_detail_path(slug), class: 'festival-card__link' do %>
            <div class="festival-card__cover">
              <%= render 'festival_image', photo: photo, eager: false %>
              <span class="festival-card__category"><%= OccasionCatalog::KINDS.fetch(kind) %></span>
              <span class="festival-card__photo-label"><%= festival_photo_label(photo) %></span>
            </div>
            <div class="festival-card__body">
              <p class="festival-place"><%= ui_icon('pin') %><%= festival.fetch('place') %></p>
              <h3><%= festival.fetch('title') %></h3>
              <div class="festival-card__bottom">
                <% if upcoming_dates %>
                  <span class="festival-status is-confirmed" data-festival-date=""><%= occasion_date_label(upcoming_dates.begin, upcoming_dates.end) %></span>
                <% else %>
                  <span class="festival-status" data-festival-date=""><%= festival['edition_year'] ? 'Potrjeno prizorišče' : 'Termin še ni objavljen' %></span>
                <% end %>
                <% edition_years.each do |year|; dates = editions.find { |range| (range.begin.year..range.end.year).cover?(year) } %>
                  <span class="festival-status <%= 'is-confirmed' if dates.end >= @today %>" data-festival-date="<%= year %>" hidden><%= 'Arhiv · ' if dates.end < @today %><%= occasion_date_label(dates.begin, dates.end) %></span>
                <% end %>
                <span class="festival-cover-arrow" aria-hidden="true"><%= ui_icon('arrow') %></span>
              </div>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </section>
  <section class="festival-footer">
    <h2>Načrtujte obisk</h2>
    <p>»Potrjen termin« označuje datum, ki ga navaja organizator ali drug uradni vir. Arhivski datum pomaga pri orientaciji, za naslednjo izvedbo pa počakajte na novo objavo. Na posamezni strani lahko objavljeni termin dodate v koledar.</p>
    <nav aria-label="Načrtovanje obiska"><%= link_to 'Prazniki in dela prosti dnevi', '/prazniki/' %><%= link_to 'Šolske počitnice', '/solske-pocitnice/' %><%= link_to 'Fotografije in licence', '/fotografije-in-licence/#fotografije-festivalov' %></nav>
  </section>
</article>
