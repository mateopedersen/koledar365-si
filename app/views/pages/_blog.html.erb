<% if @blog_article %>
  <% article = @blog_article; slug = page_path.delete_prefix(EditorialCatalog::HUB).delete_suffix('/') %>
  <% photo = article.fetch('photo') %>
  <article class="editorial-article">
    <header class="editorial-article__header">
      <p class="editorial-kicker"><%= article.fetch('category') %></p>
      <h1><%= @title %></h1>
      <p class="editorial-lead"><%= article.fetch('lead') %></p>
      <div class="editorial-byline">
        <%= link_to site_operator_name, EditorialCatalog::AUTHOR_PATH, rel: 'author' %>
        <span>Datum prispevka: <%= editorial_date(article) %></span>
      </div>
    </header>
    <figure class="editorial-cover">
      <img src="<%= EditorialCatalog.image(slug) %>" alt="<%= article.fetch('image_alt') %>" width="1200" height="630" fetchpriority="high">
      <figcaption>Foto: <%= photo.fetch('credit') %> · <%= link_to 'Izvirna objava', photo.fetch('source') %> · <%= link_to photo.fetch('license'), photo.fetch('license_url') %> · <a href="/fotografije-in-licence/#blog-<%= slug %>">Podatki o fotografiji</a></figcaption>
    </figure>
    <div class="editorial-article__body">
      <% article.fetch('sections').each do |section| %>
        <section>
          <h2><%= section.fetch('heading') %></h2>
          <% section.fetch('paragraphs').each do |paragraph| %><p><%= editorial_paragraph(paragraph) %></p><% end %>
        </section>
      <% end %>
      <section class="editorial-related">
        <h2>Koledarji in orodja iz vodnika</h2>
        <ul>
          <% article.fetch('related').each do |route| %>
            <li><a href="<%= route %>"><%= editorial_route_title(route) %></a></li>
          <% end %>
        </ul>
        <h2>Viri</h2>
        <ul>
          <% article.fetch('sources').each do |key|; label, url = EditorialCatalog.sources.fetch(key) %>
            <li><a href="<%= url %>"><%= label %></a></li>
          <% end %>
        </ul>
        <h2>Sorodni vodniki</h2>
        <ul>
          <% article.fetch('related_articles').each do |route| %>
            <li><a href="<%= route %>"><%= EditorialCatalog.article(route).fetch('title') %></a></li>
          <% end %>
        </ul>
        <a href="<%= EditorialCatalog::HUB %>">Vsi vodniki za koledar in načrtovanje</a>
      </section>
    </div>
    <%= render 'layouts/social_share', sharing_image: seo_image unless @noindex && Rails.env.production? %>
  </article>
<% else %>
  <div class="editorial-article__header">
    <h1><%= @title %></h1>
    <p class="editorial-lead"><%= @description %></p>
  </div>
  <% EditorialCatalog.articles.group_by { |_, article| article.fetch('category') }.each do |category, entries| %>
    <section class="editorial-index">
      <h2><%= category %></h2>
      <div class="editorial-index__cards">
        <% entries.each do |slug, article| %>
          <article>
            <a href="<%= EditorialCatalog.path(slug) %>">
              <img src="<%= EditorialCatalog.image(slug) %>" alt="<%= article.fetch('image_alt') %>" width="1200" height="630" loading="lazy" decoding="async">
              <div><h3><%= article.fetch('title') %></h3><p><%= article.fetch('description') %></p><small><%= editorial_date(article) %></small></div>
            </a>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
