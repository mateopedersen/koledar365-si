<% main_links = [['Koledar', '/koledar/', 'calendar'], ['Prazniki', '/prazniki/', 'holidays'], ['Šolske počitnice', '/solske-pocitnice/', 'school-break']] %>
<% shortcut_links = [['Koledarji PDF', '/koledar-za-tiskanje/', 'pdf-calendars'], ['Delovni dnevi', '/delovni-dnevi/', 'workdays'], ['Datumski kalkulator', '/datumski-kalkulator/', 'date-calculator']] %>
<% main_destination = (main_links + shortcut_links).any? { |_, href, _| href == page_path } %>
<header class="topbar">
  <%= render 'layouts/brand' %>
  <nav aria-label="Glavna navigacija">
    <% main_links.each do |label, href, icon| %>
      <%= link_to href, aria: { current: page_path == href ? 'page' : nil } do %><%= navigation_icon(icon) %><span><%= label %></span><% end %>
    <% end %>
  </nav>
  <% if @section == 'home' %>
    <% next_header_holiday = @upcoming&.find(&:work_free) %>
    <% if next_header_holiday %>
      <% header_holiday_days = (next_header_holiday.on - @today).to_i %>
      <%= link_to event_path(next_header_holiday), class: 'home-header-spotlight' do %>
        <span class="home-header-spotlight__icon" aria-hidden="true"><%= ui_icon('holidays') %></span>
        <span class="home-header-spotlight__content">
          <span class="home-header-spotlight__eyebrow">NASLEDNJI DELA PROST DAN</span>
          <span class="home-header-spotlight__event"><time datetime="<%= next_header_holiday.on.iso8601 %>"><%= next_header_holiday.on.strftime('%-d. %-m.') %></time><span aria-hidden="true"> · </span><strong><%= next_header_holiday.title.sub(/^./, &:upcase) %></strong></span>
          <small><%= header_holiday_days.zero? ? 'Danes' : header_holiday_days == 1 ? 'Še 1 dan' : "Še #{header_holiday_days} dni" %></small>
        </span>
        <span class="home-header-spotlight__arrow" aria-hidden="true"><%= ui_icon('arrow') %></span>
      <% end %>
    <% else %>
      <a class="home-header-spotlight home-header-spotlight--empty" href="/prazniki/">
        <span class="home-header-spotlight__icon" aria-hidden="true"><%= ui_icon('holidays') %></span>
        <span class="home-header-spotlight__content">
          <span class="home-header-spotlight__eyebrow">SLOVENSKI PRAZNIKI</span>
          <span class="home-header-spotlight__event"><strong>Koledar dela prostih dni</strong></span>
          <small>Pregled praznikov skozi leto</small>
        </span>
        <span class="home-header-spotlight__arrow" aria-hidden="true"><%= ui_icon('arrow') %></span>
      </a>
    <% end %>
  <% end %>
  <form action="/isci/" class="search" role="search" data-site-search>
    <label class="sr-only" for="search">Poišči datum, dogodek ali orodje</label>
    <input id="search" data-search-input name="q" type="search" autocomplete="off" placeholder="Išči datum, praznik ali orodje" value="<%= @q %>">
    <button aria-label="Išči po spletnem mestu"><%= ui_icon('search') %></button>
    <div class="site-search-suggestions" data-search-suggestions hidden><p class="site-search-status" data-search-status role="status" aria-live="polite" hidden></p><div id="site-search-suggestions" data-search-options role="listbox" aria-label="Predlogi iskanja"></div></div>
  </form>
  <span class="country" role="img" aria-label="Slovenija"><%= slovenia_flag %><span class="country-label">Slovenija</span></span>
</header>
<nav class="subnav site-navigation" aria-label="Koledarji in orodja">
  <div class="subnav-track">
    <div class="nav-years" role="group" aria-label="Letni koledarji">
      <span class="nav-years__label"><%= navigation_icon('year-calendars') %><span>Koledarji</span></span>
      <% (2027..2030).each do |year| %>
        <%= link_to year, "/koledar/#{year}/", aria: { label: "Koledar #{year}", current: page_path == "/koledar/#{year}/" ? 'page' : nil } %>
      <% end %>
    </div>
    <% shortcut_links.each do |label, href, icon| %>
      <%= link_to href, class: 'nav-shortcut', aria: { current: page_path == href ? 'page' : nil } do %><%= navigation_icon(icon) %><span><%= label %></span><% end %>
    <% end %>
    <%= render 'layouts/tools_menu', main_destination: main_destination %>
  </div>
</nav>
