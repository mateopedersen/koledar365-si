<% education = @education_calendar || EducationCalendar.new(path: @page.path); config = education.config; kind = education.kind; rows = education.filtered; upcoming = education.next_event; reviewed = education.data.fetch("reviewedAt") %>
<article class="education-page topic-experience" data-education-page data-kind="<%= kind %>">
  <nav class="ed-navigation" aria-label="Šola in študij"><% EducationCalendar::LINKS.each do |label,href| %><a href="<%= href %>" <%= 'aria-current=page' if href == education.path %>><%= label %></a><% end %></nav>
  <header class="ed-hero">
    <div class="ed-hero-copy"><span class="ed-eyebrow"><i></i><%= config[:eyebrow] %></span><h1><%= config[:heading] %></h1><p><%= config[:intro] %></p><a class="ed-jump" href="#moj-pregled">Sestavite svoj pregled <span aria-hidden="true">↘</span></a><div class="ed-verification">Uradni viri v slovenščini <span>·</span> Preverjeno <time datetime="<%= reviewed %>"><%= education.date_label(reviewed) %></time></div></div>
    <%= render 'pages/topic_art', eager: true %>
  </header>
  <%= render 'pages/topic_snapshot' %>

  <% if kind == 'matura' %><nav class="ed-type-links" aria-label="Vrsta mature"><a href="/matura/2027/splosna/" <%= 'aria-current=page' if config[:exam_type] == 'general' %>><span>01</span><strong>Splošna matura</strong><small>Predmeti in ravni zahtevnosti</small><b aria-hidden="true">↗</b></a><a href="/matura/2027/poklicna/" <%= 'aria-current=page' if config[:exam_type] == 'vocational' %>><span>02</span><strong>Poklicna matura</strong><small>Drugi in četrti predmet po programu</small><b aria-hidden="true">↗</b></a></nav><% end %>
  <% if kind == 'npz' %><nav class="ed-grade-links" aria-label="NPZ po razredih"><% [3,6,9].each do |grade| %><a href="/npz/<%= grade %>-razred/" <%= 'aria-current=page' if config[:grade] == grade.to_s %>><strong><%= grade %>.</strong> razred <span aria-hidden="true">↗</span></a><% end %></nav><% end %>

  <section class="ed-workspace" id="moj-pregled" aria-labelledby="ed-workspace-title">
    <section class="ed-filter-panel" aria-label="Filtri prikazanih datumov">
      <div class="ed-panel-heading"><span class="ed-step">01</span><div><h2 id="ed-workspace-title">Vaš pregled</h2><p>Izberite podatke, ki jih potrebujete.</p></div></div>
      <form class="ed-filters" data-ed-filters>
        <% if kind == 'school' %>
          <label>Raven izobraževanja<select name="level"><option value="primary">Osnovna šola</option><option value="secondary">Srednja šola</option></select></label>
          <label data-ed-primary>Razred<select name="grade"><option value="all">Vsi razredi</option><% (1..9).each do |grade| %><option value="<%= grade %>"><%= grade %>. razred</option><% end %></select></label>
          <label data-ed-secondary hidden>Letnik<select name="stage"><option value="all">Vsi letniki</option><option value="final">Zaključni letniki</option><option value="other">Drugi letniki</option></select></label>
          <label>Lokacija šole<select name="region"><option value="west">Zahodna skupina</option><option value="east">Vzhodna skupina</option></select></label>
          <details class="ed-region-help"><summary>V katero skupino spada šola?</summary><p><strong>Vzhodna:</strong> jugovzhodna Slovenija (razen spodaj navedenih občin), koroška, podravska, pomurska, savinjska in posavska regija.</p><p><strong>Zahodna:</strong> gorenjska, goriška, notranjsko-kraška, obalno-kraška, osrednjeslovenska in zasavska regija ter občine Ribnica, Sodražica, Loški Potok, Kočevje, Osilnica in Kostel.</p></details>
        <% elsif kind == 'matura' %>
          <% if config[:exam_type] %><input type="hidden" name="examType" value="<%= config[:exam_type] %>"><p class="ed-fixed-choice"><%= config[:exam_type] == 'general' ? 'Splošna matura' : 'Poklicna matura' %></p><% else %><label>Vrsta mature<select name="examType"><option value="general">Splošna matura</option><option value="vocational">Poklicna matura</option></select></label><% end %>
          <label>Izpitni rok<select name="session"><option value="spring">Spomladanski rok</option><option value="autumn">Jesenski rok</option><option value="all">Oba roka</option></select></label>
          <fieldset class="ed-subjects"><legend>Moji predmeti</legend><p>Če ne izberete nobenega, so prikazani vsi. Skupni roki ostanejo v pregledu.</p><input type="search" data-ed-subject-search aria-label="Poišči predmet" placeholder="Poišči predmet…" autocomplete="off"><div data-ed-subjects><% education.events.select { |e| e['examType'] == education.initial['examType'] }.flat_map { |e| e['subjects'] || [] }.uniq.sort_by { |id| education.data['subjects'][id] }.each do |subject| %><label><input type="checkbox" name="subject" value="<%= subject %>"><span><%= education.data['subjects'][subject] %></span></label><% end %></div></fieldset>
        <% elsif kind == 'npz' %>
          <% if config[:grade] %><input type="hidden" name="grade" value="<%= config[:grade] %>"><p class="ed-fixed-choice"><%= config[:grade] %>. razred</p><% else %><label>Razred<select name="grade"><option value="all">3., 6. in 9. razred</option><% [3,6,9].each do |grade| %><option value="<%= grade %>"><%= grade %>. razred</option><% end %></select></label><% end %>
        <% elsif kind == 'study' %>
          <label>Univerza ali članica<select name="institution"><option value="all">Vsi preverjeni koledarji</option><% education.data['institutions'].each do |institution| %><option value="<%= institution['id'] %>" <%= 'selected' if institution['id'] == 'ul' %>><%= institution['name'] %></option><% end %></select></label><p class="ed-scope" data-ed-institution-note><%= education.data['institutions'].first['note'] %></p>
        <% end %>
        <label>Vrsta dogodka<select name="category"><option value="all">Vsi dogodki</option><% education.events.map { |e| e['category'] }.uniq.each do |category| %><option value="<%= category %>"><%= education.data['categories'][category] %></option><% end %></select></label>
        <label class="ed-check"><input type="checkbox" name="upcoming"><span>Samo prihodnji in tekoči dogodki</span></label>
        <button type="reset" class="ed-reset" data-ed-requires-js disabled>Ponastavi filtre</button>
      </form>
      <div class="ed-personal-help"><span class="ed-step">02</span><h3>Shranite pomembne datume</h3><p>Označite posamezne dogodke ali prenesite celoten prikaz. Datoteko ICS lahko uvozite v svoj koledar.</p><a href="#ed-sources">Kako preverjamo datume <span aria-hidden="true">↓</span></a></div>
    </section>

    <div class="ed-results">
      <section class="ed-next" aria-labelledby="ed-next-title"><div><span class="ed-eyebrow" id="ed-next-title">NASLEDNJI DATUM</span><strong data-ed-next-title><%= upcoming ? upcoming['title'] : 'V tem pregledu ni prihodnjih datumov.' %></strong><p data-ed-next-context><%= upcoming ? education.context(upcoming) : 'Pregled vsebuje objavljene termine za leto 2026/2027.' %></p></div><time data-ed-next-date datetime="<%= upcoming&.dig('start') %>"><%= upcoming && education.date_label(upcoming['start']) %></time></section>
      <div class="ed-results-top"><div><h2>Koledar dogodkov</h2><p data-ed-count aria-live="polite"><%= rows.length %> dogodkov v izbranem pregledu</p></div><div class="ed-view-switch" role="group" aria-label="Način prikaza"><button type="button" data-ed-view="list" aria-pressed="true" data-ed-requires-js disabled>Seznam</button><button type="button" data-ed-view="year" aria-pressed="false" data-ed-requires-js disabled>Letni pregled</button></div></div>
      <% if kind == 'matura' %><p class="ed-context-note">Ustni izpiti so prikazani kot uradno obdobje. Osebni dan in uro določi šola. Roki za splošno in poklicno maturo se razlikujejo.</p><% elsif kind == 'study' %><p class="ed-context-note">Semestri, izpitna obdobja in izrecno objavljeni prosti dnevi imajo različne oznake. Posamezen izpitni termin določi fakulteta.</p><% end %>
      <div class="topic-quick-filters" role="group" aria-label="Hiter izbor vrste dogodka"><span>Hitri izbor</span><% education.events.map { |e| e['category'] }.uniq.first(5).each do |category| %><button type="button" data-topic-category="<%= category %>"><%= education.data['categories'][category] %></button><% end %><button type="button" data-topic-category="all">Vsi dogodki</button></div>
      <div class="ed-export-bar"><div><button type="button" data-ed-select-all data-ed-requires-js disabled>Označi prikazane</button><button type="button" data-ed-clear data-ed-requires-js disabled>Počisti izbor</button><span data-ed-selected-count aria-live="polite">Izbrano: 0</span></div><div><button type="button" data-ed-print data-ed-requires-js disabled>Natisni / shrani PDF</button><button type="button" class="ed-primary" data-ed-ics data-ed-requires-js disabled>Prenesi prikazane · ICS</button></div></div>
      <p class="ed-export-note" data-ed-export-note>Izvoz zajame vse prikazane dogodke. Ko označite dogodke, se izvoz omeji na označene v tem pregledu.</p>
      <noscript><p class="ed-context-note">Spodaj so uradni datumi za začetno izbiro. Za filtre, osebni izbor in izvoz omogočite JavaScript. Stran lahko natisnete z ukazom brskalnika.</p></noscript>
      <div class="ed-year-view" data-ed-year hidden></div><output class="ed-day-detail" data-ed-day-detail hidden aria-live="polite"></output>
      <div class="ed-timeline" data-ed-list>
        <% rows.group_by { |event| event['start'][0,7] }.each do |month,items| %><section class="ed-month-group"><h3><%= CalendarEngine::MONTHS.fetch(month[5,2].to_i-1).capitalize %> <%= month[0,4] %></h3><div><% items.each do |event| %><article class="ed-event" data-event-id="<%= event['id'] %>" data-category="<%= event['category'] %>"><label class="ed-event-select"><input type="checkbox" data-ed-select="<%= event['id'] %>" aria-label="Izberi: <%= event['title'] %>, <%= education.range_label(event) %>"></label><div class="ed-event-date"><time datetime="<%= event['start'] %>"><%= education.range_label(event) %></time><span><%= education.data['categories'][event['category']] %></span></div><div class="ed-event-copy"><h4><%= event['title'] %></h4><% unless education.context(event).empty? %><small><%= education.context(event) %></small><% end %><% if event['note'] %><p><%= event['note'] %></p><% end %><a href="<%= education.source(event['source'])['url'] %>" target="_blank" rel="noopener">Uradni vir <span aria-hidden="true">↗</span></a></div></article><% end %></div></section><% end %>
      </div>
      <div class="ed-empty" data-ed-empty hidden><strong>Za to izbiro ni dogodkov.</strong><p>Spremenite vrsto dogodka, razred ali izpitni rok. Pretekle datume vključite tako, da izključite filter prihodnjih dogodkov.</p></div>
      <div class="ed-print-sheet" data-ed-print-sheet></div>
    </div>
  </section>

  <%= render 'pages/topic_guide' %>
  <section class="ed-reading"><div><span class="ed-eyebrow">PREDEN SHRANITE KOLEDAR</span><h2>Datumi v pravem kontekstu</h2></div><div><% education.questions.each do |question,answer| %><details><summary><%= question %></summary><p><%= answer %></p></details><% end %></div></section>
  <section class="ed-sources" id="ed-sources" aria-labelledby="ed-sources-title"><div><span class="ed-eyebrow">VIRI IN METODA</span><h2 id="ed-sources-title">Preverljivo do izvirnika.</h2><p>Datume povzemamo iz slovenskih objav ministrstva, Državnega izpitnega centra in izbranih univerz oziroma članic. Vsak dogodek vodi do svojega vira.</p><p>Datume in razlike med programi smo preverili <time datetime="<%= reviewed %>"><%= education.date_label(reviewed) %></time>. Uredniški pregled: <strong>Koledar365</strong>.</p></div><div><ol><% education.sources.each do |source| %><li><a href="<%= source['url'] %>" target="_blank" rel="noopener"><%= source['title'] %> <span aria-hidden="true">↗</span></a></li><% end %></ol><p>Prikazane so objavljene meje obdobij, vključno s prvim in zadnjim dnevom. Pri ustnih izpitih in univerzitetnih obdobjih ne sklepamo o osebnem terminu. Neobjavljenih prihodnjih šolskih let ne ocenjujemo.</p><div class="ed-source-links"><a href="/uredniska-politika/">Uredniška pravila</a><a href="/kontakt/">Sporočite popravek →</a></div></div></section>
  <script type="application/json" id="education-data"><%= raw json_escape(education.payload.to_json) %></script>
  <div class="ed-toast" role="status" aria-live="polite" data-ed-toast hidden></div>
</article>
