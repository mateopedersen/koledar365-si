<% slug=page_path.split('/').last;topic_events=CalendarEvent.where(slug:slug).ordered;is_topic=topic_events.exists? %>
<% if is_topic %><section class="panel prose"><p><%= TopicContent.body(slug) %></p><%= render 'event_table',events:topic_events %><div class="source-note"><strong>Viri in preverjanje</strong><p><%= source_link(topic_events.first.source_url,'Vir za koledarski datum') %></p><% TopicContent.references(slug).each do |ref| %><p><%= source_link(ref['url'],ref['title']) %> · preverjeno <time datetime="<%= ref['checked_on'] %>"><%= I18n.l(Date.iso8601(ref['checked_on'])) %></time></p><% end %><a href="/uredniska-politika/">Uredniška pravila</a> · <a href="/kontakt/">Predlagajte popravek</a></div><% if page_path.start_with?('/letni-casi/') %><% AstronomicalEvent.where(kind:slug).order(:instant).each do |a| %><p><%= I18n.l(a.local_time) %> (Europe/Ljubljana), <%= a.instant.utc.strftime('%H:%M UTC') %>.</p><% end %><p>Meteorološki letni časi se začnejo prvega dne marca, junija, septembra in decembra. Astronomski začetki sledijo položaju Zemlje glede na Sonce.</p><% end %></section>
<% else %><section class="panel"><%= render 'year_selector' %><form method="get" class="filters"><input type="hidden" name="year" value="<%= @year %>"><label>Mesec<select name="month"><option value="0">Vsi meseci</option><% CalendarEngine::MONTHS.each_with_index do |m,i| %><option value="<%= i+1 %>" <%= 'selected' if params[:month].to_i==i+1||@page.month==i+1 %>><%= m %></option><% end %></select></label><label>Vrsta<select name="category"><option value="">Vse vrste</option><option value="legal">Prazniki po zakonu</option><option value="cultural">Kulturni dnevi</option><option value="religious">Verski dnevi</option><option value="international">Mednarodni dnevi</option><option value="astronomical">Astronomski dogodki</option></select></label><button>Filtriraj</button></form><% events=@events;events=events.select { |e| e.category=='legal' } if page_path.start_with?('/prazniki/');events=events.select { |e| e.on.month==(@page.month||params[:month].to_i) } if @page.month||params[:month].to_i>0;events=events.select { |e| e.category.to_s.include?(params[:category]) } if params[:category].present? %><%= render 'event_table',events:events %><div class="actions"><% if CalendarEngine::YEARS.include?(@year) %><a class="button" href="/prazniki/<%= @year %>.ics?all=1">Prenesi dogodke ICS</a><% end %><button data-print>Natisni</button></div><p class="muted">Državni praznik, dela prost dan in šolske počitnice so različne kategorije. Kulturni ali mednarodni dan sam po sebi ne pomeni prostega delovnega dne. Zbirka vključuje preverjene ponavljajoče se dneve; programi lokalnih prireditev niso napovedani.</p></section><% end %>
<% related=Page.where(family:['Özel gün ve mevsimler','Ek önemli gün konuları']).where.not(path:page_path);related=related.where("path LIKE '/prazniki/%'") if page_path.start_with?('/prazniki/');related=related.limit(8) if is_topic %>
<section class="related-topics"><h2><%= is_topic ? 'Sorodni datumi' : 'Prazniki in običaji po temah' %></h2><div class="link-grid"><% related.each do |p| %><a href="<%= p.path %>"><%= p.title %></a><% end %></div><% if is_topic %><a href="/pomembni-dnevi/">Vsi pomembni dnevi →</a><% end %></section>
