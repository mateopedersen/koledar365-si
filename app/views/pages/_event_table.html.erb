<% if events.empty? %><p class="empty">Za izbrano obdobje v zbirki ni dogodkov.</p><% else %><div class="table-wrap"><table class="data-table" aria-label="Datumi dogodkov in status dela prostega dne"><thead><tr><th scope="col">Datum</th><th scope="col">Dan</th><th scope="col">Dogodek</th><th scope="col">Dela prost dan</th></tr></thead><tbody><% events.each do |e| %><tr><td><a href="<%= calendar_path(e.on) %>"><%= I18n.l(e.on) %></a></td><td><%= CalendarEngine::DAYS[e.on.cwday-1] %></td><td><a href="<%= event_path(e) %>"><%= e.title %></a></td><td><%= e.work_free||CalendarEvent.exists?(on:e.on,work_free:true) ? 'Da':'Ne' %></td></tr><% end %></tbody></table></div><% end %>
