<% city=CityCatalog.default %><section class="panel today-panel" id="city-card" data-cities-url="/cities.json"><h2><%= ui_icon('pin') %> Danes v Sloveniji</h2>
<figure class="city-photo"><img id="city-photo" src="<%= city.dig('photo','local_path') %>" alt="<%= city['name'] %> – pogled na mesto" width="960" height="600" fetchpriority="high"><figcaption><span id="city-caption"><%= city['name'] %>, Slovenija</span><a id="city-credit" href="/fotografije-in-licence/#<%= city['id'] %>" aria-label="Avtor in licenca fotografije"><%= ui_icon('info') %></a></figcaption></figure>
<p class="today-date" id="city-today"><%= CalendarEngine::DAYS[@today.cwday-1].capitalize %>, <%= sl_date(@today) %></p>
<div class="time-row"><time id="ljubljana-clock" aria-label="Krajevni čas"><%= Time.current.strftime('%H:%M') %></time><div class="city-picker"><label for="city-select" class="sr-only">Izberite mesto v Sloveniji</label><select id="city-select"><% CityCatalog.all.each do |c| %><option value="<%= c['id'] %>" <%= 'selected' if c['id']==city['id'] %>><%= c['name'] %></option><% end %></select><span id="city-zone">Europe/Ljubljana</span></div></div>
<details class="weather-details" id="city-weather"><summary><span class="weather-icon" id="weather-icon"><%= ui_icon('sun') %></span><span class="weather-summary"><b id="weather-label">Vreme · <%= city['name'] %></b><small id="weather-description">Pridobivamo napoved …</small></span><strong id="weather-temperature">—</strong><%= ui_icon('chevron-right') %></summary><div id="weather-more"><p class="muted">Napoved se pridobiva iz vira MET Norway.</p></div></details>
<div class="weather-source"><span class="status-dot" aria-hidden="true"></span><small id="weather-updated" role="status">Povezujemo se z vremenskim virom …</small></div>
<a class="line-link" href="/godovi/"><span><%= ui_icon('person') %> Godovi danes</span><%= ui_icon('chevron-right') %></a>
<a class="card-credit" href="/fotografije-in-licence/">Fotografije, vremenski vir in licence</a></section>
