<% kind={'datumski-kalkulator'=>'date','kalkulator-delovnih-dni'=>'workdays','nacrtovalnik-dopusta'=>'vacation','odstevanje'=>'countdown','stevilka-tedna'=>'week','dan-v-letu'=>'ordinal','prestopno-leto'=>'leap'}[page_path.split('/').last] %><section class="panel tool-panel"><form class="api-form" action="/izracun/" method="post"><%= hidden_field_tag :authenticity_token,form_authenticity_token %><input type="hidden" name="tool" value="<%= kind %>">
<% if %w[date workdays].include?(kind) %><div class="form-row"><label>Začetni datum<input type="date" name="from" value="2027-01-01" required></label><label>Končni datum<input type="date" name="to" value="2027-12-31" required></label></div>
<% if kind=='workdays' %><fieldset><legend>Delovni dnevi v tednu</legend><% CalendarEngine::DAYS.each_with_index do |d,i| %><label class="check"><input type="checkbox" name="weekdays[]" value="<%= i+1 %>" <%= 'checked' if i<5 %>><%= d %></label><% end %></fieldset><label>Dnevne ure<input type="number" min="0" max="24" step="0.25" name="hours" value="8" required></label><label class="check"><input type="checkbox" name="exclude_holidays" value="1" checked>Izloči zakonske dela proste dneve</label><label class="check"><input type="checkbox" name="include_start" value="1" checked>Vključi začetni datum</label><label class="check"><input type="checkbox" name="include_end" value="1" checked>Vključi končni datum</label>
<% else %><label class="check"><input type="checkbox" name="inclusive" value="1">Vključi tudi končni dan v razliko</label><div class="form-row"><label>Dodaj ali odštej<input name="delta" type="number" value="0" min="-100000" max="100000"></label><label>Enota<select name="unit"><option value="days">Dnevi</option><option value="weeks">Tedni</option><option value="months">Meseci</option></select></label></div><% end %>
<% elsif kind=='vacation' %><label>Leto<select name="year"><% (2027..2030).each do |y| %><option><%= y %></option><% end %></select></label><label>Največ dni dopusta<input type="number" name="budget" value="3" min="0" max="20" required></label><p>Izračun uporablja delovni teden ponedeljek–petek.</p>
<% else %><label>Datum<input type="date" name="date" value="<%= @selected %>" required></label><% if kind=='countdown' %><p>Odštevanje uporablja datum v časovnem pasu Europe/Ljubljana. Osebnega naziva cilja ne vključuje v javni naslov.</p><% end %><% end %><button class="primary">Izračunaj</button><output class="result" aria-live="polite"></output></form><p><a href="/viri-in-metodologija/">Kako računamo</a></p></section>
