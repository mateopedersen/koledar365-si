<section id="storage-notice" class="storage-notice" aria-labelledby="storage-title" aria-describedby="storage-description" hidden>
  <div class="storage-notice__inner">
    <img class="storage-notice__art" src="/visuals/cookie-privacy.svg" width="88" height="88" alt="">
    <div class="storage-notice__heading">
      <p>Vaša zasebnost</p>
      <h2 id="storage-title">Kako uporabljamo shrambo brskalnika</h2>
    </div>
    <p id="storage-description" class="storage-notice__description">Vaši koledarski vnosi in nastavitve ostanejo v tem brskalniku. Oglasnih in analitičnih piškotkov ne uporabljamo.</p>
    <div class="storage-notice__actions">
      <a href="/piskotki/">Politika piškotkov</a>
      <button type="button" data-storage-dismiss>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 5 5 9-10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Zapri obvestilo
      </button>
    </div>
    <button type="button" class="storage-notice__close" data-storage-close aria-label="Zapri obvestilo na tej strani">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
</section>

<dialog class="cookie-preferences-dialog" aria-labelledby="cookie-settings-title">
  <form>
    <h2 id="cookie-settings-title">Pomnjenje izbranega mesta</h2>
    <p>Izbrano mesto za fotografijo in vremensko napoved lahko ta brskalnik hrani do 180 dni.</p>
    <label><input id="cookie-preferences" type="checkbox" autofocus> Zapomni si izbrano mesto</label>
    <p class="cookie-preferences-status" role="status" hidden></p>
    <div class="cookie-preferences-actions">
      <button type="button" data-cookie-cancel>Prekliči</button>
      <button type="submit">Shrani izbiro</button>
    </div>
    <a href="/piskotki/">Politika piškotkov</a>
  </form>
</dialog>
<script id="cookie-preferences-runtime" type="module" async src="/cookie-preferences.mjs"></script>
