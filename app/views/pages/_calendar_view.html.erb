<% case @view;when 'year' %><div class="year-grid"><% 1.upto(12) do |m| %><%= calendar_month(@year,m,mini:true) %><% end %></div>
<% when 'week','day' %><div class="week-view"><% dates=@view=='day' ? [@selected] : ((@selected-@selected.cwday+1)..(@selected-@selected.cwday+7));dates.each do |d|;next unless d.between?(Date.new(2026,1,1),Date.new(2030,12,31)) %><section><h3><a href="?year=<%= d.year %>&month=<%= d.month %>&date=<%= d %>&view=day"><%= CalendarEngine::DAYS[d.cwday-1] %> <%= d.day %>.</a></h3><% @event_map.fetch(d,[]).each do |e| %><a href="<%= event_path(e) %>"><%= e.title %></a><% end %><p class="muted">Načrte dodajte v razdelku Moj dan.</p></section><% end %></div>
<% when 'list' %><%= render 'event_table',events:@events.select { |e| e.on.month==@month } %>
<% else %><%= calendar_month(@year,@month) %><% end %>
