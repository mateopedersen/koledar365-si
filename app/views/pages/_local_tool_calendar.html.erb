<% years=CalendarEngine::YEARS; initial_year=@today.year.clamp(years.first,years.last) %>
<% rows=LocalToolDeadlines.tax %>
<% labels={'dohodnina'=>'Dohodnina','najem'=>'Najem','kapital'=>'Kapital','dejavnost'=>'Dejavnost'} %>
<section class="tool-block" data-tool-list>
  <h2>Izbrani datumi za oddajo</h2>
  <p>Datumi so izračunani iz rednih rokov po trenutno veljavnih predpisih. Premik na naslednji delovnik je posebej označen. Posebne obveznosti, roke za plačilo in spremembe preverite v eDavkih.</p>
  <div class="tool-filter-row">
    <label>Leto<select data-row-year><% years.each do |year| %><option <%= 'selected' if year==initial_year %>><%= year %></option><% end %></select></label>
    <label>Vrsta napovedi<select data-row-category><option value="">Vse</option><% labels.each do |key,label| %><option value="<%= key %>"><%= label %></option><% end %></select></label>
    <button type="button" class="tool-secondary" data-row-export>Prenesi prikazane datume (.ics)</button>
  </div>
  <div class="tool-line-list">
    <% rows.each do |row| %><% date=Date.iso8601(row.fetch(:date)); key=row[:category] || row[:type]; finish=row[:end]; shifted=row[:nominal] && row[:nominal]!=row[:date] %>
      <div class="tool-card-line" data-tool-row data-year="<%= date.year %>" data-category="<%= key %>" data-title="<%= row.fetch(:title) %>" data-date="<%= date %>" data-end="<%= finish %>" data-source="<%= row.fetch(:source) %>" <%= 'hidden' if date.year!=initial_year %>>
        <time class="tool-date-chip" datetime="<%= date %>"><%= date.strftime('%-d. %-m.') %><% if finish %>– <%= Date.iso8601(finish).strftime('%-d. %-m.') %><% end %></time>
        <div><span class="tool-kind-label"><%= labels.fetch(key) %></span><strong><%= row.fetch(:title) %></strong><% if row[:detail] %><p><%= row.fetch(:detail) %></p><% end %><% if shifted %><p>Redni datum <%= Date.iso8601(row[:nominal]).strftime('%-d. %-m.') %> · premik na delovnik</p><% end %></div>
        <%= source_link(row.fetch(:source),'Uradni vir') %>
      </div>
    <% end %>
  </div>
  <p data-row-empty hidden>Za izbrani filter še ni objavljenega datuma.</p>
  <div class="tool-source-links"><%= source_link(LocalToolDeadlines::TAX_LAW,'ZDavP-2 – tek rokov') %><%= source_link(LocalToolDeadlines::E_DAVKI,'Osebni koledar v eDavkih') %></div>
</section>
<%= render 'local_tool_reminders', kind: kind, heading: 'Moji davčni opomniki', hint: 'Zabeležite lastni rok, ki ste ga prejeli v eDavkih ali na odločbi.', today: today %>
<div class="tool-source-links"><%= link_to 'Odštevanje do datuma','/odstevanje/' %><%= link_to 'Vsa orodja','/orodja/' %></div>
