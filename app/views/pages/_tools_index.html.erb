<article class="tool-workspace tool-directory" data-tools-directory>
  <header class="tool-intro tool-directory-intro">
    <div>
      <p class="tool-eyebrow"><%= slovenia_flag %> Koledar365</p>
      <h1>Koledarji, planerji in kalkulatorji</h1>
      <p>Poiščite slovenske praznike, načrtujte rok ali izračunajte datum. Vsa orodja lahko uporabljate brez računa.</p>
      <label class="tool-query"><%= ui_icon('search') %><span class="sr-only">Išči med orodji</span><input type="search" data-tool-query placeholder="Poiščite orodje, npr. upokojitev ali vpis" autocomplete="off"></label>
    </div>
    <div class="tool-directory-art" aria-hidden="true"><%= ui_icon('calendar') %><%= ui_icon('calculator') %><%= ui_icon('moon') %></div>
  </header>
  <div class="tool-picks">
    <% [['/odstevanje/', 'Naslednji pomemben dan', 'Izberite praznik ali festival', 'clock'], ['/kalkulator-upokojitve/', 'Kdaj v pokoj?', 'Primerjajte dve poti do starostne pokojnine', 'briefcase'], ['/vpisni-koledar/', 'Roki za vpis', 'Srednje in višje strokovne šole', 'school']].each do |path, label, description, icon| %>
      <a href="<%= path %>"><%= ui_icon(icon) %><span><strong><%= label %></strong><small><%= description %></small></span></a>
    <% end %>
  </div>
  <div class="tool-index-layout">
    <nav class="tool-category" aria-label="Vrste orodij">
      <a href="#vsa-orodja" aria-current="true" data-tool-category="all"><%= ui_icon('grid') %><span>Vsa orodja</span></a>
      <% ToolsDirectory::GROUPS.each do |key, (label, icon, _)| %><a href="#<%= key %>" data-tool-category="<%= key %>"><%= ui_icon(icon) %><span><%= label %></span></a><% end %>
    </nav>
    <div id="vsa-orodja">
      <p class="tool-index-count" data-tool-count role="status"><%= ToolsDirectory::GROUPS.values.sum { |_, _, rows| rows.size } %> orodij</p>
      <% ToolsDirectory::GROUPS.each do |key, (label, _, rows)| %>
        <section class="tool-index-group" id="<%= key %>" data-tool-group="<%= key %>">
          <h2><%= label %></h2>
          <div class="tool-index-cards">
            <% rows.each do |path, title, icon, description| %>
              <a href="<%= path %>" data-tool-card><span class="tool-card-symbol"><%= icon=='flag' ? slovenia_flag : ui_icon(icon) %></span><span><strong><%= title %></strong><small><%= description %></small></span></a>
            <% end %>
          </div>
        </section>
      <% end %>
      <p class="tool-card-line" data-tool-empty hidden>Ni zadetkov. Poskusite s krajšim izrazom ali izberite drugo vrsto orodja.</p>
    </div>
  </div>
</article>

<details class="tool-block tool-site-index">
  <summary>Kazalo vseh vsebin</summary>
  <% directory=Page.published.order(:path).reject { |page| page.path.match?(PagesController::REMOVED_NAME_PATHS) || PublicPagePolicy.redirect(page.path) } %>
  <% directory.group_by { |page| page.path.split('/')[1].to_s }.each do |group,pages| %>
    <% heading=pages.find { |page| page.path=="/#{group}/" }&.title || pages.first.title %>
    <details class="site-directory-group">
      <summary><strong><%= heading %></strong> <span class="muted">· <%= pages.size %></span></summary>
      <nav class="link-grid compact" aria-label="<%= heading %>"><% pages.each do |page| %><a href="<%= page.path %>"><%= page.title %></a><% end %></nav>
    </details>
  <% end %>
</details>
