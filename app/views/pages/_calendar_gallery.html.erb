<% period = month ? "koledar za #{CalendarEngine::MONTHS.fetch(month - 1)} #{year}" : "letni koledar #{year}" %>
<section class="calendar-gallery calendar-gallery--period" id="calendar-designs" aria-labelledby="calendar-gallery-title" data-calendar-gallery data-gallery-type="<%= month ? 'monthly' : 'annual' %>" data-gallery-year="<%= year %>" data-gallery-month="<%= month %>">
  <h2 class="sr-only" id="calendar-gallery-title"><%= rows.size %> predlog za tisk in prenos</h2>
  <div class="calendar-gallery-grid">
    <% rows.each_with_index do |row, index| %>
      <% design_id = row.dig('options', 'design')
         description = row.fetch('collection_seo')
         design_name = description.fetch('design_name')
         files = row.fetch('files')
         orientation = row.dig('options', 'orientation') == 'landscape' ? 'Ležeče' : 'Pokončno' %>
      <article class="calendar-design-card" id="predloga-<%= design_id %>" data-calendar-design="<%= design_id %>">
        <a class="calendar-design-image" href="<%= files.fetch('pdf') %>" target="_blank" rel="noopener" aria-label="Odpri predogled PDF (<%= period %>, <%= design_name %>)">
          <img src="<%= files.fetch('preview') %>" alt="<%= description.fetch('alt') %>" title="<%= period.capitalize %> (<%= design_name %>)" width="<%= row.fetch('preview_width') %>" height="<%= row.fetch('preview_height') %>" loading="<%= index < 5 ? 'eager' : 'lazy' %>" <% if index.zero? %>fetchpriority="high"<% end %> decoding="async">
        </a>
        <div class="calendar-design-info">
          <h3><span class="design-title"><%= design_name %></span></h3>
          <p class="calendar-design-meta"><%= row.dig('options', 'paper') %> · <%= orientation %></p>
          <div class="calendar-design-downloads">
            <% [['pdf', 'PDF'], ['webp', 'Slika']].each do |format, label| %>
              <% file = files.fetch(format) %>
              <a class="button calendar-download-action calendar-download-action--<%= format %>" href="<%= file %>" download="<%= File.basename(file) %>" data-calendar-download="<%= format %>" aria-label="Prenesi <%= label == "PDF" ? "PDF" : "sliko" %> (<%= period %>, <%= design_name %>)"><%= calendar_file_icon(format) %><span class="calendar-download-action__copy"><strong><%= label %></strong> <small>Prenesi</small></span></a>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
