<% if @page.year %><section class="panel"><% if page_path.start_with?('/tedenski-koledar/') %><% @view='week' %><% end %><%= render 'calendar_controls' %><%= render 'calendar_view' %><div class="actions"><button data-print>Natisni</button><a class="button" href="/koledar-za-tiskanje/?year=<%= @year %>&month=<%= @month %>&type=<%= @view=='week' ? 'weekly' : (@page.month ? 'monthly' : 'annual') %>&date=<%= @selected.iso8601 %>">Prenesi PDF in WebP</a><a href="/koledar/<%= @year %>/">Letni pregled</a></div></section><% else %><%= render 'year_cards' %><div class="link-grid"><% @children.limit(65).each do |p| %><a href="<%= p.path %>"><%= p.title %></a><% end %></div><% end %>
<% if @page.month %><nav class="actions"><% d=Date.new(@year,@month,1);[d.prev_month,d.next_month].each do |n| %><% if CalendarEngine::YEARS.include?(n.year) %><a href="<%= month_url(n.year,n.month) %>"><%= CalendarEngine::MONTHS[n.month-1] %> <%= n.year %></a><% end %><% end %></nav><% end %>
