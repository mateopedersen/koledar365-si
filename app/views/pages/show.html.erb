<% elsif page_path=='/razpored-izmen/' %>
<section class="shift-hero" aria-labelledby="shift-hero-title">
  <div class="shift-hero__copy page-heading">
    <span class="eyebrow">KOLEDAR365 · ORODJE ZA DELO</span>
    <h1 id="shift-hero-title">Razpored izmen, pripravljen za vaš ritem</h1>
    <p>Vnesite zaporedje izmen in obdobje. Takoj preverite mesečni pregled, nato razpored shranite, izvozite ali natisnite kot PDF ali sliko pri 600 ppi.</p>
    <%= render 'hero_features', label: 'Možnosti razporeda izmen', items: [['week', 'Ponavljajoče se izmene'], ['shield', 'Brez računa'], ['download', 'PDF, slika in ICS']] %>
  </div>
  <div class="shift-hero__art" aria-hidden="true">
    <%= page_hero_art('shifts') %>
  </div>
</section>
<% elsif @section=='workdays' && !@page.month %>
<section class="workdays-hero" aria-labelledby="workdays-title">
  <div class="workdays-hero__copy">
    <span class="workdays-kicker"><i aria-hidden="true"></i> KOLEDAR365 <span>·</span> SLOVENIJA</span>
    <h1 id="workdays-title"><%= @title %></h1>
    <p><%= @description %></p>
    <div class="workdays-hero__actions"><a class="button primary" href="#workdays-overview">Razišči letni pregled <span aria-hidden="true"><%= ui_icon('arrow-down') %></span></a><a class="button" href="/kalkulator-delovnih-dni/">Izračunaj obdobje <span aria-hidden="true"><%= ui_icon('chevron-right') %></span></a></div>
    <%= render 'hero_features', label: 'Podatki o delovnem koledarju', items: [['holidays', 'Dela prosti dnevi'], ['settings', 'Prilagodljiv delovnik'], ['clock', 'Mesečni pregled ur']] %>
  </div>
  <div class="workdays-hero__visual" aria-hidden="true">
    <%= render 'workdays_hero_art' %>
  </div>
</section>
<% elsif page_path=='/lunin-koledar/' %>
<section class="lunar-hub-masthead" aria-labelledby="lunar-hub-title">
  <div class="lunar-hub-masthead__copy">
    <span class="lunar-hub-kicker">KOLEDAR365 <i aria-hidden="true"></i> LUNA 2027–2030</span>
    <h1 id="lunar-hub-title"><%= @title %></h1>
    <p><%= @description %></p>
    <%= render 'hero_features', label: 'Vsebina luninega koledarja', dark: true, items: [['calendar', '2027–2030', 'Letni pregledi'], ['moon', '48 mesecev', 'Lunine mene'], ['clock', 'Krajevni čas', 'Slovenija']] %>
  </div>
  <div class="lunar-hub-masthead__art" aria-hidden="true">
    <%= render 'responsive_photo', path: '/lunar/photos/artemis-earthset.jpg', alt: '', sizes: '(max-width:650px) min(330px, calc(100vw - 70px)), (max-width:900px) 28vw, 440px' %>
    <span>Fotografija NASA · Artemis II</span>
  </div>
</section>
<% elsif page_path=='/soncni-vzhod-in-zahod/' %>
<%# The sun experience renders its own single, illustrated main heading. %>
<% elsif page_path=='/solski-urnik/' %>
<%= render 'student_timetable_hero' %>
<% else %><div class="page-heading"><span class="eyebrow">KOLEDAR365 · SLOVENIJA</span><h1><%= @title %></h1><% unless @section=='events' && TopicContent.find(page_path.split('/').last) %><p><%= gallery_page? ? gallery_description : @description %></p><% end %></div><% end %>
<%= render @section %>
<%= render 'print_calendar_guide' if page_path=='/koledar-za-tiskanje/' %>
<% end %>

<% if @page&.body.present? && page_path!='/koledar/' && !%w[observance school horoscope calendar_studio methodology garden_calendar payment_calendar education_calendar school_timetable moon_phases astronomy_events].include?(@section) %><section class="panel prose"><%= simple_format(@page.body) %></section><% end %>

<%= render 'editorial_note' unless %w[blog seasons].include?(@section) || @calendar_collection || ['/delovni-dnevi/', SlovenianSkyCalendar::PATH].include?(page_path) %>
