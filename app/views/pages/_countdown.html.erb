<% initial = @countdown_events.find { |event| event[:category] == 'holiday' && event[:work_free] && event[:date] > @today.iso8601 } %>
<section class="countdown-page" data-countdown-root aria-labelledby="countdown-title">
  <script type="application/json" data-countdown-events nonce="<%= content_security_policy_nonce %>"><%= raw json_escape(@countdown_events.to_json) %></script>

  <header class="countdown-hero">
    <div>
      <p class="countdown-country"><%= slovenia_flag %> Slovenski koledar</p>
      <h1 id="countdown-title">Odštevanje do datuma</h1>
      <p>Izberite praznik, festival ali svoj datum in spremljajte, koliko časa je še do njega.</p>
    </div>
    <a class="countdown-link" href="#moj-seznam">Moji odštevalniki <span aria-hidden="true">↓</span></a>
  </header>

  <div class="countdown-workspace">
    <section class="countdown-picker" id="izberi-dogodek" aria-labelledby="countdown-picker-title">
      <h2 id="countdown-picker-title">Do česa odštevamo?</h2>
      <div class="countdown-categories" role="group" aria-label="Vrsta dogodka">
        <% [['holiday', 'gift', 'Prazniki'], ['festival', 'star', 'Festivali'], ['observance', 'flag', 'Posebni dnevi'], ['school', 'school', 'Šolski termini'], ['custom', 'plus', 'Moj datum']].each do |key, icon, label| %>
          <button type="button" data-event-filter="<%= key %>" aria-pressed="<%= key == 'holiday' %>" aria-controls="<%= key == 'custom' ? 'moj-datum' : 'countdown-calendar-picker' %>">
            <%= icon == 'flag' ? slovenia_flag : ui_icon(icon) %><span><%= label %></span>
          </button>
        <% end %>
      </div>

      <div class="countdown-controls" id="countdown-calendar-picker" data-event-picker>
        <div class="countdown-fields countdown-fields--filter">
          <label>Iskanje
            <input type="search" data-event-search placeholder="npr. Božič" autocomplete="off" maxlength="80">
          </label>
          <label><span id="countdown-label-year">Leto</span>
            <select aria-labelledby="countdown-label-year" data-event-year><option value="all">Vsa leta</option></select>
          </label>
        </div>
        <div class="countdown-fields countdown-school-controls" data-region-control hidden>
          <label><span id="countdown-label-level">Stopnja</span>
            <select aria-labelledby="countdown-label-level" data-school-level><option value="primary">Osnovna šola</option><option value="secondary">Srednja šola</option></select>
          </label>
          <label><span id="countdown-label-region">Regija</span>
            <select aria-labelledby="countdown-label-region" data-school-region><option value="west">Zahodna skupina</option><option value="east">Vzhodna skupina</option></select>
          </label>
        </div>
        <label><span id="countdown-label-event">Dogodek in datum</span>
          <select aria-labelledby="countdown-label-event" data-event-select aria-describedby="countdown-event-note">
            <option value="<%= initial&.fetch(:id) %>"><%= initial ? "#{initial.fetch(:title)} · #{sl_date(Date.iso8601(initial.fetch(:date)))}" : 'Izberite dogodek' %></option>
          </select>
        </label>
        <p class="countdown-hint" id="countdown-event-note" data-event-note aria-live="polite"></p>
        <div class="countdown-fields" data-event-settings hidden>
          <label data-event-boundary-wrap hidden><span id="countdown-label-boundary">Odštevaj do</span>
            <select aria-labelledby="countdown-label-boundary" data-event-boundary>
              <option value="start">Začetka dogodka</option>
              <option value="end">Konca zadnjega dne</option>
            </select>
          </label>
          <label data-event-time-wrap>Ura odštevanja
            <input type="time" data-event-time value="00:00" aria-describedby="countdown-time-note">
          </label>
        </div>
        <p class="countdown-hint" id="countdown-time-note" data-time-note aria-live="polite"></p>
      </div>

      <form class="countdown-controls" id="moj-datum" data-custom-form hidden>
        <label>Ime dogodka
          <input type="text" name="title" maxlength="64" placeholder="npr. Začetek dopusta" required>
        </label>
        <div class="countdown-fields">
          <label>Datum<input type="date" name="date" value="<%= (@today + 1).iso8601 %>" min="1900-01-01" max="9999-12-31" required></label>
          <label>Ura<input type="time" name="time" value="00:00" required></label>
        </div>
        <label>Časovni pas
          <select name="zone">
            <option value="Europe/Ljubljana">Slovenija · Ljubljana</option>
            <option value="Europe/Vienna">Avstrija · Dunaj</option>
            <option value="Europe/London">Združeno kraljestvo · London</option>
            <option value="America/New_York">ZDA · New York</option>
            <option value="UTC">UTC</option>
          </select>
        </label>
        <button class="countdown-primary" type="submit">Začni odštevati</button>
        <p class="countdown-hint" data-custom-status role="status"></p>
      </form>
      <noscript><p class="countdown-hint">Za izbiro dogodka in tekoče odštevanje omogočite JavaScript.</p></noscript>
    </section>

    <section class="countdown-display" id="countdown-display" data-feature-card aria-labelledby="countdown-event-title">
      <div class="countdown-display__top">
        <span class="countdown-live" data-feature-state>Odštevanje</span>
        <span class="countdown-zone"><%= ui_icon('clock') %><span data-feature-zone>Slovenija · Ljubljana</span></span>
      </div>
      <div class="countdown-display__event">
        <p class="countdown-display__category" data-feature-category>Naslednji dela prosti praznik</p>
        <h2 id="countdown-event-title" data-feature-title tabindex="-1"><%= initial&.fetch(:title) || 'Izberite datum' %></h2>
        <p data-feature-date><%= sl_date(Date.iso8601(initial.fetch(:date))) if initial %></p>
        <p class="countdown-venue" data-feature-venue hidden></p>
      </div>
      <div class="countdown-digits" role="timer" aria-live="off" aria-label="Preostali čas">
        <% [['days', 'Dni'], ['hours', 'Ur'], ['minutes', 'Minut'], ['seconds', 'Sekund']].each do |unit, label| %>
          <div><strong data-feature-<%= unit %>>—</strong><span><%= label %></span></div>
        <% end %>
      </div>
      <p class="countdown-display__status" data-feature-status aria-live="polite"></p>
      <div class="countdown-display__actions">
        <button type="button" data-feature-save disabled><%= ui_icon('plus') %><span data-save-label>Shrani</span></button>
        <button type="button" data-feature-share disabled><%= ui_icon('share') %><span>Deli odštevanje</span></button>
      </div>
      <div class="countdown-share-field" data-share-field hidden>
        <label>Povezava do izbranega odštevanja<input type="url" data-share-url readonly></label>
      </div>
      <p class="countdown-display__notice" data-feature-notice role="status"></p>
      <a class="countdown-edit" href="#izberi-dogodek">Spremeni datum</a>
      <a class="countdown-display__source" data-feature-source hidden>Podrobnosti dogodka <span aria-hidden="true">↗</span></a>
    </section>
  </div>

  <section class="countdown-next" aria-labelledby="countdown-next-title" data-next-section hidden>
    <h2 id="countdown-next-title">Prihajajoči datumi</h2>
    <ul class="countdown-next__list" role="list">
      <% [['holiday', 'Dela prosti praznik'], ['festival', 'Festival'], ['school', 'Šolski termin']].each do |key, label| %>
        <li data-next-item hidden>
          <button type="button" data-next-event="<%= key %>" aria-controls="countdown-display">
            <time class="countdown-next__date" data-next-date>
              <span data-next-day></span><span data-next-month></span><span data-next-year></span>
            </time>
            <span class="countdown-next__copy">
              <span class="countdown-next__kind"><%= label %></span>
              <strong data-next-name></strong>
              <span class="countdown-next__context" data-next-context hidden></span>
            </span>
            <span class="countdown-next__action">Odštevaj</span>
          </button>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="countdown-saved" id="moj-seznam" aria-labelledby="countdown-saved-title">
    <div class="countdown-saved__heading">
      <div><h2 id="countdown-saved-title" tabindex="-1">Moji odštevalniki</h2><p>Izbrani datumi se shranijo v tem brskalniku.</p></div>
      <button class="countdown-link" type="button" data-export-ics hidden disabled><%= ui_icon('download') %> Izvozi v koledar (.ics)</button>
    </div>
    <p class="countdown-empty" data-saved-empty>Shranite izbrani datum in odštevanje se bo prikazalo tukaj.</p>
    <div class="countdown-saved__grid" data-saved-list></div>
    <p class="countdown-hint" data-saved-status role="status"></p>
  </section>

  <details class="countdown-method">
    <summary>Kako deluje odštevanje in od kod so datumi?</summary>
    <p>Odštevalnik primerja izbrano uro z uro vaše naprave. Pri vnaprej vnesenem dogodku brez objavljene ure odšteva do polnoči na prvi dan dogodka po slovenskem času. Pri večdnevnem dogodku lahko izberete tudi polnoč po zadnjem dnevu.</p>
    <p>Ob spomladanskem premiku ure izberite veljavno uro. Za jesensko uro, ki se ponovi, odštevalnik uporabi prvo pojavitev.</p>
    <p>Festivali so prikazani z objavljenimi datumi. Predvideni šolski termini so posebej označeni. Povezava za deljenje vsebuje le izbrano odštevanje.</p>
    <ul>
      <li><a href="https://www.gov.si/teme/drzavni-prazniki-in-dela-prosti-dnevi/">Državni prazniki in dela prosti dnevi · GOV.SI</a></li>
      <li><a href="<%= CountdownCatalog::SCHOOL_SOURCE %>">Šolski koledar za osnovne šole · GOV.SI</a></li>
      <li><a href="<%= CountdownCatalog::SECONDARY_SCHOOL_SOURCE %>">Šolski koledar za srednje šole · GOV.SI</a></li>
      <li><a href="/festivali/">Festivali v Sloveniji</a></li>
      <li><a href="/viri-in-metodologija/">Viri in metodologija</a></li>
    </ul>
  </details>
</section>
