<% guide=PaymentCalendar.new(path:page_path,today:@today); page=PaymentCalendar.page(page_path); upcoming=guide.next_event; month_names=CalendarEngine::MONTHS; display_date=upcoming ? Date.iso8601(upcoming['date']) : Date.new(2026,12,1) %>
<article class="payment-page" data-payment-calendar>
  <script type="application/json" data-payment-data><%= raw json_escape(guide.payload.to_json) %></script>
  <header class="payment-hero">
    <div class="payment-hero-copy"><p class="payment-kicker"><%= slovenia_flag %> OBJAVLJENI TERMINI · SLOVENIJA</p><h1><%= page[:heading] %></h1><p class="payment-lead"><%= guide.pension? ? 'Naslednje nakazilo in vse leto na enem mestu. Datumi sledijo objavljenemu koledarju Zavoda za pokojninsko in invalidsko zavarovanje Slovenije.' : 'Otroški dodatek, socialna pomoč, štipendije in drugi prejemki. Poiščite svoj prejemek in preverite objavljeni datum nakazila.' %></p><div class="payment-actions"><a class="button primary" href="#koledar-izplacil">Preverite datume <span aria-hidden="true">↓</span></a><a class="button" href="<%= guide.calendar_path %>" download data-payment-download>Dodaj v koledar ICS</a></div><p class="payment-verification"><span aria-hidden="true">●</span> Vir: <%= guide.pension? ? 'ZPIZ' : 'CSD' %> <span>·</span> Preverjeno <time datetime="2026-10-21">21. 10. 2026</time> <span>·</span> <a href="#viri-izplacil">Poglejte izvirnik</a></p></div>
    <aside class="payment-next" aria-labelledby="payment-next-title"><div class="payment-next-top"><span>NASLEDNJI OBJAVLJENI TERMIN</span><span class="payment-year">2026</span></div><h2 id="payment-next-title" data-payment-next-label><%= upcoming ? guide.label(upcoming) : 'Preverite nov uradni koledar' %></h2><time datetime="<%= upcoming&.fetch('date') %>" class="payment-next-date" data-payment-next-date><%= upcoming ? l(Date.iso8601(upcoming['date']),format:'%-d. %B %Y') : 'Objavljeni termini so se iztekli' %></time><p class="payment-next-weekday" data-payment-next-weekday><%= upcoming ? CalendarEngine::DAYS.fetch(Date.iso8601(upcoming['date']).cwday-1) : '' %></p><p class="payment-next-countdown" data-payment-next-countdown><%= upcoming ? "Do termina: #{(Date.iso8601(upcoming['date'])-@today).to_i} dni" : 'Prihodnjih datumov ne izračunavamo iz preteklega vzorca.' %></p><div class="payment-next-month" aria-hidden="true"><% (1..Date.new(display_date.year,display_date.month,-1).day).each do |day| %><span<% if day==1 %> style="grid-column-start:<%= Date.new(display_date.year,display_date.month,1).cwday %>"<% end %> class="<%= 'is-payment-day' if upcoming && day==display_date.day %>"><%= day %></span><% end %></div><p class="payment-next-caption"><%= guide.pension? ? 'Redna mesečna pokojnina. Dodatki niso vključeni.' : 'Skupni pregled vseh prejemkov. Spodaj izberite svojega.' %></p></aside>
  </header>
  <nav class="payment-nav" aria-label="Vsebina koledarja izplačil"><a href="#koledar-izplacil">Koledar izplačil</a><a href="#pregled-izplacil">Vizualni pregled</a><a href="#vprasanja-izplacila">Vprašanja</a><a href="#viri-izplacil">Uradni vir</a><a href="<%= guide.pension? ? '/izplacila-socialnih-transferjev/' : '/izplacila-pokojnin/' %>"><%= guide.pension? ? 'Socialni transferji' : 'Pokojnine' %> <span aria-hidden="true">↗</span></a></nav>
  <section id="koledar-izplacil" class="payment-schedule" aria-labelledby="payment-schedule-title"><div class="payment-section-heading"><div><p class="payment-kicker">VAŠ PREGLED</p><h2 id="payment-schedule-title"><%= guide.pension? ? 'Dvanajst mesecev. Objavljeni datumi.' : 'Kateri prejemek vas zanima?' %></h2><p><%= guide.pension? ? 'V preglednici so datumi rednih mesečnih izplačil iz uradnega koledarja za leto 2026.' : 'Filtrirate po dejanskem mesecu nakazila. Mesec izvornega plana je prikazan posebej.' %></p></div><button type="button" data-payment-print><%= ui_icon('print') %> Natisni / shrani PDF</button></div>
    <div class="payment-filters"><% unless guide.pension? %><label for="payment-benefit">Prejemek<select id="payment-benefit" data-payment-benefit><option value="all">Vsi prejemki</option><% guide.categories.each do |id,category| %><option value="<%= id %>"><%= category['label'] %></option><% end %></select></label><% end %><label for="payment-month">Mesec nakazila<select id="payment-month" data-payment-month><option value="all">Vsi objavljeni meseci</option><% guide.events.map{|event|event['date'][0,7]}.uniq.each do |month| %><option value="<%= month %>"><%= month_names.fetch(month[5,2].to_i-1).capitalize %> <%= month[0,4] %><%= ' · zaključek plana 2026' if month.start_with?('2027') %></option><% end %></select></label><label class="payment-upcoming-toggle"><input type="checkbox" data-payment-upcoming checked><span>Samo prihodnji termini</span></label><button type="button" data-payment-reset>Vsi datumi</button></div>
    <% unless guide.pension? %><p class="payment-column-note"><strong>To so datumi izplačila.</strong> Interni rok za zaključek vnosa na CSD ni prikazan kot datum nakazila.</p><% end %>
    <p class="payment-result-count" data-payment-count role="status" aria-live="polite">Objavljeni načrt: <%= guide.events.size %> terminov.</p>
    <div class="payment-table-wrap" tabindex="0" role="region" aria-label="Datumi izplačil"><table class="payment-table"><caption class="sr-only"><%= page[:heading] %> po uradnem terminskem planu</caption><thead><tr><th scope="col">Prejemek</th><th scope="col">Mesec plana</th><th scope="col">Datum izplačila</th><th scope="col">Dan</th><th scope="col">Koledar</th></tr></thead><tbody>
      <% guide.events.each do |event|;date=Date.iso8601(event['date']);plan_date=Date.iso8601(event['plan_month']+'-01') %><tr data-payment-row="<%= event['id'] %>" data-date="<%= event['date'] %>" data-category="<%= event['category'] %>" <%= 'hidden' if date<@today %>><th scope="row" data-label="Prejemek"><%= guide.label(event) %></th><td data-label="Mesec plana"><%= month_names.fetch(plan_date.month-1).capitalize %> <%= plan_date.year %></td><td data-label="Datum izplačila"><time datetime="<%= event['date'] %>"><%= date.strftime('%-d. %-m. %Y') %></time></td><td data-label="Dan"><%= CalendarEngine::DAYS.fetch(date.cwday-1) %></td><td data-label="Koledar"><button type="button" data-payment-event="<%= event['id'] %>" aria-label="Dodaj v koledar: <%= guide.label(event) %>, <%= date.strftime('%-d. %-m. %Y') %>">＋ ICS</button></td></tr><% end %>
    </tbody></table></div>
    <p class="payment-empty" data-payment-empty hidden>Za izbrani filter ni objavljenega termina. Poglejte vse datume ali preverite nov načrt pri uradnem viru.</p>
    <div class="payment-table-footer"><p>ICS je kopija razporeda. Poznejših sprememb ne prejme samodejno.</p><button type="button" data-payment-filtered-ics>Prenesi prikazane termine</button><button type="button" data-payment-share>Kopiraj povezavo do izbora</button></div><p class="payment-status" data-payment-status role="status" aria-live="polite"></p>
    <noscript><p>Za spreminjanje filtrov vključite JavaScript. Vsi potrjeni termini so na voljo v <a href="<%= guide.calendar_path %>" download>datoteki ICS</a> in pri <a href="<%= guide.source['url'] %>">uradnem viru</a>.</p></noscript>
  </section>
  <section id="pregled-izplacil" class="payment-visual" aria-labelledby="payment-visual-title"><div class="payment-section-heading"><div><p class="payment-kicker">PREGLED ZA SHRANJEVANJE</p><h2 id="payment-visual-title"><%= guide.pension? ? 'Koledar pokojnin za leto 2026' : 'Izbrani prejemki ob koncu leta 2026' %></h2><p><%= guide.pension? ? 'Izvirna preglednica Koledar365 z vsemi dvanajstimi objavljenimi datumi.' : 'Otroški in varstveni dodatek, I. obdelava socialne pomoči ter štipendije za oktober, november in december.' %></p></div><a class="button" href="/images/payments/<%= guide.pension? ? 'pokojnine-2026' : 'socialni-transferji-2026' %>.webp" download>Prenesi sliko</a></div><figure><a href="/images/payments/<%= guide.pension? ? 'pokojnine-2026' : 'socialni-transferji-2026' %>.webp"><img src="/images/payments/<%= guide.pension? ? 'pokojnine-2026' : 'socialni-transferji-2026' %>.webp" width="1440" height="900" loading="lazy" decoding="async" alt="<%= guide.pension? ? 'Datumi izplačil pokojnin 2026 po mesecih; decembrska pokojnina je določena za 29. december.' : 'Koledar izbranih socialnih transferjev: datumi nakazil v oktobru, novembru in decembru 2026 po terminskem planu CSD.' %>"></a><figcaption>Priprava prikaza: Koledar365 · Podatki: <a href="<%= guide.source['url'] %>"><%= guide.pension? ? 'ZPIZ' : 'CSD' %></a> · Preverjeno 21. 10. 2026</figcaption></figure></section>
  <section id="vprasanja-izplacila" class="payment-faq"><h2>Dobro je vedeti pred naslednjim nakazilom</h2><% guide.faq.each do |question,answer| %><details><summary><%= question %></summary><p><%= answer %></p></details><% end %></section>
  <section id="viri-izplacil" class="payment-source"><div><p class="payment-kicker">VIR IN OBSEG PODATKOV</p><h2>Objavljeni datumi, preverljivi pri izdajatelju.</h2><p>Vir: <a href="<%= guide.source['url'] %>"><%= guide.source['title'] %> ↗</a>. Podatke je Koledar365 preveril <time datetime="2026-10-21">21. oktobra 2026</time>.</p><p><%= guide.pension? ? 'Vključili smo vseh 12 rednih mesečnih izplačil iz objavljenega koledarja za leto 2026. Prihodnjih let ne dopolnjujemo s samodejnim izračunom zadnjega delovnega dne.' : 'Iz izvorne tabele smo povzeli stolpec izplačilo. Ohranili smo razlike med vrstami prejemkov in obdelavami ter mesec izvornega plana. V planu 2026 je tudi objavljeni prenos druge decembrske obdelave DSP na 5. januar 2027.' %></p><p>To je koledarski pregled, ne odločba o pravici ali napoved ure priliva. Za osebni primer se obrnite na <%= guide.pension? ? 'ZPIZ' : 'pristojni CSD' %>.</p></div><aside><h3>Ste opazili spremembo?</h3><p>Pošljite nam povezavo do uradne objave in podatek, ki ga je treba popraviti.</p><a href="/kontakt/">Sporočite popravek →</a><a href="/viri-in-metodologija/">Naša metodologija →</a><a href="/o-nas/">O Koledar365 →</a></aside></section>
</article>
