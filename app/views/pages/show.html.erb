<% if @section=='home' %>
<div class="intro"><div><h1>Vaš dan. Vaši načrti.</h1><p>Slovenski koledar, prazniki in osebno načrtovanje.</p></div><a class="button subtle" href="/ustvari-koledar/"><%= ui_icon('settings') %> Ustvari svoj koledar</a></div>
<%= render 'home' %>
<% elsif @section=='tool' && page_path=='/nacrtovalnik-dopusta/' %>
<%= render 'vacation_planner' %>
<% elsif @section=='tool' && page_path=='/odstevanje/' %>
<%= render 'countdown' %>
<% elsif %w[about privacy cookie_policy holidays observance school horoscope calendar_studio].include?(@section) %>
<%= render @section %>
<% else %>
<% if page_path=='/datumski-kalkulator/' %>
<div class="date-hero">
  <div class="date-hero__copy"><span class="eyebrow">KOLEDAR365 · DATUMSKA ORODJA</span><h1><%= @title %></h1><p><%= @description %></p><div class="date-hero__tags"><span><i></i> Takojšen izračun</span><span><i></i> Slovenski prazniki</span><span><i></i> Povezava za deljenje</span></div></div>
  <div class="date-hero__art" aria-hidden="true">
    <svg viewBox="0 0 380 260" role="presentation" focusable="false">
<defs><linearGradient id="dateScene" x2="1" y2="1"><stop stop-color="#fff"/><stop offset="1" stop-color="#e8f0fa"/></linearGradient></defs>
<ellipse cx="185" cy="230" rx="125" ry="12" fill="#15385d" opacity=".08"/><circle cx="300" cy="64" r="39" fill="#eaf2fb"/>
<g transform="rotate(-7 164 120)"><use href="/visuals/ui-material-v3.svg#calendar" x="44" y="-3" width="245" height="245"/></g>
<rect x="226" y="116" width="111" height="111" rx="24" fill="url(#dateScene)" stroke="#d8e4f0"/><use href="/visuals/ui-material-v3.svg#clock" x="238" y="121" width="88" height="88"/>
<path d="M306 35v13m-6-6h12M49 170v10m-5-5h10" stroke="#97b3d0" stroke-width="2" stroke-linecap="round"/>
</svg>
  </div>
</div>
<% elsif page_path=='/lunin-koledar/' %>
<section class="lunar-hub-masthead" aria-labelledby="lunar-hub-title">
  <div class="lunar-hub-masthead__copy">
    <span class="lunar-hub-kicker">KOLEDAR365 <i aria-hidden="true"></i> LUNA 2027–2030</span>
    <h1 id="lunar-hub-title"><%= @title %></h1>
    <p><%= @description %></p>
    <div class="lunar-hub-facts" aria-label="Vsebina luninega koledarja">
      <span><strong>4</strong> leta</span><span><strong>48</strong> mesecev</span><span><strong>Europe/Ljubljana</strong> lokalni čas</span>
    </div>
  </div>
  <div class="lunar-hub-masthead__art" aria-hidden="true">
    <svg viewBox="0 0 520 360" focusable="false">
      <defs>
        <radialGradient id="lunarHubMoon" cx="35%" cy="28%"><stop stop-color="#fff"/><stop offset=".72" stop-color="#e8eff8"/><stop offset="1" stop-color="#a9c1dc"/></radialGradient>
        <linearGradient id="lunarHubBlue" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#53a0e5"/><stop offset="1" stop-color="#005da4"/></linearGradient>
        <linearGradient id="lunarHubRed" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ff626b"/><stop offset="1" stop-color="#ed1c24"/></linearGradient>
        <clipPath id="lunarHubClip"><circle cx="292" cy="171" r="105"/></clipPath>
      </defs>
      <circle cx="292" cy="171" r="139" fill="#fff" opacity=".045"/>
      <circle cx="292" cy="171" r="119" fill="none" stroke="#91bde7" stroke-opacity=".28"/>
      <circle cx="292" cy="171" r="105" fill="url(#lunarHubMoon)"/>
      <g clip-path="url(#lunarHubClip)" fill="none" stroke="#637f9e" stroke-opacity=".2">
        <path d="M180 117c51-35 143-29 211 8M176 163c66-22 153-15 224 17M190 219c56-22 133-20 195 4"/>
        <ellipse cx="292" cy="171" rx="37" ry="105"/><ellipse cx="292" cy="171" rx="77" ry="105"/>
        <circle cx="252" cy="138" r="13"/><circle cx="328" cy="202" r="20"/><circle cx="273" cy="228" r="8"/><circle cx="340" cy="133" r="9"/>
      </g>
      <path d="M292 66a105 105 0 0 1 0 210c-34-29-52-65-52-105s18-76 52-105Z" fill="#14253f" opacity=".13"/>
      <path d="M84 263c69-69 159-77 256-24" fill="none" stroke="url(#lunarHubRed)" stroke-width="5" stroke-linecap="round"/>
      <path d="M193 56c70-35 162-22 217 34" fill="none" stroke="url(#lunarHubBlue)" stroke-width="3" stroke-linecap="round"/>
      <circle cx="84" cy="263" r="8" fill="#ed1c24"/><circle cx="410" cy="90" r="6" fill="#fff"/>
      <path d="M107 91v14m-7-7h14M442 240v14m-7-7h14M395 302v10m-5-5h10" stroke="#fff" stroke-width="2" stroke-linecap="round" opacity=".8"/>
      <circle cx="144" cy="187" r="3" fill="#78b7ef"/><circle cx="423" cy="158" r="3" fill="#ff6972"/><circle cx="171" cy="307" r="2" fill="#fff"/>
    </svg>
  </div>
</section>
<% else %><div class="page-heading"><span class="eyebrow">KOLEDAR365 · SLOVENIJA</span><h1><%= @title %></h1><% unless @section=='events' && TopicContent.find(page_path.split('/').last) %><p><%= gallery_page? ? gallery_description : @description %></p><% end %></div><% end %>
<%= render @section %>
<% end %>

<% if @page&.body.present? && !%w[observance school horoscope calendar_studio].include?(@section) %><section class="panel prose"><%= simple_format(@page.body) %></section><% end %>
