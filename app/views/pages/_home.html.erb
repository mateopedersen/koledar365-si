<div class="workspace" data-home-year="<%= @year %>" data-home-month="<%= @month %>" data-home-view="<%= @view %>">
<aside class="left-panel"><%= render 'city_card' %>
<section class="panel"><h2><%= ui_icon('calendar') %> Prihajajoči prazniki</h2><% @upcoming.each do |e| %><a class="upcoming" href="<%= event_path(e) %>"><time><%= e.on.strftime('%-d. %-m.') %></time><span><b><%= e.title.sub(/\A./, &:upcase) %></b><small><%= e.work_free ? 'Dela prost dan':'Ni dela prost dan' %></small></span></a><% end %><a class="more" href="/prazniki/">Vsi prazniki →</a></section>
<section class="panel"><h2><%= ui_icon('check') %> Moji koledarji</h2><label class="check"><input type="checkbox" checked id="show-holidays"> <%= ui_icon('holidays') %> Slovenski prazniki</label><label class="check"><input type="checkbox" checked id="show-personal"> <%= ui_icon('personal') %> Osebni dogodki</label><% {'work'=>'Delo','family'=>'Družina','school'=>'Šola'}.each do |key,label| %><label class="check"><input type="checkbox" checked data-category-toggle="<%= key %>"><%= ui_icon(key) %><%= label %></label><% end %><p class="muted">Osebni zapisi ostanejo samo na tej napravi.</p></section></aside>
<section class="center-panel"><dl class="stats" aria-label="Podatki o izbranem dnevu">
  <div><span aria-hidden="true"><%= ui_icon('week') %></span><dt>Teden ISO</dt><dd><%= @selected.cweek %></dd></div>
  <div><span aria-hidden="true"><%= ui_icon('calendar') %></span><dt>Dan v letu</dt><dd><%= @selected.yday %></dd></div>
  <div><span aria-hidden="true"><%= ui_icon('clock') %></span><dt>Dni v mesecu</dt><dd><%= Date.new(@year,@month,-1).day %></dd></div>
</dl>
<section class="panel calendar-panel"><%= render 'calendar_controls' %><div class="category-bar" aria-label="Filtri dogodkov"><button class="category-chip active" data-category="all" aria-pressed="true"><%= ui_icon('grid') %> Vse</button><% {'holidays'=>'Prazniki','personal'=>'Osebno','work'=>'Delo','family'=>'Družina','school'=>'Šola'}.each do |key,label| %><button class="category-chip" data-category="<%= key %>" aria-pressed="false"><%= ui_icon(key) %><%= label %></button><% end %><label class="event-search"><%= ui_icon('search') %><input id="event-search" type="search" placeholder="Poišči dogodek" aria-label="Poišči dogodek v prikazu"></label></div><%= render 'calendar_view' %><div class="calendar-footer"><span><i class="dot green"></i> Danes <i class="dot red"></i> Dela prost dan</span><div><button data-print><%= ui_icon('print') %> Natisni</button><a class="button" href="<%= calendar_editor_path(year:@year,month:@month,date:@selected,view:@view) %>" data-selected-calendar-editor>Uredi</a><a class="button" href="<%= calendar_print_path(year:@year,month:@month,date:@selected,type:calendar_download_type(@view)) %>" data-selected-calendar-download><%= ui_icon('download') %> Prenesi</a></div></div></section></section>
<aside class="right-panel" id="personal-planner" data-selected-date="<%= @selected %>"><%= render 'personal' %></aside>
</div>
<%= render 'expansion_discovery' %>
<section class="panel discovery"><div class="section-heading"><h2>Več možnosti. Vse na enem mestu.</h2><a href="/orodja/">Vsa orodja →</a></div><div class="feature-grid"><div><h3><%= ui_icon('calendar') %> Koledarji 2027–2030</h3><p>Letni in mesečni koledarji za vsak načrt.</p><div class="year-links"><% (2027..2030).each do |y| %><a href="/koledar/<%= y %>/"><%= y %></a><% end %></div></div><a href="/datumski-kalkulator/" class="feature"><h3><%= ui_icon('calculator') %> Datumski kalkulator</h3><p>Preštejte dneve in poiščite pravi datum.</p><span>Izračunaj →</span></a></div><div class="quick-links"><a href="/horoskop/" class="home-zodiac-link"><%= horoscope_icon %> Dnevni horoskop in znamenja</a><a href="/pomembni-dnevi/"><%= ui_icon('gift') %> Pomembni dnevi</a><a href="/lunin-koledar/"><%= ui_icon('moon') %> Lunin koledar</a><a href="/nacrtovalnik-dopusta/"><%= ui_icon('vacation') %> Načrtovalnik dopusta</a><a href="/prazen-koledar/"><%= ui_icon('note') %> Prazen koledar</a></div></section>
