<% if @section=='blog' %>
<%= render 'blog' %>
<% elsif @section=='shopping_guide' %>
<%= raw ShoppingGuides.body(page_path) %>
<%= render 'occasion_planner', entries: [] %>
<% elsif %w[festivals festival_detail].include?(@section) %>
<%= render @section %>
<% elsif page_path=='/vpisni-koledar/' %>
<%= render 'admissions' %>
<% elsif page_path == SlovenianSkyCalendar::PATH %>
<%= render 'sky_calendar_guide' %>
<% elsif %w[local_tool tools_index slovenian_resource].include?(@section) %>
<%= render @section %>
<% elsif page_path=='/kontakt/' %>
<%= render 'contact' %>
<% elsif page_path=='/koledar/' %>
<%= render 'calendar_directory' %>
<% elsif page_path=='/mesecni-koledar/' %>
<%= render 'monthly_calendar' %>
<% elsif page_path.start_with?('/tedenski-koledar/') %>
<%= render 'weekly_calendar' %>
<% elsif @section=='home' %>
<div class="intro"><div><h1>Slovenski koledar za vaše načrte.</h1><p>Prazniki, osebni dogodki in orodja za vsak dan.</p></div><%= render 'calendar_studio_cta' %></div>
<%= render 'home' %>
<% elsif @section=='tool' && page_path=='/nacrtovalnik-dopusta/' %>
<%= render 'vacation_planner' %>
<% elsif @section=='tool' && page_path=='/odstevanje/' %>
<%= render 'countdown' %>
<% elsif %w[about terms privacy cookie_policy holidays observance school calendar_studio horoscope methodology garden_calendar payment_calendar education_calendar school_timetable moon_phases astronomy_events seasons].include?(@section) %>
<%= render @section %>
<% else %>
<% if @calendar_collection %>
<%= render 'calendar_collection_intro', copy: @calendar_collection %>
<% elsif page_path=='/koledar-za-tiskanje/' %>
<%= render 'print_calendar_intro' %>
<% elsif page_path=='/datumski-kalkulator/' %>
<div class="date-hero">
  <div class="date-hero__copy">
    <span class="eyebrow">KOLEDAR365 · DATUMSKA ORODJA</span>
    <h1><%= @title %></h1>
    <p><%= @description %></p>
    <%= render 'hero_features', label: 'Možnosti datumskega kalkulatorja', items: [['calculator', 'Razlika in premik datuma'], ['holidays', 'Delovniki in prazniki'], ['share', 'Povezava do rezultata']] %>
  </div>
  <div class="date-hero__art" aria-hidden="true">
    <%= page_hero_art('date') %>
  </div>
</div>
