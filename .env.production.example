# Copy to .env.production; generate secrets on the deployment host.
# Never commit the real file. Compose also reads POSTGRES_PASSWORD from --env-file.
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
SITE_URL=https://koledar365.si
DOMAIN=koledar365.si
RAILS_LOG_LEVEL=info
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
# Fill with the real hosting and operator contact before public release.
OPERATOR_NAME=Mateo Pedersen
OPERATOR_CONTACT=
HOSTING_PROVIDER=
PRIVACY_HOSTING_NOTICE=
