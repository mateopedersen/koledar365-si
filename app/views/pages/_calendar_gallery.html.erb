<% period = month ? "koledar za #{CalendarEngine::MONTHS[month - 1]} #{year}" : "letni koledar #{year}" %>
<section class="calendar-gallery" id="calendar-designs" aria-labelledby="calendar-gallery-title" data-calendar-gallery data-gallery-type="<%= month ? 'monthly' : 'annual' %>" data-gallery-year="<%= year %>" data-gallery-month="<%= month %>">
  <header class="calendar-gallery-heading">
    <div><span class="eyebrow">ZBIRKA ZA TISKANJE</span><h2 id="calendar-gallery-title"><%= period.capitalize %>: 15 predlog</h2></div>
    <span class="calendar-gallery-quality"><%= ui_icon('print') %><span>A4 · Pokončno<small>Podpis Koledar365 na vsaki strani</small></span></span>
  </header>
  <div class="calendar-gallery-toolbar" data-gallery-filters>
    <div class="calendar-gallery-filters" role="group" aria-label="Barve predlog">
      <button type="button" data-gallery-filter="all" aria-pressed="true">Vse predloge</button>
      <button type="button" data-gallery-filter="color" aria-pressed="false">Barvne</button>
      <button type="button" data-gallery-filter="monochrome_bw" aria-pressed="false">Črno-bele</button>
    </div>
    <span data-gallery-count role="status">15 predlog</span>
  </div>
  <noscript><style>.calendar-gallery-toolbar{display:none!important}</style></noscript>
  <div class="calendar-gallery-grid">
    <% rows.each_with_index do |row, index| %>
      <% design = row.fetch('design'); files = row.fetch('files'); pages = row.fetch('page_count'); zipped = files.fetch('webp').end_with?('.zip') %>
      <article class="calendar-design-card" id="predloga-<%= design['id'] %>" data-calendar-design="<%= design['id'] %>" data-color-mode="<%= design['color_mode'] %>">
        <a class="calendar-design-image" href="<%= files.fetch('pdf') %>" target="_blank" rel="noopener" aria-label="Odpri PDF: <%= design['name_sl'] %> – <%= period %>">
          <img src="<%= files.fetch('preview') %>" alt="<%= period.capitalize %> – <%= design['name_sl'] %>, predogled prve strani" width="354" height="500" loading="lazy" decoding="async">
          <span><%= pages == 1 ? '1 stran' : "#{pages} strani" %></span>
        </a>
        <div class="calendar-design-info">
          <h3><span><%= '%02d' % (index + 1) %></span><%= design['name_sl'] %></h3>
          <p class="calendar-design-meta"><i class="<%= design['color_mode'] == 'monochrome_bw' ? 'mono' : 'color' %>" aria-hidden="true"></i><%= design['color_mode'] == 'monochrome_bw' ? 'Črno-belo' : 'Barvno' %> · A4 · Pokončno</p>
          <a class="button calendar-design-preview" href="<%= files.fetch('pdf') %>" target="_blank" rel="noopener">Odpri predogled <span aria-hidden="true">↗</span></a>
          <div class="calendar-design-downloads">
            <a class="button" href="<%= files.fetch('pdf') %>" download="<%= File.basename(files.fetch('pdf')) %>" data-calendar-download="pdf" aria-label="Prenesi PDF: <%= design['name_sl'] %> – <%= period %>"><%= ui_icon('download') %>Prenesi PDF</a>
            <a class="button" href="<%= files.fetch('webp') %>" download="<%= File.basename(files.fetch('webp')) %>" data-calendar-download="webp" aria-label="Prenesi <%= zipped ? 'WebP ZIP' : 'WebP' %>: <%= design['name_sl'] %> – <%= period %>"><%= ui_icon('download') %><%= zipped ? 'WebP ZIP' : 'Prenesi WebP' %></a>
          </div>
          <small class="calendar-design-note"><%= zipped ? "Vseh #{pages} strani WebP v eni datoteki ZIP." : 'PDF in WebP z enako postavitvijo.' %></small>
        </div>
      </article>
    <% end %>
  </div>

</section>
