<% local = schedule.local(event) %>
<section class="astro-event-detail" aria-labelledby="astro-detail-title">
  <div class="astro-detail-top"><div><span class="eyebrow">IZBRANI MRK · <span data-detail-city><%= schedule.city['name'] %></span></span><h3 id="astro-detail-title" data-detail-title><%= astro_date(event['date']) %></h3></div><span class="astro-status <%= local['visible'] ? 'is-visible' : 'is-invisible' %>" data-detail-status><%= local['visible'] ? "#{astro_kind(local['kind'])} nad obzorjem" : 'Iz kraja ni viden' %></span></div>
  <p class="astro-detail-summary" data-detail-summary><% if local['visible'] %>Izračunano okno nad ravnim obzorjem: <strong><%= astro_interval(local['windows']) %></strong>. <% unless local['peak_visible'] %><strong>Maksimum je pod obzorjem.</strong> Viden je samo del poteka.<% end %><% else %>Ta mrk se zgodi drugje na Zemlji. Za izbrani kraj ni izračunanega intervala, v katerem bi bil mrk nad obzorjem.<% end %></p>
  <div data-detail-chart><%= render 'pages/astronomy_visibility', local: local, kind: schedule.kind %></div>
  <p class="astro-chart-key" data-detail-chart-key <%= 'hidden' unless local['visible'] %>><span class="astro-key-line"></span> Višina središča <%= schedule.kind == 'solar' ? 'Sonca' : 'Lune' %> <span class="astro-key-horizon"></span> Obzorje · Ure v Sloveniji</p>
  <div class="astro-contact-table" data-detail-contacts>
    <% local.fetch('contacts').each do |key, contact| %><div class="astro-contact <%= contact['above_horizon'] ? 'is-above' : 'is-below' %>"><span><%= astro_contact_label(key, local) %></span><time datetime="<%= contact['utc'] %>"><%= astro_time(contact['utc']) %><% if astro_local_time(contact['utc']).to_date.iso8601 != event['date'] %><small class="astro-contact-date"><%= astro_local_time(contact['utc']).strftime('%-d. %-m.') %></small><% end %></time><small><%= contact['above_horizon'] ? 'Nad obzorjem' : 'Pod obzorjem' %> · <%= contact['altitude'].to_s.tr('.', ',') %>°</small></div><% end %>
  </div>
  <p class="astro-global-maximum" data-detail-global>Globalni maksimum: <strong><%= astro_time(event['peak'], zone: true) %></strong> (<%= astro_date(Time.iso8601(event['peak']).utc.to_date.iso8601) %>, <%= Time.at((Time.iso8601(event['peak']).to_f/60).round*60).utc.strftime('%H:%M') %> UTC).<%= schedule.kind == 'solar' ? ' To je vrhunec mrka na Zemlji, ne ura največjega zakritja v izbranem kraju.' : ' Trenutek maksimuma je skupen, njegova vidnost pa je odvisna od kraja.' %></p>
  <p class="astro-note" data-detail-percent <%= 'hidden' unless schedule.kind == 'solar' && local['peak_visible'] %>><% if schedule.kind == 'solar' && local['peak_visible'] %>Ob lokalnem maksimumu Luna prekrije približno <strong><%= local['peak_obscuration'].to_s.tr('.', ',') %> % Sončeve ploskve</strong>. To je delež površine, ne magnituda mrka, ki meri prekriti delež premera.<% end %></p>
</section>
