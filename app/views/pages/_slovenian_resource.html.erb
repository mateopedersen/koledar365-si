<% resource = SlovenianResources::PAGES.fetch(page_path)
   guide = SlovenianResourceEditorial::GUIDES.fetch(page_path)
   metric = guide[:fact] || resource.fetch(:metric)
   timetable = page_path == '/predloge-urnikov/'
   has_tool = resource[:calculator] || [SlovenianResources::HUB, '/predloge-urnikov/'].include?(page_path) %>
<article class="sl-resource sl-resource--<%= guide.fetch(:theme) %> <%= 'sl-print-page' if timetable %>">
  <header class="sl-resource-hero">
    <div class="sl-resource-hero-copy">
      <h1><%= resource.fetch(:title) %></h1>
      <p><%= resource.fetch(:description) %></p>
      <div class="sl-resource-hero-actions">
        <a class="button primary" href="#<%= has_tool ? 'orodje' : 'prakticni-pregled' %>"><%= guide.fetch(:action) %><span aria-hidden="true"><%= ui_icon('arrow-down') %></span></a>
        <a class="button" href="#<%= timetable ? 'prakticni-pregled' : 'sl-sources' %>"><%= timetable ? 'Primer in navodila' : 'Uradni viri' %></a>
      </div>
    </div>
    <div class="sl-resource-highlight">
      <%= tool_directory_icon(resource.fetch(:icon)) %>
      <div><strong><%= metric.first %></strong><span><%= metric.last %></span></div>
    </div>
  </header>

  <% if resource[:calculator] %>
    <%= render 'slovenian_calculator', resource: resource %>
  <% elsif page_path == SlovenianResources::HUB %>
    <div class="sl-resource-catalog" id="orodje">
      <% [['Družina in varstvo otrok', SlovenianResources::FAMILY_PATHS], ['Zaposlitev, zdravje in socialna pomoč', SlovenianResources::SUPPORT_PATHS]].each do |heading, paths| %>
        <section class="sl-resource-panel">
          <h2><%= heading %></h2>
          <%= render 'slovenian_resource_links', paths: paths, descriptions: true %>
        </section>
      <% end %>
    </div>
  <% elsif timetable %>
    <%= render 'slovenian_timetable_templates' %>
  <% end %>

  <section class="sl-resource-panel sl-resource-example" id="prakticni-pregled" aria-labelledby="sl-example">
    <div>
      <h2 id="sl-example"><%= guide.fetch(:question) %></h2>
      <p><%= guide.fetch(:answer) %></p>
      <% if timetable %>
        <p class="sl-case-source"><a href="?type=school&amp;date=2028-09-06#orodje">Odpri primer šolskega urnika</a></p>
      <% else %>
        <% source = resource.fetch(:sources).first %>
        <p class="sl-case-source"><%= link_to source.first, source.last %></p>
      <% end %>
      <% unless timetable || page_path == SlovenianResources::HUB %>
        <div class="sl-example-links">
          <% guide.fetch(:routes).each do |path| %>
            <%= link_to editorial_recommendation(path)[1], path %>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="sl-resource-checklist">
      <h3><%= guide.fetch(:heading) %></h3>
      <ol>
        <% guide.fetch(:steps).each do |label, text| %>
          <li><strong><%= label %></strong><p><%= text %></p></li>
        <% end %>
      </ol>
    </div>
  </section>

  <div class="sl-resource-reading">
    <section class="sl-resource-panel sl-resource-copy">
      <% resource.fetch(:sections).each do |heading, text| %>
        <h2><%= heading %></h2>
        <p><%= timetable ? editorial_paragraph(text) : text %></p>
      <% end %>
    </section>
    <aside class="sl-resource-panel sl-resource-sources" aria-labelledby="sl-sources">
      <h2 id="sl-sources">Uradni viri</h2>
      <ul>
        <% resource.fetch(:sources).each do |label, url| %>
          <li><%= link_to label, url %></li>
        <% end %>
      </ul>
      <% checked_on = resource.fetch(:checked_on, SlovenianResources::CHECKED_ON) %>
      <p>Preverjeno <time datetime="<%= checked_on %>"><%= Date.iso8601(checked_on).strftime('%-d. %-m. %Y') %></time></p>
    </aside>
  </div>
  <% extra_routes = resource.fetch(:related) - (page_path == SlovenianResources::HUB ? [] : guide.fetch(:routes)) %>
  <% if extra_routes.any? %>
    <nav class="sl-resource-panel" aria-labelledby="sl-related">
      <h2 id="sl-related">Povezana orodja</h2>
      <%= render 'slovenian_resource_links', paths: extra_routes %>
    </nav>
  <% end %>
</article>
