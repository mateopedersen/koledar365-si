<% school_data=JSON.parse(Rails.root.join('public/school/data.json').read); held=@page.status=='held'; level=params[:level]=='secondary' ? 'secondary' : 'primary'; region=params[:region]=='east' ? 'east' : 'west'; hero_photo=school_data.dig('photos','hero') %>
<div class="school-page" data-school-page data-held="<%= held %>">
<svg class="sp-symbols" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true"><defs>
<% sprite_url = IllustrationHelper.versioned_svg_url('/visuals/ui-material-v3.svg') %>
<symbol id="sp-calendar" viewBox="0 0 24 24"><use href="<%= sprite_url %>#calendar" xlink:href="<%= sprite_url %>#calendar" width="24" height="24"/></symbol>
<symbol id="sp-arrow" viewBox="0 0 24 24"><use href="<%= sprite_url %>#arrow" xlink:href="<%= sprite_url %>#arrow" width="24" height="24"/></symbol>
<symbol id="sp-download" viewBox="0 0 24 24"><use href="<%= sprite_url %>#download" xlink:href="<%= sprite_url %>#download" width="24" height="24"/></symbol>
<symbol id="sp-pin" viewBox="0 0 24 24"><use href="<%= sprite_url %>#pin" xlink:href="<%= sprite_url %>#pin" width="24" height="24"/></symbol>
<symbol id="sp-check" viewBox="0 0 24 24"><use href="<%= sprite_url %>#check" xlink:href="<%= sprite_url %>#check" width="24" height="24"/></symbol>
<symbol id="sp-school" viewBox="0 0 24 24"><use href="<%= sprite_url %>#school" xlink:href="<%= sprite_url %>#school" width="24" height="24"/></symbol>
<symbol id="sp-sun" viewBox="0 0 24 24"><use href="<%= sprite_url %>#sun" xlink:href="<%= sprite_url %>#sun" width="24" height="24"/></symbol>
<symbol id="sp-list" viewBox="0 0 24 24"><use href="<%= sprite_url %>#note" xlink:href="<%= sprite_url %>#note" width="24" height="24"/></symbol>
<symbol id="sp-heart" viewBox="0 0 24 24"><use href="<%= sprite_url %>#heart" xlink:href="<%= sprite_url %>#heart" width="24" height="24"/></symbol>
</defs></svg>
<% if held %>
<section class="sp-held"><span class="sp-kicker">NAČRTUJTE Z ZANESLJIVIMI PODATKI</span><h1><%= @title %></h1><p>Uradni termini za to šolsko leto še niso potrjeni v naši zbirki. Ko bodo preverjeni, jih bomo dodali. Datumov ne napovedujemo.</p><a class="sp-primary" href="/solske-pocitnice/">Odpri preverjeno leto 2026/2027 <span aria-hidden="true">→</span></a><p><a href="<%= school_data['sources']['primary'] %>">Preverite objave ministrstva ↗</a></p></section>
<% else %>
<section class="sp-hero" aria-labelledby="sp-title">
<div class="sp-hero-copy"><span class="sp-kicker"><span></span> ŠOLSKE POČITNICE · 2026 / 2027</span><h1 id="sp-title"><%= @page.path == "/solske-pocitnice/" ? "Šolske počitnice 2026/2027 v Sloveniji" : @page.title %></h1><p>Preverite počitnice za osnovne in srednje šole, izberite lokacijo šole ter shranite termine v svoj koledar.</p><div class="sp-hero-actions"><a class="sp-primary" href="#pocitnice">Preverite počitnice <svg class="sp-icon"><use href="#sp-arrow"/></svg></a><button class="sp-plain" type="button" data-export-all><svg class="sp-icon"><use href="#sp-download"/></svg> Izvozi koledar</button></div><div class="sp-hero-actions"><a class="sp-plain" href="/solski-koledar/">Celoten šolski koledar →</a><a class="sp-plain" href="/studijski-koledar/">Študijski koledar →</a></div><div class="sp-trust"><svg class="sp-icon"><use href="#sp-check"/></svg> Preverjeno po uradnih virih <span>·</span> Posodobljeno 20. 10. 2026</div></div>
<div class="sp-hero-art"><img src="<%= hero_photo['path'] %>" width="640" height="420" alt="<%= hero_photo['alt'] %>" fetchpriority="high"><div class="sp-photo-credit sp-photo-credit-hero"><a href="<%= hero_photo['source'] %>" target="_blank" rel="noopener noreferrer" title="<%= hero_photo['title'] %>">Foto: <%= hero_photo['author'] %></a><span aria-hidden="true"> · </span><a href="<%= hero_photo['licenseUrl'] %>" target="_blank" rel="license noopener noreferrer"><%= hero_photo['license'] %></a></div><div class="sp-art-note"><span class="sp-note-icon"><svg class="sp-icon"><use href="#sp-sun"/></svg></span><div><strong>Manj šole. Več doživetij.</strong><small>Najlepši dnevi se začnejo z načrtom.</small></div></div></div>
</section>
<div class="sp-quick-bar"><div><span class="sp-quick-icon"><svg class="sp-icon"><use href="#sp-calendar"/></svg></span><span><small data-countdown-label>Naslednje šolske počitnice</small><strong data-next-name>Jesenske počitnice</strong></span></div><span class="sp-next-date" data-next-date>26.–30. oktober 2026</span><div class="sp-countdown"><strong data-countdown>—</strong><span data-countdown-unit>dni do oddiha</span></div><a href="#pocitnice" aria-label="Poglej naslednji termin"><svg class="sp-icon"><use href="#sp-arrow"/></svg></a></div>
<section id="pocitnice" class="sp-explorer" aria-labelledby="sp-explorer-title">
<div class="sp-heading"><div><span class="sp-kicker">VAŠ ČAS, VAŠI NAČRTI</span><h2 id="sp-explorer-title">Kdaj odložimo šolske torbe?</h2><p>Izberite šolo in regijo. Za ostalo poskrbimo mi.</p></div><label class="sp-year-label">Šolsko leto<select aria-label="Šolsko leto" data-year-select><option value="2026">2026 / 2027</option><% (2027..2030).each do |y| %><option value="<%= y %>"><%= y %> / <%= y+1 %> · še ni preverjeno</option><% end %></select></label></div>
<div class="sp-filterbar"><div class="sp-levels" role="group" aria-label="Raven izobraževanja"><button type="button" data-level="primary" aria-pressed="<%= level=='primary' %>"><img class="sp-filter-illustration" src="/school/primary-school.svg" alt="" width="46" height="46"><span class="sp-level-label">Osnovna šola<small>Od 1. do 9. razreda</small></span></button><button type="button" data-level="secondary" aria-pressed="<%= level=='secondary' %>"><img class="sp-filter-illustration" src="/school/secondary-school.svg" alt="" width="46" height="46"><span class="sp-level-label">Srednja šola<small>Počitnice za dijake</small></span></button><button type="button" data-level="university" aria-pressed="false"><img class="sp-filter-illustration" src="/school/university.svg" alt="" width="46" height="46"><span class="sp-level-label">Univerze <span class="sp-new">NOVO</span><small>Študijski koledarji</small></span></button></div><label class="sp-region"><svg class="sp-icon"><use href="#sp-pin"/></svg><span class="sr-only">Skupina glede na lokacijo šole</span><select data-region-select aria-label="Skupina glede na lokacijo šole"><option value="west" <%= 'selected' if region=='west' %>>Zahodna skupina · Ljubljana</option><option value="east" <%= 'selected' if region=='east' %>>Vzhodna skupina · Maribor</option></select></label></div>
<p class="sp-region-note" data-school-only><svg class="sp-icon"><use href="#sp-pin"/></svg> Regija vpliva na zimske počitnice. Upoštevajte lokacijo šole. <a href="#zimske-regije">Katera skupina je moja? <span aria-hidden="true">↗</span></a></p>
<div class="sp-collection" data-school-only>
<div class="sp-section-line"><h3>Počitnice skozi vse leto <span>5 oddihov, nešteto možnosti</span></h3><button class="sp-save-filter" type="button" data-saved-only aria-pressed="false"><svg class="sp-icon"><use href="#sp-heart"/></svg> Shranjeno <span data-saved-count>0</span></button></div>
<div class="sp-holiday-grid" data-holiday-grid>
<% school_data['breaks'].reject { |e|e['region'] && e['region']!=region }.each do |e| %>
<% range=level=='secondary' && e['secondary'] ? e['secondary'] : [e['start'],e['end']]; start=Date.iso8601(range[0]);finish=Date.iso8601(range[1]) %>
<% photo=school_data.fetch('photos').fetch(e['photo']) %>
<article class="sp-holiday sp-<%= e['season'] %>" data-break-id="<%= e['id'] %>"><div class="sp-card-art"><img src="<%= photo['path'] %>" width="640" height="420" alt="<%= photo['alt'] %>" loading="lazy" decoding="async"><span class="sp-season-tag"><%= {'autumn'=>'JESEN','festive'=>'PRAZNIČNI ČAS','winter'=>'ZIMA','spring'=>'POMLAD','summer'=>'POLETJE'}[e['season']] %></span><button type="button" class="sp-favorite" data-favorite="<%= e['id'] %>" aria-label="Shrani: <%= e['name'] %>" aria-pressed="false"><svg class="sp-icon"><use href="#sp-heart"/></svg></button><div class="sp-photo-credit"><a href="<%= photo['source'] %>" target="_blank" rel="noopener noreferrer" title="<%= photo['title'] %>">Foto: <%= photo['author'] %></a><span aria-hidden="true"> · </span><% if photo['licenseUrl'] %><a href="<%= photo['licenseUrl'] %>" target="_blank" rel="license noopener noreferrer"><%= photo['license'] %></a><% else %><span><%= photo['license'] %></span><% end %></div></div><div class="sp-card-content"><small><%= e['tag'] %></small><h3><%= e['name'] %></h3><div class="sp-card-date"><svg class="sp-icon"><use href="#sp-calendar"/></svg><time datetime="<%= range[0] %>"><%= start.strftime('%-d. %-m. %Y') %> – <%= finish.strftime('%-d. %-m. %Y') %></time></div><div class="sp-card-bottom"><span><strong><%= (finish-start).to_i+1 %></strong> koledarskih dni <small>uradnega obdobja</small></span><button type="button" data-export-break="<%= e['id'] %>" aria-label="Izvozi: <%= e['name'] %>"><svg class="sp-icon"><use href="#sp-download"/></svg></button></div></div></article>
<% end %>
<aside class="sp-holiday sp-tip"><span class="sp-tip-sun"><svg class="sp-icon"><use href="#sp-sun"/></svg></span><span class="sp-kicker">MALO NAČRTOVANJA. VELIKO ODDIHA.</span><h3>Prosti dnevi<br>gredo radi skupaj.</h3><p>26. april 2027 je pouka prost dan. S prvomajskimi počitnicami in vikendoma poveže kar <strong>9 dni brez rednega pouka.</strong></p><a href="#nacrtovalnik">Načrtuj družinski oddih <svg class="sp-icon"><use href="#sp-arrow"/></svg></a><small>24. april–2. maj 2027 · izračunano</small></aside>
</div><p class="sp-empty" data-empty hidden>Še ni shranjenih počitnic za to izbiro. Priljubljene dodajte s srčkom na kartici.</p>
<div class="sp-date-note"><svg class="sp-icon"><use href="#sp-check"/></svg><p>Prikazujemo <strong>uradne datume</strong>. Prazniki in vikendi lahko oddih podaljšajo. Poletne počitnice se uradno začnejo 28. junija; 25. junij je praznik. Zaključni letniki imajo poseben koledar.</p></div>
</div>
</section>
<section class="sp-calendar-section" data-school-only aria-labelledby="sp-cal-title"><div class="sp-heading"><div><span class="sp-kicker">CELOTNA SLIKA NA EN POGLED</span><h2 id="sp-cal-title">Vaš koledar oddiha</h2><p>Barvni dnevi za počitnice. Majhne pike za praznike.</p></div><button class="sp-outline" type="button" data-print><svg class="sp-icon"><use href="#sp-download"/></svg> Natisni / shrani PDF</button></div><div class="sp-calendar-layout"><div class="sp-calendar-box"><div class="sp-month-heading"><h3 data-month-title>Oktober 2026</h3><div><button type="button" data-prev-month aria-label="Prejšnji mesec">←</button><button type="button" data-this-month>Danes</button><button type="button" data-next-month aria-label="Naslednji mesec">→</button></div></div><div class="sp-calendar-days" data-calendar aria-label="Mesečni koledar"></div><noscript><p>Za interaktivni koledar omogočite JavaScript. Uradni datumi so navedeni na karticah zgoraj.</p></noscript><div class="sp-legend"><span><i class="sp-dot sp-dot-teal"></i> Počitnice</span><span><i class="sp-dot sp-dot-gold"></i> Pouka prost dan</span><span><i class="sp-dot sp-dot-coral"></i> Praznik</span></div></div><aside class="sp-month-aside"><span class="sp-kicker">V TEM MESECU</span><div data-month-events></div><p class="sp-small">Kliknite dan za datum in pripadajoče obdobje.</p><output class="sp-selected-date" data-selected-date aria-live="polite">Izberite dan v koledarju.</output></aside></div></section>
<section id="univerze" class="sp-universities" aria-labelledby="sp-uni-title"><div class="sp-heading"><div><span class="sp-kicker sp-purple-text">TUDI ZA ŠTUDENTE <span class="sp-new">NOVO</span></span><h2 id="sp-uni-title">Študijski koledar 2026/2027</h2><p>Vseh 7 univerz in 2 mednarodni zvezi iz evidence NAKVIS. Preverjeni termini z jasno označenim obsegom.</p></div><label class="sp-uni-select-label">Prikaži univerzo<select data-university-select aria-label="Prikaži univerzo"><option value="all">Vse univerze · primerjava</option><% school_data['universities'].each do |uni| %><option value="<%= uni['id'] %>"><%= uni['name'] %></option><% end %></select></label></div><p><a class="sp-outline" href="/studijski-koledar/">Odprite pregled semestrov in izpitnih obdobij →</a></p><div class="sp-uni-toolbar"><label><span class="sr-only">Poišči univerzo ali mesto</span><input type="search" data-university-search placeholder="Poišči univerzo ali mesto…" aria-label="Poišči univerzo ali mesto"></label><label class="sp-verified-filter"><input type="checkbox" data-verified-only> Samo s preverjenimi termini</label><span data-university-count aria-live="polite">9 ustanov</span></div><p class="sp-registry-note"><a href="https://portal.nakvis.si/brskalnik-visokosolski-zavodi" target="_blank" rel="noopener">Seznam ustanov: javna evidenca NAKVIS ↗</a> · Stanje 20. 10. 2026. Mednarodni zvezi sta označeni posebej.</p><div class="sp-uni-grid">
<% school_data['universities'].each do |uni| %>
<% selected_calendar=uni['calendars']&.first; periods=selected_calendar ? selected_calendar['periods'] : uni['periods']; calendar_url=selected_calendar ? selected_calendar['url'] : uni['url'] %>
<article class="sp-uni-card sp-<%= uni['color'] %>" data-university="<%= uni['id'] %>"><div class="sp-uni-art sp-real-identity <%= 'sp-identity-dark' if uni.dig('logo','dark') %> <%= 'sp-identity-photo' if uni['identityPhoto'] %>"><% if uni['logo'] %><a class="sp-uni-identity" href="<%= uni['logo']['page'] %>" target="_blank" rel="noopener" aria-label="Uradna identiteta: <%= uni['name'] %>"><img src="<%= uni['logo']['path'] %>" alt="Logotip: <%= uni['name'] %>" width="260" height="100" loading="lazy"></a><% elsif uni['identityPhoto'] %><a class="sp-uni-identity sp-building-photo" href="<%= uni['identityPhoto']['page'] %>" target="_blank" rel="noopener"><img src="<%= uni['identityPhoto']['path'] %>" alt="<%= uni['identityPhoto']['alt'] %>" width="1004" height="1500" loading="lazy"><span><%= uni['identityPhoto']['caption'] %><small>Delpinova ulica 18B · arhivski posnetek</small></span></a><% else %><div class="sp-logo-unverified"><strong>Uradni logotip</strong><span>ni javno preverjen</span></div><% end %></div><div class="sp-uni-body"><span class="sp-uni-city"><svg class="sp-icon"><use href="#sp-pin"/></svg> <%= uni['city'] %> <span>2026 / 27</span></span><h3><%= uni['name'] %></h3><span class="sp-calendar-status sp-status-<%= uni['status'] %>"><%= {'verified'=>'Preverjen okvir 2026/27','faculty'=>'Preverjeno po članici','unverified'=>'Termini 2026/27 niso preverjeni'}[uni['status']] %></span><% if uni['kind']=='association' %><span class="sp-association">Mednarodna zveza univerz</span><% end %><% if selected_calendar %><label class="sp-faculty-select">Izberite članico<select data-faculty-select="<%= uni['id'] %>" aria-label="Izberite članico: <%= uni['name'] %>"><% uni['calendars'].each do |cal| %><option value="<%= cal['id'] %>"><%= cal['name'] %></option><% end %></select></label><% end %><p class="sp-uni-scope"><%= uni['scopeNote'] %></p><% if uni['specialNotice'] %><p class="sp-uni-scope"><a href="<%= uni['specialUrl'] %>" target="_blank" rel="noopener"><%= uni['specialNotice'] %> ↗</a></p><% end %><div class="sp-uni-periods" data-periods-for="<%= uni['id'] %>"><% periods.each do |p| %><div><span class="sp-period-type sp-type-<%= p[3] %>"><i></i><%= p[0] %></span><strong><%= Date.iso8601(p[1]).strftime('%-d. %-m. %Y') %> – <%= Date.iso8601(p[2]).strftime('%-d. %-m. %Y') %></strong></div><% end %></div><div class="sp-uni-bottom"><a href="<%= calendar_url %>" data-calendar-source="<%= uni['id'] %>" target="_blank" rel="noopener"><%= uni['status']=='unverified' ? 'Preveri pri ustanovi ↗' : 'Uradni koledar ↗' %></a><% unless uni['status']=='unverified' %><button type="button" data-export-university="<%= uni['id'] %>" aria-label="Izvozi študijski koledar: <%= uni['name'] %>"><svg class="sp-icon"><use href="#sp-download"/></svg></button><% end %></div><a class="sp-registry-link" href="<%= uni['registryUrl'] %>" target="_blank" rel="noopener">Zapis ustanove v NAKVIS ↗</a></div></article>
<% end %>
</div><p class="sp-empty" data-university-empty hidden>Za to iskanje ni ustanov. Poskusite drugo ime ali izključite filter preverjenih terminov.</p><div class="sp-uni-warning"><svg class="sp-icon"><use href="#sp-school"/></svg><p><strong>Izpitno obdobje ni počitniško obdobje.</strong> Datumi veljajo za univerzitetni okvir. Fakultete lahko določijo drugačne termine, obveznosti in proste dneve. Za osebni načrt preverite koledar svoje fakultete.</p></div><details class="sp-faculty"><summary>In kdaj imajo študenti res prosto? <span>Primer preverjene fakultete <span aria-hidden="true">＋</span></span></summary><div><% school_data['facultyBreaks'].each do |f| %><h3><%= f['name'] %></h3><p><strong>28.–31. december 2026</strong> in <strong>26.–30. april 2027</strong>: brez organiziranega pedagoškega dela.</p><p><%= f['note'] %></p><a href="<%= f['url'] %>" target="_blank" rel="noopener">Vir: študijski koledar FDV ↗</a><% end %></div></details></section>
<div class="sp-tools-grid" data-school-only><section id="zimske-regije" class="sp-region-card"><span class="sp-kicker">PRAVA REGIJA, PRAVI DATUMI</span><h2>Kdaj je na vrsti vaša šola?</h2><p>Zimski oddih je razdeljen v dve skupini.</p><div class="sp-region-options"><button type="button" data-region-choice="east" aria-pressed="<%= region=='east' %>"><span>01</span><div><strong>Vzhodna skupina</strong><small>15.–19. februar 2027</small></div><svg class="sp-icon"><use href="#sp-arrow"/></svg></button><button type="button" data-region-choice="west" aria-pressed="<%= region=='west' %>"><span>02</span><div><strong>Zahodna skupina</strong><small>22.–26. februar 2027</small></div><svg class="sp-icon"><use href="#sp-arrow"/></svg></button></div><details><summary>Poglej regije in izjeme</summary><p><strong>Vzhodna:</strong> jugovzhodna Slovenija (razen spodnjih občin), koroška, podravska, pomurska, savinjska in posavska regija.</p><p><strong>Zahodna:</strong> gorenjska, goriška, notranjsko-kraška, obalno-kraška, osrednjeslovenska in zasavska regija ter občine <strong>Ribnica, Sodražica, Loški Potok, Kočevje, Osilnica in Kostel.</strong></p></details></section><section id="nacrtovalnik" class="sp-planner"><span class="sp-kicker">NAČRT ZA DRUŽINSKI ODDIH</span><h2>Koliko dni je zares prostih?</h2><p>Izberite obdobje in preštejte dneve brez rednega pouka.</p><form data-planner><div class="sp-date-fields"><label>Od<input type="date" name="from" value="2027-04-24" min="2026-09-01" max="2027-08-31" required></label><label>Do<input type="date" name="to" value="2027-05-02" min="2026-09-01" max="2027-08-31" required></label></div><button class="sp-primary" type="submit">Izračunaj prosti čas <svg class="sp-icon"><use href="#sp-arrow"/></svg></button><output data-planner-result aria-live="polite">24. april–2. maj: 9 dni brez rednega pouka.</output></form><small>Vključuje vikende, praznike in šolske proste dni za izbrano skupino. Posebni urniki in izpitne obveznosti niso vključeni.</small></section></div>
<section class="sp-sources" aria-labelledby="sp-sources-title"><div><svg class="sp-icon"><use href="#sp-check"/></svg><h2 id="sp-sources-title">Dober načrt se začne s pravim datumom.</h2><p>Datume smo preverili 20. oktobra 2026. Za spremembe preverite uradni vir in obvestila šole.</p></div><details><summary>Viri, razlike in pogosta vprašanja <span aria-hidden="true">＋</span></summary><div class="sp-source-content"><section class="sp-photo-attributions" aria-labelledby="sp-photo-attributions-title"><h3 id="sp-photo-attributions-title">Fotografije slovenskih počitniških krajev</h3><p>Avtorske pravice ostajajo avtorjem. Fotografije so pomanjšane in prikazane z izrezom za pasico oziroma kartice; pri fotografijah pod licenco CC BY-SA je tudi ta prilagoditev objavljena pod isto licenco.</p><ul class="sp-photo-sources"><% school_data.fetch('photos').each_value do |photo| %><li><a href="<%= photo['source'] %>" target="_blank" rel="noopener noreferrer"><%= photo['title'] %></a> · Foto: <%= photo['author'] %> · <% if photo['licenseUrl'] %><a href="<%= photo['licenseUrl'] %>" target="_blank" rel="license noopener noreferrer"><%= photo['license'] %></a><% else %><%= photo['license'] %><% end %>. <%= photo['changes'] %></li><% end %></ul></section><p><strong>Resnični logotipi ustanov:</strong> logotipi so povzeti po uradnih spletnih straneh ustanov oziroma evidenci NAKVIS. Izvirnih barv ali razmerij ne spreminjamo. Pravice ostanejo njihovim imetnikom. Pri Evropski univerzi je namesto logotipa uporabljena arhivska fotografija stavbe EDA Center na njenem registriranem naslovu. Isti naslov uporablja tudi EPF Nove univerze; fotografije ne predstavljamo kot samostojen kampus Evropske univerze.</p><ul class="sp-logo-sources"><% school_data['universities'].select { |u|u['logo'] }.each do |u| %><li><%= u['name'] %>: <a href="<%= u['logo']['page'] %>" target="_blank" rel="noopener">vir: <%= u['logo']['source'] %> ↗</a> · <a href="<%= u['logo']['asset'] %>" target="_blank" rel="noopener">izvirni logotip ↗</a></li><% end %></ul><% school_data['universities'].select { |u|u['identityPhoto'] }.each do |u| %><p><strong><%= u['name'] %> – fotografija stavbe:</strong> <a href="<%= u['identityPhoto']['page'] %>" target="_blank" rel="noopener">vir: <%= u['identityPhoto']['source'] %> ↗</a> · <a href="<%= u['identityPhoto']['asset'] %>" target="_blank" rel="noopener">izvirna fotografija ↗</a> · <a href="<%= u['registryUrl'] %>" target="_blank" rel="noopener">preverjeni naslov v evidenci NAKVIS ↗</a>. Arhivska fotografija, na spletu objavljena 2019.</p><% end %><p><strong>Obseg univerz:</strong> vseh 9 veljavnih nadrejenih ustanov v <a href="https://portal.nakvis.si/brskalnik-visokosolski-zavodi" target="_blank" rel="noopener">hierarhični evidenci NAKVIS</a>: 7 univerz in 2 mednarodni zvezi univerz. Evidenca sama ne potrjuje aktualnih počitniških terminov. Za Alma Mater splošni koledar ni preverjen; Erasmus koledar je naveden posebej. Za Evropsko univerzo koledar ni preverjen. Neznani termini niso vključeni v izvoz.</p><p><strong>Šole:</strong> <a href="<%= school_data['sources']['primary'] %>" target="_blank" rel="noopener">Ministrstvo – osnovne šole ↗</a> · <a href="<%= school_data['sources']['secondary'] %>" target="_blank" rel="noopener">Ministrstvo – srednje šole ↗</a></p><p><strong>Zakaj se novoletni in prvomajski datumi razlikujejo?</strong> Osnovnošolski koledar navaja novoletne počitnice 25. 12.–2. 1. ter prvomajske 27. 4.–2. 5.; srednješolski navaja 28.–31. 12. ter 28.–30. 4. Prazniki in vikendi so ločeni dnevi brez pouka.</p><p><strong>Poletje in zaključni letniki:</strong> prikazan je splošni koledar. V 9. razredu se pouk konča 15. 6. 2027, v zaključnih letnikih srednje šole pa 21. 5. 2027; izpiti in matura imajo ločene termine.</p><p><strong>Naslednja šolska leta:</strong> še nepreverjenih terminov za leta 2027/2028–2030/2031 ne ocenjujemo na podlagi preteklih let.</p><p><strong>Prenos:</strong> datoteko ICS uvozite v Apple Calendar, Google Calendar ali Outlook. Gre za enkraten uvoz, ki se ob spremembi vira ne posodobi samodejno.</p><p><strong>Shranjeno:</strong> srčki ostanejo v tem brskalniku. Za njihov prikaz na drugi napravi ni sinhronizacije.</p></div></details></section>
