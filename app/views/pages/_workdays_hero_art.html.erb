<% annual_view = page_path != '/delovni-dnevi/' %>
<% days = CalendarEngine.working_days(Date.new(@year, 1, 1), Date.new(@year, 12, 31)).fetch(:dates) %>
<% monthly_counts = days.group_by(&:month).transform_values(&:size) %>
<svg viewBox="0 0 600 380" width="600" height="380" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="work-report-cover" x2="1" y2="1"><stop stop-color="#628da8"/><stop offset="1" stop-color="#183c58"/></linearGradient>
    <linearGradient id="work-report-paper" x2="1" y2="1"><stop stop-color="#fffefa"/><stop offset="1" stop-color="#e5eef3"/></linearGradient>
    <linearGradient id="work-report-bar" x2="0" y2="1"><stop stop-color="#5c9ab1"/><stop offset="1" stop-color="#245573"/></linearGradient>
    <linearGradient id="work-report-metal" x2="0" y2="1"><stop stop-color="#e4eaf0"/><stop offset=".46" stop-color="#718197"/><stop offset=".53" stop-color="#ebf2f7"/><stop offset="1" stop-color="#4f6582"/></linearGradient>
    <filter id="work-report-shadow" x="-.35" y="-.35" width="1.75" height="1.8"><feDropShadow dx="3" dy="12" stdDeviation="10" flood-color="#233b54" flood-opacity=".22"/></filter>
  </defs>
  <ellipse cx="305" cy="322" rx="213" ry="29" fill="#a3b9ce" opacity=".23"/>
  <g transform="rotate(-8 295 184)" filter="url(#work-report-shadow)">
    <rect x="105" y="68" width="350" height="253" rx="12" fill="#19374e"/>
    <rect x="102" y="61" width="350" height="253" rx="12" fill="url(#work-report-cover)" stroke="#5d7c96"/>
    <rect x="113" y="70" width="329" height="234" rx="7" fill="none" stroke="#bfdaea" stroke-opacity=".65" stroke-dasharray="2 3"/>
    <rect x="127" y="48" width="302" height="245" rx="6" fill="#a5b8c7"/>
    <rect x="124" y="41" width="302" height="245" rx="6" fill="url(#work-report-paper)" stroke="#bacbd5"/>
    <path d="M141 59v204" stroke="#ccabab" opacity=".65"/>
    <g font-family="system-ui,sans-serif" fill="#264a65">
      <text x="158" y="77" font-size="13" font-weight="700" letter-spacing="1"><%= annual_view ? "DELOVNI DNEVI #{@year}" : "DELOVNI KOLEDAR #{@year}" %></text>
      <text x="156" y="113" font-size="30" font-weight="800"><%= days.size %> dni</text>
      <text x="395" y="111" text-anchor="end" font-size="15" font-weight="650"><%= days.size * 8 %> ur</text>
      <path d="M156 128h239M156 157h239M156 187h239M156 217h239" fill="none" stroke="#beced9"/>
      <% (1..12).each do |month| %>
        <% x = 157 + (month - 1) * 20; height = monthly_counts.fetch(month, 0) * 3.6 %>
        <rect x="<%= x %>" y="<%= 217 - height %>" width="13" height="<%= height %>" rx="2" fill="url(#work-report-bar)"/>
        <text x="<%= x + 6.5 %>" y="234" text-anchor="middle" font-size="9"><%= month %></text>
      <% end %>
      <text x="158" y="260" font-size="11">Ponedeljek–petek · 8 ur na dan</text>
    </g>
  </g>
  <g transform="translate(377 303) rotate(-41)" filter="url(#work-report-shadow)">
    <path d="M0 0l27-8V8Z" fill="url(#work-report-metal)"/>
    <path d="M0 0l7-2v4Z" fill="#0e2335"/>
    <rect x="22" y="-8" width="140" height="16" rx="6" fill="url(#work-report-cover)"/>
    <path d="M27-4h124m-28 8h36" stroke="url(#work-report-metal)" stroke-width="2" stroke-linecap="round"/>
  </g>
</svg>
