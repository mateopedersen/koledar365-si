<% image = WebImageCatalog.find(path) %>
<picture><% if image %><source type="image/avif" srcset="<%= image['avif_srcset'] %>" sizes="<%= sizes %>"><% end %><img<% if local_assigns[:image_class] %> class="<%= image_class %>"<% end %> src="<%= image ? image['src'] : path %>"<% if image %><% if image['srcset'].present? %> srcset="<%= image['srcset'] %>" sizes="<%= sizes %>"<% end %> width="<%= image['width'] %>" height="<%= image['height'] %>"<% end %> alt="<%= alt %>" fetchpriority="<%= local_assigns[:loading] == 'lazy' ? 'auto' : 'high' %>" loading="<%= local_assigns[:loading] || 'eager' %>" decoding="<%= local_assigns[:loading] == 'lazy' ? 'async' : 'sync' %>"></picture>
