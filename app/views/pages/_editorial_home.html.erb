<section class="editorial-index editorial-home" aria-labelledby="home-guides">
  <div class="section-heading">
    <div><h2 id="home-guides">Od datuma do načrta</h2>
      <p>Primeri iz slovenskega koledarja, ki jih lahko takoj preizkusite z ustreznim orodjem.</p>
    </div>
    <a href="/blog/">Vseh 20 vodnikov <span aria-hidden="true"><%= ui_icon('arrow') %></span></a>
  </div>
  <% examples = {
    'letni-koledar-nacrt-za-12-mesecev' => ['Pripravljam letni načrt', 'Vnesite glavne roke in razporedite pripravo po mesecih.'],
    'solski-koledar-nacrt-za-dve-regiji' => ['Usklajujem urnika dveh šol', 'Preverite počitnice po občinah in označite dneve, ko potrebujete varstvo.'],
    'nacrt-izleta-po-svetlobi' => ['Načrtujem izlet po svetlobi', 'Od ure sončnega zahoda odštejte čas hoje in varnostno rezervo.'],
    'stenski-koledar-izbira-in-tisk' => ['Tiskam stenski koledar', 'Na poskusnem listu preverite merilo, robove in prostor za zapiske.']
  } %>
  <div class="editorial-index__cards">
    <% examples.each do |slug, (heading, detail)|; article = EditorialCatalog.articles.fetch(slug) %>
      <article>
        <a href="<%= EditorialCatalog.path(slug) %>">
          <img src="<%= EditorialCatalog.image(slug) %>" alt="<%= article.fetch('image_alt') %>" width="1200" height="630" loading="lazy" decoding="async">
          <div><h3><%= heading %></h3><p><%= detail %></p></div>
        </a>
      </article>
    <% end %>
  </div>
</section>
