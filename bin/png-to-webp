#!/usr/bin/env python3
# Generic image encoding adapter; calendar composition and content remain in Ruby.
import sys
from PIL import Image, ImageCms
src,dst=sys.argv[1:3]
image=Image.open(src).convert('RGB')
profile=ImageCms.ImageCmsProfile(ImageCms.createProfile('sRGB')).tobytes()
image.save(dst,'WEBP',lossless=True,method=4,icc_profile=profile)
