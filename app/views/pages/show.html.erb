  </div>
</section>
<% elsif page_path=='/soncni-vzhod-in-zahod/' %>
<%# The sun experience renders its own single, illustrated main heading. %>
<% else %><div class="page-heading"><span class="eyebrow">KOLEDAR365 · SLOVENIJA</span><h1><%= @title %></h1><% unless @section=='events' && TopicContent.find(page_path.split('/').last) %><p><%= gallery_page? ? gallery_description : @description %></p><% end %></div><% end %>
<%= render @section %>
<% end %>

<% if @page&.body.present? && !%w[observance school calendar_studio].include?(@section) %><section class="panel prose"><%= simple_format(@page.body) %></section><% end %>
