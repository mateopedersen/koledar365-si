<% selected=@selected || Date.new(@year,@month,1);mode=@view||'month';period=Date.new(@year,@month,1)
case mode
when 'week';previous=selected-7;following=selected+7;heading="Teden #{selected.cweek} · #{selected.cwyear}";before_label='Prejšnji teden';after_label='Naslednji teden'
when 'day';previous=selected-1;following=selected+1;heading=I18n.l(selected);before_label='Prejšnji dan';after_label='Naslednji dan'
when 'year';previous=period.prev_year;following=period.next_year;heading=@year.to_s;before_label='Prejšnje leto';after_label='Naslednje leto'
else;previous=period.prev_month;following=period.next_month;heading="#{CalendarEngine::MONTHS[@month-1].capitalize} #{@year}";before_label='Prejšnji mesec';after_label='Naslednji mesec'
end %>
<div class="calendar-title"><div class="actions"><% if previous>=Date.new(2026,10,1) %><a class="button square" href="/?<%= {year:previous.year,month:previous.month,date:previous.iso8601,view:mode}.to_query %>" aria-label="<%= before_label %>">‹</a><% end %><h2><%= heading %></h2><% if following.year<=2030 %><a class="button square" href="/?<%= {year:following.year,month:following.month,date:following.iso8601,view:mode}.to_query %>" aria-label="<%= after_label %>">›</a><% end %><a class="button" href="/?<%= {year:@today.year.clamp(2026,2030),month:@today.month,date:@today.iso8601,view:mode}.to_query %>">Danes</a></div><a class="button primary" href="<%= page_path=='/' ? '#personal-title' : "/?year=#{@year}&month=#{@month}&date=#{selected}#personal-title" %>" data-add-event><%= ui_icon('plus') %> Dodaj dogodek</a></div>
<div class="calendar-toolbar"><nav class="tabs" aria-label="Pogled koledarja"><% {'month'=>'Mesec','week'=>'Teden','day'=>'Dan','list'=>'Seznam','year'=>'Leto'}.each do |key,label| %><a class="<%= 'active' if mode==key %>" href="?year=<%= @year %>&month=<%= @month %>&date=<%= selected %>&view=<%= key %>"><%= label %></a><% end %></nav><form action="/" class="period-form"><label><span class="sr-only">Leto</span><select name="year"><% (2026..2030).each do |y| %><option <%= 'selected' if y==@year %>><%= y %></option><% end %></select></label><label><span class="sr-only">Mesec</span><select name="month"><% CalendarEngine::MONTHS.each_with_index do |m,i| %><option value="<%= i+1 %>" <%= 'selected' if i+1==@month %>><%= m %></option><% end %></select></label><button>Pokaži</button></form></div>
