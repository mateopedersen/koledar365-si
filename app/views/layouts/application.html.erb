<!doctype html>
<html lang="sl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= seo_title %></title>
<meta name="description" content="<%= @description || 'Slovenski koledarji, prazniki in orodja za osebno načrtovanje.' %>">
<meta name="robots" content="<%= @noindex || !Rails.env.production? ? 'noindex, follow' : 'index, follow, max-image-preview:large' %>">
<meta name="color-scheme" content="light"><meta name="theme-color" content="#ffffff">
<% hero_image_path = if @section == 'home' then CityCatalog.default.dig('photo', 'local_path') elsif @section == 'observance' then @observance&.photo&.dig('local_path') end %>
<% if (hero_image = WebImageCatalog.find(hero_image_path)) %>
<% hero_sizes = @section == 'home' ? WebImageCatalog::CITY_SIZES : '(max-width:760px) 100vw, 50vw' %>
<link rel="preload" as="image" type="image/avif" href="<%= hero_image.fetch('variants').first.fetch('avif') %>" imagesrcset="<%= hero_image.fetch('avif_srcset') %>" imagesizes="<%= hero_sizes %>" fetchpriority="high">
<% end %>
<% unless @not_found %><% sharing_image=seo_image %><link rel="canonical" href="<%= canonical_url %>">
<meta property="og:title" content="<%= seo_title %>"><meta property="og:description" content="<%= @description %>"><meta property="og:type" content="website"><meta property="og:site_name" content="Koledar365"><meta property="og:locale" content="sl_SI"><meta property="og:url" content="<%= canonical_url %>"><meta property="og:image" content="<%= sharing_image[:url] %>"><meta property="og:image:width" content="<%= sharing_image[:width] %>"><meta property="og:image:height" content="<%= sharing_image[:height] %>"><meta property="og:image:alt" content="<%= sharing_image[:alt] %>">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= seo_title %>"><meta name="twitter:description" content="<%= @description %>"><meta name="twitter:image" content="<%= sharing_image[:url] %>">
<% end %>
<% if (schema=structured_data) %><script type="application/ld+json" nonce="<%= content_security_policy_nonce %>"><%= raw json_escape(schema.to_json) %></script><% end %>
<%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag 'application', 'experience', 'slovenia', 'vector_identity' %><%= javascript_include_tag 'application','planners',defer:true %><% if @section=='home' %><% city_image=WebImageCatalog.find(CityCatalog.default.dig('photo','local_path')) %><% if city_image %><link rel="preload" as="image" type="image/avif" imagesrcset="<%= city_image['avif_srcset'] %>" imagesizes="<%= WebImageCatalog::CITY_SIZES %>" fetchpriority="high"><% end %><%= stylesheet_link_tag 'city_card' %><%= javascript_include_tag 'city_card',defer:true %><% end %>
<% if @section=='home' -%><% home_city=CityCatalog.default; home_image=WebImageCatalog.find(home_city.dig('photo','local_path')) %><% if home_image %><link rel="preload" as="image" type="image/avif" imagesrcset="<%= home_image.fetch('avif_srcset') %>" imagesizes="<%= WebImageCatalog::CITY_SIZES %>" fetchpriority="high"><% end %><% end -%>
<% if page_path == '/druzinski-planer/' %><%= stylesheet_link_tag 'family_planner' %><%= javascript_include_tag 'family_planner_core', 'family_planner', defer:true %><% end %>
<% if @section=='sun' -%><%= stylesheet_link_tag 'sun' %><%= javascript_include_tag 'sun',defer:true %><% end -%>
<% if page_path.start_with?('/lunin-koledar/') -%><link rel="stylesheet" href="/lunar/calendar.css?v=20261021-2"><% end -%>
<% if page_path == '/datumski-kalkulator/' %><%= stylesheet_link_tag 'date_calculator' %><% end %>
<% if page_path == '/nacrtovalnik-dopusta/' %><%= stylesheet_link_tag 'vacation' %><%= javascript_include_tag 'vacation',defer:true %><% end %>
<% if page_path == '/odstevanje/' %><%= stylesheet_link_tag 'countdown' %><%= javascript_include_tag 'countdown',defer:true %><% end %>
<% if @section=='horoscope' %><%= stylesheet_link_tag 'horoscope' %><script type="module" src="/horoscope/experience-v1.mjs"></script><% end %>
<% if page_path == '/ustvari-koledar/' %><link rel="stylesheet" href="/studio/studio.css?v=20261020-1"><script type="module" src="/studio/studio.mjs?v=20261020-1"></script><% end %>
<% if @section=='holidays' %><%= stylesheet_link_tag 'holidays' %><%= javascript_include_tag 'holidays',defer:true %><% end %>
<% if page_path=='/delovni-dnevi/' && (2027..2030).cover?(@year) %><%= stylesheet_link_tag 'workdays' %><%= javascript_include_tag 'workdays',defer:true %><% end %>
<% if @section=='observance' %><%= stylesheet_link_tag 'observances' %><% end %>
<% if gallery_page? %><%= stylesheet_link_tag 'calendar_gallery' %><% end %>
<% if page_path == '/razpored-izmen/' %><%= stylesheet_link_tag 'shift_schedule' %><%= javascript_include_tag 'shift_schedule',defer:true %><% end %>
<% if @section=='school' %><link rel="stylesheet" href="/school/experience.css?v=20261020-3"><script type="module" src="/school/experience.mjs?v=20261020-3"></script><% end %>
<%= stylesheet_link_tag 'print' %>
<link rel="icon" href="/visuals/brand-calendar-v3.svg" type="image/svg+xml">
</head>
<body class="<%= [gallery_page? ? 'gallery-page' : nil, @section=='holidays' ? 'holiday-guide' : nil, @section=='home' ? 'home-page' : nil, page_path=='/druzinski-planer/' ? 'family-planner-page' : nil, page_path=='/razpored-izmen/' ? 'shift-page' : nil].compact.join(' ') %>">
<a class="skip" href="#vsebina">Na vsebino</a>
<header class="topbar"><a class="brand" href="/" aria-label="Koledar365 – domov"><span class="brand-symbol"><%= brand_symbol %></span> Koledar<span>365</span></a>
<nav aria-label="Glavna navigacija"><a href="/koledar/">Koledar</a><a href="/prazniki/">Prazniki</a><a href="/solske-pocitnice/">Šolske počitnice</a><a href="/koledar-z-imenom/">Imena</a></nav>
<form action="/isci/" class="search" role="search"><label class="sr-only" for="search">Poišči datum, ime ali orodje</label><input id="search" name="q" type="search" placeholder="Poišči datum, ime ali orodje" value="<%= @q %>"><button aria-label="Išči"><%= ui_icon('search') %></button></form>
<span class="country"><%= slovenia_flag %> Slovenija</span></header>
<nav class="subnav" aria-label="Koledarji in orodja"><div class="subnav-track"><% (2027..2030).each do |year| %><a href="/koledar/<%= year %>/"><%= ui_icon('calendar') %> <%= year %></a><% end %><a href="/lunin-koledar/"><%= ui_icon('moon') %> Sonce in Luna</a><a href="/delovni-dnevi/"><%= ui_icon('note') %> Delovni dnevi</a><a href="/koledar-za-tiskanje/"><%= ui_icon('print') %> Koledarji PDF</a><a href="/datumski-kalkulator/"><%= ui_icon('calculator') %> Datumski kalkulator</a><a href="/horoskop/"><%= horoscope_icon %> Dnevni horoskop</a><a href="/orodja/"><%= ui_icon('grid') %> Vsa orodja</a></div></nav>
<main id="vsebina" tabindex="-1">
<% unless breadcrumbs.empty? %><nav class="breadcrumb" aria-label="Drobtinice"><% breadcrumbs.each_with_index do |(label,path),i| %><% if i>0 %><span aria-hidden="true">›</span><% end %><% if i==breadcrumbs.size-1 %><span aria-current="page"><%= label %></span><% else %><a href="<%= path %>"><%= label %></a><% end %><% end %></nav><% end %>
<% if flash[:notice] %><p class="notice" role="status"><%= flash[:notice] %></p><% end %><% if flash[:alert] %><p class="error" role="alert"><%= flash[:alert] %></p><% end %>
<%= yield %>
</main>
<footer><a class="brand small" href="/"><span class="brand-symbol"><%= brand_symbol %></span> Koledar<span>365</span></a><a href="/o-nas/">O nas</a><a href="/zasebnost/">Zasebnost</a><a href="/viri-in-metodologija/">Viri in metodologija</a><a href="/kontakt/">Kontakt</a><a href="/fotografije-in-licence/">Fotografije in licence</a><a href="/pogoji-uporabe/">Pogoji uporabe</a><button class="text-button" data-cookie-open>Nastavitve piškotkov</button><span>© <%= Time.zone.today.year %> Koledar365</span></footer>
<%= render 'layouts/cookies' %>
</body></html>
