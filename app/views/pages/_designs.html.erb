<section class="design-section" id="design-gallery" aria-labelledby="design-gallery-title" data-export-options="<%= export_options(type).to_json %>">
  <header class="section-heading"><div><span class="eyebrow">ZBIRKA ZA TISKANJE</span><h2 id="design-gallery-title">15 predlog za vaš koledar</h2></div><span class="gallery-format-label">PDF + WebP · 600 ppi</span></header>
  <div class="filters design-settings"><label>Papir<select class="export-paper"><option>A4</option><option>A3</option><option>A5</option></select></label><label>Usmerjenost<select class="export-orientation"><option value="portrait">Pokončno</option><option value="landscape">Ležeče</option></select></label></div>
  <div class="design-grid"><% PrintCatalog.designs.each_with_index do |d,index| %><article class="design-card">
    <img src="/predogled/<%= @year==2026 ? 2027:@year %>/<%= d['id'] %>/<%= @person&.slug||'koledar' %>.png?<%= {type:type,month:@month||1}.to_query %>" data-preview-design="<%= d['id'] %>" alt="<%= @person ? "Ime: #{@person.exact}. " : '' %><%= PrintCatalog::TYPES.fetch(type) %> <%= (@year||2027).clamp(2027,2030) %> – <%= d['name_sl'] %>" width="354" height="500" loading="lazy">
    <div><h3><span class="design-number"><%= '%02d' % (index+1) %></span><%= d['name_sl'] %></h3><p><%= d['color_mode']=='monochrome_bw' ? 'Črno-bela predloga':'Barvna predloga' %> · podpis Koledar365</p>
      <div class="actions"><button class="preview-personal" type="button" data-personal-preview="<%= d['id'] %>">Moj predogled <span aria-hidden="true">↗</span></button><button data-export="<%= d['id'] %>" data-format="pdf"><%= ui_icon('download') %> PDF</button><button data-export="<%= d['id'] %>" data-format="webp"><%= ui_icon('download') %> WebP</button></div>
      <p class="export-status" role="status"></p>
    </div></article><% end %></div>
</section>
