<% if @section=='home' %>
<div class="intro"><div><h1>Slovenski koledar za vaše načrte.</h1><p>Prazniki, osebni dogodki in orodja za vsak dan.</p></div><a class="button subtle" href="/ustvari-koledar/"><%= ui_icon('settings') %> Ustvari svoj koledar</a></div>
<%= render 'home' %>
<% elsif @section=='tool' && page_path=='/nacrtovalnik-dopusta/' %>
<%= render 'vacation_planner' %>
<% elsif @section=='tool' && page_path=='/odstevanje/' %>
<%= render 'countdown' %>
<% elsif %w[about terms privacy cookie_policy holidays observance school calendar_studio horoscope methodology garden_calendar payment_calendar education_calendar school_timetable moon_phases astronomy_events].include?(@section) %>
<%= render @section %>
<% else %>
