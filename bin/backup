#!/bin/sh
set -eu
umask 077
: "${AGE_RECIPIENT:?Set the age public recipient for encrypted backups}"
command -v age >/dev/null || { echo 'Install age from the official package repository.' >&2; exit 1; }
backup_dir=${BACKUP_DIR:-./backups}
mkdir -p "$backup_dir"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
compose_env=${COMPOSE_ENV_FILE:-.env.production}
docker compose --env-file "$compose_env" exec -T db pg_dump -U koledar -d koledar365 -Fc > "$work/database.dump"
docker compose --env-file "$compose_env" exec -T web tar -C /rails -czf - storage > "$work/storage.tar.gz"
printf '%s\n' "created_utc=$stamp" "git_commit=$(git rev-parse HEAD)" > "$work/manifest.txt"
tar -C "$work" -cf - . | age -r "$AGE_RECIPIENT" -o "$backup_dir/koledar365-$stamp.tar.age"
echo "Encrypted backup: $backup_dir/koledar365-$stamp.tar.age"
