<svg class="holiday-illustration" viewBox="0 0 600 380" width="600" height="380" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="holiday-paper" x2="1" y2="1"><stop stop-color="#fffef8"/><stop offset="1" stop-color="#e8e0cd"/></linearGradient>
    <linearGradient id="holiday-denim" x2="1" y2="1"><stop stop-color="#44769a"/><stop offset="1" stop-color="#1e3e5f"/></linearGradient>
    <linearGradient id="holiday-pin" x2="1" y2="1"><stop stop-color="#eeab9e"/><stop offset=".52" stop-color="#c54c61"/><stop offset="1" stop-color="#8f3343"/></linearGradient>
    <linearGradient id="holiday-satin" x2="1" y2="0"><stop stop-color="#142c42" stop-opacity=".21"/><stop offset=".35" stop-color="#fff" stop-opacity=".38"/><stop offset=".67" stop-color="#233950" stop-opacity=".2"/><stop offset="1" stop-color="#fff" stop-opacity=".21"/></linearGradient>
    <filter id="holiday-paper-shadow" x="-.3" y="-.3" width="1.7" height="1.8"><feDropShadow dx="3" dy="13" stdDeviation="10" flood-color="#243755" flood-opacity=".23"/></filter>
    <pattern id="holiday-fabric-grain" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 .5h5M.5 0v5" stroke="#fff" stroke-width=".35" opacity=".35"/></pattern>
  </defs>
  <ellipse cx="295" cy="329" rx="210" ry="24" fill="#8ba7ab" opacity=".2"/>
  <g transform="rotate(-10 273 184)" filter="url(#holiday-paper-shadow)">
    <rect x="88" y="56" width="372" height="247" rx="12" fill="url(#holiday-denim)" stroke="#36536a"/>
    <rect x="88" y="56" width="372" height="247" rx="12" fill="url(#holiday-fabric-grain)"/>
    <rect x="101" y="68" width="347" height="222" rx="7" fill="none" stroke="#d9e6ed" stroke-opacity=".7" stroke-dasharray="2 4"/>
    <rect x="126" y="45" width="295" height="255" rx="6" fill="#ae9f85"/>
    <rect x="121" y="39" width="295" height="255" rx="6" fill="url(#holiday-paper)" stroke="#c9bb9e"/>
    <path d="M143 138h251" stroke="#b19b78"/>
    <text x="143" y="88" fill="#284858" font-family="system-ui,sans-serif" font-size="23" font-weight="770"><%= directory ? 'Prazniki v Sloveniji' : "Prazniki #{@year}" %></text>
    <text x="143" y="114" fill="#625541" font-family="system-ui,sans-serif" font-size="13"><%= directory ? 'Dela prosti prazniki med tednom' : "#{@holidays.free_dates.size} dela prostih datumov" %></text>
    <% if directory %>
      <% @holiday_comparison.each_with_index do |period, index| %>
        <% y = 166 + index * 30 %>
        <text x="143" y="<%= y %>" fill="#315471" font-family="system-ui,sans-serif" font-size="14" font-weight="700"><%= period.year %></text>
        <rect x="190" y="<%= y - 10 %>" width="<%= period.weekday_free_dates.size * 12 %>" height="10" rx="5" fill="#306381" opacity=".84"/>
        <text x="382" y="<%= y %>" text-anchor="end" fill="#754943" font-family="system-ui,sans-serif" font-size="14" font-weight="750"><%= period.weekday_free_dates.size %></text>
      <% end %>
    <% else %>
      <% counts = @holidays.free_dates.group_by(&:month).transform_values(&:size) %>
      <% (1..12).each do |month| %>
        <% row, col = (month - 1).divmod(4); x = 143 + col * 63; y = 153 + row * 39 %>
        <rect x="<%= x %>" y="<%= y %>" width="56" height="30" rx="4" fill="#fff" fill-opacity=".62" stroke="#d4c8ad"/>
        <text x="<%= x + 6 %>" y="<%= y + 19 %>" fill="#625541" font-family="system-ui,sans-serif" font-size="9"><%= CalendarEngine::MONTHS[month - 1][0, 3] %></text>
        <text x="<%= x + 48 %>" y="<%= y + 20 %>" text-anchor="end" fill="#934b4c" font-family="system-ui,sans-serif" font-size="14" font-weight="750"><%= counts.fetch(month, 0) %></text>
      <% end %>
    <% end %>
  </g>
  <g transform="rotate(15 441 229)" filter="url(#holiday-paper-shadow)">
    <path d="M416 151q24-9 53 0v165l-26-18-27 19Z" fill="#fdfcf5" stroke="#859faf"/>
    <path d="M416 195q24-9 53 0v50q-29-9-53 0Z" fill="#145c9c"/>
    <path d="M416 245q24-9 53 0v71l-26-18-27 19Z" fill="#b64150"/>
    <path d="M416 151q24-9 53 0v165l-26-18-27 19Z" fill="url(#holiday-satin)"/>
    <path d="M421 161v145m43-145v145" stroke="#fff" opacity=".7" stroke-width="1" stroke-dasharray="2 3"/>
    <circle cx="443" cy="157" r="12" fill="url(#holiday-pin)" stroke="#9b5356"/>
    <path d="M435 153q4-6 10-5" stroke="#ffddd0" stroke-width="2" stroke-linecap="round" fill="none"/>
  </g>
</svg>
