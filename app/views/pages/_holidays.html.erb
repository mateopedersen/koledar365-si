<% check_date=@today.year==@year ? @today : Date.new(@year,1,1) %>
<% check_event=@holidays.events.find { |event| event.on==check_date } %>
<div class="holiday-page" data-holiday-year="<%= @year %>">
  <section class="holiday-hero" aria-labelledby="holiday-title">
    <div class="holiday-intro">
      <span class="eyebrow"><span class="holiday-slovenia-mark" aria-hidden="true"></span> SLOVENIJA · VAŠ KOLEDAR PROSTIH DNI</span>
      <h1 id="holiday-title">Prazniki <span><%= @year %>.</span></h1>
      <p class="holiday-hero-tagline">Več prostega časa.<br>Več lepih načrtov.</p>
      <p>Vsi <strong>prazniki in dela prosti dnevi</strong> na enem mestu. Preverite datume, poiščite daljši oddih in načrtujte leto po svoje.</p>
      <nav class="holiday-years" aria-label="Leto praznikov"><% CalendarEngine::YEARS.each do |year| %><a href="/prazniki/<%= year %>/" <%= 'aria-current=page' if year==@year %>><%= year %></a><% end %></nav>
      <div class="holiday-hero-actions"><a class="holiday-primary" href="#prazniki-seznam"><%= ui_icon('calendar') %> Pregled praznikov <%= ui_icon('chevron-right') %></a><a href="#holiday-downloads"><%= ui_icon('download') %> PDF in WebP</a></div>
    </div>
    <div class="holiday-visual"><%= render 'holiday_illustration' %><span class="holiday-visual-caption"><%= ui_icon('pin') %> Slovenski koledar. Vaši načrti.</span></div>
  </section>

  <dl class="holiday-facts" aria-label="Povzetek leta">
    <div class="holiday-fact-free"><dt><span class="holiday-fact-icon"><%= ui_icon('calendar') %></span>Dela prostih datumov</dt><dd><strong><%= @holidays.free_dates.size %></strong><span>v letu <%= @year %></span></dd></div>
    <div class="holiday-fact-week"><dt><span class="holiday-fact-icon"><%= ui_icon('sun') %></span>Prostih med tednom</dt><dd><strong><%= @holidays.weekday_free_dates.size %></strong><span>ponedeljek–petek</span></dd></div>
    <div class="holiday-fact-weekend"><dt><span class="holiday-fact-icon"><%= ui_icon('clock') %></span>Praznikov ob koncu tedna</dt><dd><strong><%= @holidays.weekend_free_dates.size %></strong><span>sobota ali nedelja</span></dd></div>
    <div class="holiday-fact-work"><dt><span class="holiday-fact-icon"><%= ui_icon('briefcase') %></span>Delovnih dni</dt><dd><strong><%= @holidays.working_days %></strong><a href="/delovni-dnevi/<%= @year %>/">Poglejte izračun ↗</a></dd></div>
  </dl>

  <section class="holiday-date-tool" aria-labelledby="holiday-check-title">
    <div class="holiday-check-intro"><span class="holiday-check-icon"><%= ui_icon('check') %></span><div><h2 id="holiday-check-title">Je ta dan prost?</h2><p>Hiter odgovor za izbrani datum.</p></div></div>
    <div class="holiday-check-field"><label for="holiday-check-date">Izberite datum v letu <%= @year %></label><input id="holiday-check-date" type="date" min="<%= @year %>-01-01" max="<%= @year %>-12-31" value="<%= check_date %>" aria-describedby="holiday-check-schedule"><noscript><p>Za drug datum uporabite pregled praznikov spodaj.</p></noscript></div>
    <output class="holiday-check-result" id="holiday-check-result" for="holiday-check-date" aria-live="polite" data-status="<%= check_event&.work_free ? 'free' : check_date.cwday>=6 ? 'weekend' : 'working' %>"><strong id="holiday-check-status"><%= check_event&.work_free ? 'Dela prost dan' : check_date.cwday>=6 ? 'Konec tedna' : 'Običajen delovni dan' %></strong><span id="holiday-check-description"><%= check_event ? holiday_title(check_event) : I18n.l(check_date) %></span></output>
    <p class="holiday-check-schedule" id="holiday-check-schedule">Velja za običajni delovnik ponedeljek–petek; vaš osebni razpored se lahko razlikuje.</p>
  </section>

  <nav class="holiday-section-nav" aria-label="Na tej strani"><a href="#prazniki-seznam"><%= ui_icon('note') %> Seznam praznikov</a><a href="#holiday-overview-title"><%= ui_icon('grid') %> Letni pregled</a><a href="#holiday-breaks"><%= ui_icon('sun') %> Podaljšani vikendi</a><a href="#holiday-downloads"><%= ui_icon('print') %> Za tiskanje</a></nav>

  <div class="holiday-workspace">
    <section class="holiday-agenda" id="prazniki-seznam" aria-labelledby="holiday-list-title">
      <div class="holiday-section-heading"><div><span class="eyebrow">DATUMI, KI JIH JE DOBRO POZNATI</span><h2 id="holiday-list-title">Vaši prazniki <strong><%= @year %>.</strong></h2><p>Jasno označeno, kdaj praznujemo in kdaj smo prosti.</p></div><span class="holiday-total"><strong><%= @holidays.events.size %></strong> datumov</span></div>
      <form class="holiday-filters" id="holiday-filters" method="get" action="/prazniki/<%= @year %>/">
        <fieldset><legend class="sr-only">Vrsta praznika</legend>
<% [['all','Vsi prazniki',@holidays.events.size],['free','Dela prosti',@holidays.free_dates.size],['working','Niso dela prosti',@holidays.events.count { |e| !e.work_free }]].each do |value,label,count| %>
            <label class="holiday-filter-chip"><input type="radio" name="kind" value="<%= value %>" <%= 'checked' if @holiday_kind==value %>><span><%= label %> <b><%= count %></b></span></label>
<% end %>
        </fieldset>
        <div class="holiday-filter-fields"><label><span class="sr-only">Poišči praznik</span><%= ui_icon('search') %><input name="q" type="search" value="<%= @holiday_query %>" maxlength="100" placeholder="Ime praznika ali dan v tednu …"></label><label><span class="sr-only">Mesec praznikov</span><select name="month"><option value="0">Vsi meseci</option><% CalendarEngine::MONTHS.each_with_index do |month,index| %><option value="<%= index+1 %>" <%= 'selected' if @holiday_month==index+1 %>><%= month.sub(/\A./,&:upcase) %></option><% end %></select></label><button type="submit">Pokaži</button></div>
      </form>
      <nav class="holiday-month-rail" aria-label="Hitra izbira meseca"><a href="/prazniki/<%= @year %>/#prazniki-seznam" data-select-holiday-month="0">Vse leto</a><% CalendarEngine::MONTHS.each_with_index do |month,index| %><a href="/prazniki/<%= @year %>/?month=<%= index+1 %>#prazniki-seznam" data-select-holiday-month="<%= index+1 %>" aria-label="<%= month %>"><%= month.first(3).sub(/\A./,&:upcase) %></a><% end %></nav>
      <div class="holiday-results-bar"><p id="holiday-result-count" role="status" aria-live="polite">Prikazani datumi: <strong id="holiday-shown-count"><%= @filtered_holidays.size %></strong> od <%= @holidays.events.size %></p><a id="holiday-reset" href="/prazniki/<%= @year %>/">Počisti filtre</a></div>
      <div id="holiday-empty" class="holiday-empty" <%= 'hidden' if @filtered_holidays.any? %>><%= ui_icon('search') %><h3>Za to izbiro ni praznikov.</h3><p>Poskusite drug mesec ali krajše ime praznika.</p></div>
      <div class="holiday-months">
<% @holidays.events.group_by { |event| event.on.month }.each do |month,events| %>
          <section class="holiday-month" data-holiday-month="<%= month %>" <%= 'hidden' unless events.any? { |event| @filtered_holidays.include?(event) } %>>
            <h3><span><%= month.to_s.rjust(2,'0') %></span><%= CalendarEngine::MONTHS[month-1].sub(/\A./,&:upcase) %><small><%= holiday_date_count(events.size) %></small></h3>
            <ol><% events.each do |event| %>
              <li class="holiday-row <%= event.work_free ? 'is-free' : 'is-working' %>" data-holiday-row data-date="<%= event.on %>" data-month="<%= month %>" data-free="<%= event.work_free %>" data-search="<%= HolidayYear.query("#{event.title} #{CalendarEngine::DAYS[event.on.cwday-1]}") %>" <%= 'hidden' unless @filtered_holidays.include?(event) %>>
                <time class="holiday-date" datetime="<%= event.on %>"><strong><%= event.on.day %></strong><span><%= CalendarEngine::SHORT_DAYS[event.on.cwday-1] %></span></time>
                <div class="holiday-row-copy"><a class="holiday-name" href="<%= event_path(event) %>"><%= holiday_title(event) %></a><span class="holiday-weekday"><strong><%= CalendarEngine::DAYS[event.on.cwday-1].sub(/\A./,&:upcase) %></strong><span aria-hidden="true"> · </span><%= holiday_origin(event) %></span></div>
                <div class="holiday-row-actions"><span class="holiday-badge"><span aria-hidden="true"></span><%= holiday_status(event) %></span><a href="/prazniki/<%= @year %>.ics?event=<%= event.key %>" class="holiday-add" aria-label="Dodaj v koledar: <%= event.title %>, <%= I18n.l(event.on) %>" title="Prenesi dogodek ICS"><%= ui_icon('plus') %></a></div>
              </li>
<% end %></ol>
          </section>
<% end %>
      </div>
      <div class="holiday-list-actions"><a class="button primary" id="holiday-ics" href="<%= holiday_ics_url(@year,month:@holiday_month,kind:@holiday_kind,query:@holiday_query) %>"><%= ui_icon('download') %> Dodaj prikazane datume v koledar</a><button type="button" data-print><%= ui_icon('print') %> Natisni</button><button type="button" id="holiday-share"><%= ui_icon('upload') %> Kopiraj povezavo</button></div>
      <p class="holiday-caption">Datoteko <strong>ICS</strong> uvozite v Apple Calendar, Google Koledar ali Outlook. Gumb <strong>+</strong> doda samo izbrani praznik. Datumi so celodnevni.</p><p class="holiday-share-status" id="holiday-share-status" role="status" aria-live="polite"></p>
    </section>

    <aside class="holiday-aside" aria-label="Načrtovanje prostih dni">
      <section class="holiday-breaks" id="holiday-breaks"><span class="eyebrow">MALO DOPUSTA, VEČ ODDIHA</span><h2>Izkoristite<br><strong>daljši vikend.</strong></h2><p>Načrt za delovnik ponedeljek–petek, z največ <strong>1 dnem dopusta.</strong></p>
<% @holiday_breaks.each_with_index do |option,index| %><article class="<%= 'is-best' if index.zero? %>"><% if index.zero? %><span class="holiday-break-label"><%= ui_icon('sun') %> Najdaljši predlog</span><% end %><div class="holiday-break-count"><strong><%= option[:total] %></strong><span><%= holiday_break_label(option[:total]) %></span></div><time><%= I18n.l(option[:from],format:'%d. %m.') %> – <%= I18n.l(option[:to],format:'%d. %m. %Y') %></time><p><% if option[:leave].zero? %><b>Brez dodatnega dopusta.</b><% else %><b><%= option[:leave] %> dan dopusta:</b> <%= option[:leave_dates].map { |date| I18n.l(date) }.join(', ') %>.<% end %></p></article><% end %>
        <a class="holiday-more-link" href="/podaljsani-vikendi/<%= @year %>/">Več možnosti za oddih <%= ui_icon('chevron-right') %></a>
      </section>
      <section class="holiday-note"><span class="holiday-note-icon"><%= ui_icon('info') %></span><h2>Praznik ni vedno <br><strong>prost dan.</strong></h2><p>Državni praznik je lahko običajen delovni dan. Tudi vsi dela prosti dnevi niso državni prazniki.</p><p>Če praznik pade na <strong>nedeljo, se ne prenese na ponedeljek.</strong></p><a href="#holiday-sources">Preverite pravno podlago →</a></section>
      <a class="holiday-planner-link" href="/nacrtovalnik-dopusta/"><%= ui_icon('briefcase') %><span><strong>Načrtujte svoj dopust.</strong><small>Od datumov do pravega oddiha.</small></span><%= ui_icon('chevron-right') %></a>
    </aside>
  </div>

<%= render 'holiday_year_grid' %>

  <section class="holiday-comparison" aria-labelledby="holiday-compare-title"><div class="holiday-section-heading"><div><span class="eyebrow">POGLEJTE ŠE KORAK NAPREJ</span><h2 id="holiday-compare-title">Katero leto prinese <strong>več prostih dni?</strong></h2><p>Primerjajte, koliko dela prostih praznikov pade med tednom.</p></div></div><div class="holiday-comparison-grid"><% @holiday_comparison.each do |period| %><a href="/prazniki/<%= period.year %>/" <%= 'aria-current=page' if period.year==@year %>><h3><%= period.year %><span aria-hidden="true">↗</span></h3><div class="holiday-comparison-highlight"><strong><%= period.weekday_free_dates.size %></strong><span>prostih praznikov<br>med tednom</span></div><dl><div><dt>Dela prosti datumi</dt><dd><%= period.free_dates.size %></dd></div><div><dt>Delovni dnevi</dt><dd><%= period.working_days %></dd></div></dl></a><% end %></div><p>Izračun velja za ponedeljek–petek. Prazniki na soboto ali nedeljo se ne odštejejo še enkrat. Dopust, bolniška odsotnost in individualni razporedi niso vključeni.</p></section>

  <section class="holiday-downloads" id="holiday-downloads" aria-labelledby="holiday-print-title">
    <div class="page-heading holiday-section-heading"><div><span class="eyebrow">VAŠI PRAZNIKI. TUDI NA PAPIRJU.</span><h2 id="holiday-print-title">Izberite svojo <strong>najljubšo predlogo.</strong></h2><p><%= gallery_description %></p></div></div>
    <div class="download-workspace" data-download-workspace>
      <aside class="panel gallery-context" aria-label="Nastavitve tiskanega koledarja">
        <%= render 'context_heading', title: "Prazniki #{@year} za tiskanje", expand: 'Razširi nastavitve' %>
        <div class="context-content" id="gallery-context-content">
          <nav class="year-links" aria-label="Leto tiskanega koledarja"><% CalendarEngine::YEARS.each do |year| %><a href="/prazniki/<%= year %>/#holiday-downloads" <%= 'aria-current=page' if year==@year %>><%= year %></a><% end %></nav>
          <p><strong>15 različnih postavitev.</strong> Izberite papir in usmerjenost ter si oglejte predogled. PDF je pripravljen za tisk, WebP pa za shranjevanje v polni ločljivosti.</p>
          <p><strong>Namig za tisk:</strong> v tiskalniku izberite merilo 100 %. Datumi in število prostih dni veljajo za izbrano leto.</p>
          <a href="#prazniki-seznam">Nazaj na seznam praznikov ↑</a>
        </div>
      </aside>
      <%= render 'designs',type:'holidays' %>
    </div>
  </section>

  <section class="holiday-culture"><div class="holiday-section-heading"><div><span class="eyebrow">TRADICIJE, KI NAS POVEZUJEJO</span><h2>Slovenija <strong>praznuje.</strong></h2><p>Odkrijte zgodbe za običaji. Ti dnevi sami po sebi niso zakonsko dela prosti.</p></div><a class="holiday-more-link" href="/pomembni-dnevi/<%= @year %>/">Vsi pomembni dnevi <%= ui_icon('chevron-right') %></a></div><div class="holiday-culture-grid"><% %w[pust martinovo miklavz].each do |slug| %><% page=Page.find_by(path:"/prazniki/#{slug}/");photo=HolidayPhotoCatalog.find(slug) %><% if page && photo %><article><a class="holiday-culture-photo" href="<%= page.path %>"><img src="<%= photo.fetch('local_path') %>" alt="<%= photo.fetch('alt_sl') %>" width="<%= photo.fetch('width') %>" height="<%= photo.fetch('height') %>" loading="lazy" decoding="async"></a><div><a class="holiday-culture-title" href="<%= page.path %>"><strong><%= page.title %></strong><%= ui_icon('chevron-right') %></a><a class="holiday-photo-credit" href="/fotografije-in-licence/#praznik-<%= slug %>">Fotografija in licenca</a></div></article><% end %><% end %></div></section>

  <section class="holiday-sources" id="holiday-sources"><%= ui_icon('shield') %><div><h2>Preverjeni datumi. Razložena pravila.</h2><p>Pravna podlaga: <%= source_link(HolidayYear::LAW_URL,'Zakon o praznikih in dela prostih dnevih v Republiki Sloveniji (ZPDPD)') %>, vključno z <%= source_link(HolidayYear::AMENDMENT_URL,'novelo ZPDPD-I, veljavno od 17. oktobra 2026') %>. Upoštevani so dan Triglava ter veljavna poimenovanja praznikov.</p><p>Datumi za prihodnja leta so izračunani po trenutno veljavnem zakonu. Morebitne poznejše zakonske spremembe lahko vplivajo nanje. Velika noč se računa po gregorijanskem koledarju; binkošti so 49 dni pozneje.</p><p>Preverjeno: <time datetime="<%= HolidayYear::CHECKED_ON %>"><%= I18n.l(HolidayYear::CHECKED_ON) %></time> · <a href="/viri-in-metodologija/">Metodologija</a> · <a href="/kontakt/">Sporočite popravek</a> · <a href="/solske-pocitnice/">Šolske počitnice so ločen koledar</a></p></div></section>
</div>
