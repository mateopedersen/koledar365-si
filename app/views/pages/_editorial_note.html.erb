<% if (note = EditorialNote.for(page_path, title: @title, city: @sun_city_id, observance: @observance)) %>
  <% recommendations = note.fetch('links').uniq.reject { |route| route == page_path }.map { |route| editorial_recommendation(route) }
     sources = note.fetch('sources').map do |source|
       label, url = source.is_a?(Array) ? source : EditorialCatalog.sources.fetch(source)
       [url, label, 'Zunanji vir', source == 'sky' ? 'star' : 'note']
     end %>
  <section class="editorial-note editorial-note--recommendations" aria-labelledby="editorial-note-heading">
    <div class="editorial-note__intro">
      <h2 id="editorial-note-heading"><%= note.fetch('title') %></h2>
      <% note.fetch('paragraphs').each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
    <% if recommendations.any? || sources.any? %>
      <ul class="editorial-note__links" role="list">
        <% (recommendations + sources).uniq(&:first).each do |url, label, description, icon| %>
          <% external = !url.start_with?('/') %>
          <li>
            <a class="editorial-note__card <%= 'editorial-note__card--source' if external %>" href="<%= url %>">
              <span class="editorial-note__icon"><%= ui_icon(icon) %></span>
              <span class="editorial-note__label">
                <strong><%= label %></strong>
                <% if description.present? %><small><%= description %></small><% end %>
              </span>
              <span class="editorial-note__direction"><%= ui_icon(external ? 'arrow' : 'chevron-right') %></span>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
