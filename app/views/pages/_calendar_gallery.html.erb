<% period = month ? "koledar za #{CalendarEngine::MONTHS[month - 1]} #{year}" : "letni koledar #{year}" %>
<section class="calendar-gallery" id="calendar-designs" aria-labelledby="calendar-gallery-title" data-calendar-gallery data-gallery-type="<%= month ? 'monthly' : 'annual' %>" data-gallery-year="<%= year %>" data-gallery-month="<%= month %>">
  <header class="calendar-gallery-heading">
    <div><span class="eyebrow">ZBIRKA ZA TISKANJE</span><h2 id="calendar-gallery-title"><%= period.capitalize %>: 15 predlog</h2></div>
    <span class="calendar-gallery-quality"><%= ui_icon('print') %><span><%= rows.first['collection'] == 'calendar-2027-2030' ? 'A3 · 600 dpi' : 'A4 · Pokončno' %><small><%= rows.first['collection'] == 'calendar-2027-2030' ? 'PDF CMYK · WebP sRGB' : 'Podpis Koledar365 na vsaki strani' %></small></span></span>
  </header>
  <div class="calendar-gallery-toolbar" data-gallery-filters>
    <% if rows.first['collection'] == 'calendar-2027-2030' %>
      <span>15 barvnih oblikovanj · PDF in WebP</span>
    <% else %>
      <div class="calendar-gallery-filters" role="group" aria-label="Barve predlog">
        <button type="button" data-gallery-filter="all" aria-pressed="true">Vse predloge</button>
        <button type="button" data-gallery-filter="color" aria-pressed="false">Barvne</button>
        <button type="button" data-gallery-filter="monochrome_bw" aria-pressed="false">Črno-bele</button>
      </div>
    <% end %>
    <span data-gallery-count role="status">15 predlog</span>
  </div>
  <noscript><style>.calendar-gallery-toolbar{display:none!important}</style></noscript>
  <div class="calendar-gallery-grid">
    <% rows.each_with_index do |row, index| %>
      <% design = row.fetch('design').merge('name_sl' => row.dig('collection_seo', 'design_name').presence || row.fetch('design')['name_sl'], 'color_mode' => (row['collection'] == 'calendar-2027-2030' ? 'color' : row.fetch('design')['color_mode'])); files = row.fetch('files'); pages = row.fetch('page_count'); zipped = files.fetch('webp').end_with?('.zip'); image_alt = row.dig('collection_seo', 'alt').presence || "#{period.capitalize} – #{design['name_sl']}, predogled"; preview_width = row['preview_width'] || 212; preview_height = row['preview_height'] || 300 %>
      <article class="calendar-design-card" id="predloga-<%= design['id'] %>" data-calendar-design="<%= design['id'] %>" data-color-mode="<%= design['color_mode'] %>">
        <a class="calendar-design-image" href="<%= files.fetch('pdf') %>" target="_blank" rel="noopener">
          <img src="<%= files.fetch('preview') %>" alt="<%= image_alt %>" title="<%= row.dig('collection_seo', 'title') || design['name_sl'] %>" width="<%= preview_width %>" height="<%= preview_height %>" loading="lazy" decoding="async">
          <span><%= pages == 1 ? '1 stran' : "#{pages} strani" %></span>
        </a>
        <div class="calendar-design-info">
          <h3><span class="design-number" aria-hidden="true"><%= '%02d' % (index + 1) %></span><span class="design-title"><%= design['name_sl'] %></span></h3>
          <p class="calendar-design-meta"><i class="<%= design['color_mode'] == 'monochrome_bw' ? 'mono' : 'color' %>" aria-hidden="true"></i><%= design['color_mode'] == 'monochrome_bw' ? 'Črno-belo' : 'Barvno' %> · <%= row.dig('options', 'paper') || 'A4' %> · <%= row.dig('options', 'orientation') == 'landscape' ? 'Ležeče' : 'Pokončno' %><% if row['collection'] == 'calendar-2027-2030' %> · 600 dpi<% end %></p>
          <a class="button calendar-design-preview" href="<%= files.fetch('pdf') %>" target="_blank" rel="noopener">Odpri predogled <span aria-hidden="true">↗</span></a>
          <div class="calendar-design-downloads">
            <a class="button calendar-download-action calendar-download-action--pdf" href="<%= files.fetch('pdf') %>" download="<%= File.basename(files.fetch('pdf')) %>" data-calendar-download="pdf" aria-label="PDF Prenesi – <%= design['name_sl'] %> – <%= period %>"><%= calendar_file_icon('pdf') %><span class="calendar-download-action__copy"><strong>PDF</strong> <small>Prenesi</small></span></a>
            <a class="button calendar-download-action calendar-download-action--webp" href="<%= files.fetch('webp') %>" download="<%= File.basename(files.fetch('webp')) %>" data-calendar-download="webp" aria-label="<%= zipped ? 'WebP ZIP' : 'WebP' %> Prenesi – <%= design['name_sl'] %> – <%= period %>"><%= calendar_file_icon('webp') %><span class="calendar-download-action__copy"><strong><%= zipped ? 'WebP ZIP' : 'WebP' %></strong> <small>Prenesi</small></span></a>
          </div>
          <small class="calendar-design-note"><%= zipped ? "Vseh #{pages} strani WebP v eni datoteki ZIP." : row['collection'] == 'calendar-2027-2030' ? 'PDF za tisk in WebP celotne strani.' : 'PDF in WebP z enako postavitvijo.' %></small>
        </div>
      </article>
    <% end %>
  </div>

</section>
