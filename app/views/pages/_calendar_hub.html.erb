<% weekly = local_assigns.fetch(:weekly, false)
   period = calendar_hub_period(weekly: weekly)
   selected, year, month = period.values_at(:date, :year, :month)
   monday = selected - selected.cwday + 1
   calendar_data = calendar_experience_data %>
<section class="calendar-experience" id="<%= weekly ? 'tedenski-nacrt' : 'mesecni-nacrt' %>" data-calendar-experience="<%= weekly ? 'weekly' : 'monthly' %>" data-initial-year="<%= year %>" data-initial-month="<%= month %>" data-initial-date="<%= selected %>" aria-labelledby="calendar-workbench-title">
  <script type="application/json" data-calendar-data><%= raw(json_escape(calendar_data.to_json)) %></script>
  <% if weekly %>
    <div class="weekly-controls">
      <%= render 'weekly_controls', calendar_data: calendar_data, selected: selected, year: year %>
    </div>
  <% else %>
    <h2 id="calendar-workbench-title">Načrtujte izbrani mesec</h2>
    <div class="calendar-experience__period">
      <nav class="calendar-experience__years" aria-label="Izberite leto">
        <% calendar_data[:years].each do |value| %>
          <a href="/mesecni-koledar/?year=<%= value %>&amp;month=<%= month %>" data-calendar-year="<%= value %>" <%= 'aria-current=true' if value == year %>><%= value %></a>
        <% end %>
      </nav>
      <button type="button" class="calendar-experience__today" data-calendar-today><span aria-hidden="true"><%= ui_icon('chevron-right') %></span> Ta mesec</button>
    </div>
  <% end %>
  <div class="calendar-experience__workspace">
    <% unless weekly %>
      <aside class="calendar-experience__sidebar">
        <div class="calendar-experience__month-selector"><span class="calendar-experience__step">01 / IZBERITE MESEC</span><nav class="calendar-experience__months" aria-label="Meseci izbranega leta"><% CalendarEngine::MONTHS.each_with_index do |name,index|;d=Date.new(year,index+1,1) %><a href="<%= calendar_path(d) %>" data-calendar-month="<%= index+1 %>" <%= 'aria-current=true' if index+1==month %>><span><%= '%02d' % (index+1) %></span><strong><%= name.capitalize %></strong><small data-month-days="<%= index+1 %>"><%= Date.new(year,index+1,-1).day %> dni</small><b aria-hidden="true"><%= ui_icon('chevron-right') %></b></a><% end %></nav></div>
        <%= render 'calendar_paper_options', weekly: false %>
      </aside>
    <% end %>
    <div class="calendar-experience__main">
      <div class="calendar-experience__preview-bar">
        <% if weekly %>
          <a class="weekly-preview__print" href="#tedenski-pdf"><%= ui_icon('print') %> Pripravi PDF</a>
        <% else %>
          <span><i aria-hidden="true"></i> VAŠ KOLEDAR</span>
        <% end %>
        <div role="group" aria-label="<%= weekly ? 'Prikaz tedna' : 'Prikaz meseca' %>">
          <button type="button" data-calendar-back aria-controls="calendar-period-preview" aria-label="<%= weekly ? 'Prejšnji teden' : 'Prejšnji mesec' %>"><%= ui_icon('chevron-right') %></button>
          <button type="button" data-calendar-next aria-controls="calendar-period-preview" aria-label="<%= weekly ? 'Naslednji teden' : 'Naslednji mesec' %>"><%= ui_icon('chevron-right') %></button>
        </div>
      </div>
      <section class="calendar-sheet <%= 'calendar-sheet--week' if weekly %>" id="calendar-period-preview" data-calendar-sheet aria-label="Predogled izbranega koledarja">
        <header><div><span class="calendar-sheet__kicker" data-calendar-kicker><%= weekly ? "TEDEN #{selected.cweek} / #{selected.cwyear}" : 'MESEČNI KOLEDAR' %></span><h3 data-calendar-heading aria-live="polite"><%= weekly ? "#{monday.strftime('%-d. %-m. %Y')} – #{(monday + 6).strftime('%-d. %-m. %Y')}" : "#{CalendarEngine::MONTHS[month-1].capitalize} #{year}" %></h3></div><span class="calendar-sheet__brand">Koledar<span>365</span></span></header>
        <% if weekly %>
          <%= render 'weekly_days', monday: monday, calendar_data: calendar_data %>
        <% else %>
          <div data-calendar-grid>
            <%= calendar_month(year, month, mini: true) %>
            <% holidays = calendar_data[:holidays].select { |event| event[:date].start_with?(format('%04d-%02d-', year, month)) } %>
            <% if holidays.any? %>
              <ul class="calendar-sheet__holidays" aria-label="Dela prosti dnevi v mesecu">
                <% holidays.each do |holiday| %>
                  <% date = Date.iso8601(holiday[:date]) %>
                  <li><time datetime="<%= date %>"><%= date.day %>. <%= date.month %>.</time> <span><%= holiday[:title] %></span></li>
                <% end %>
              </ul>
            <% end %>
          </div>
          <div class="calendar-sheet__notes"><label for="calendar-period-notes">Mesečni cilji in zapiski</label><textarea id="calendar-period-notes" maxlength="2000" rows="2" placeholder="Kaj želite v tem mesecu narediti?" data-period-notes></textarea></div>
        <% end %>
        <footer><span><i></i> Dela prost dan</span><span>Ponedeljek–nedelja · Slovenija</span></footer>
      </section>
      <div<% if weekly %> class="weekly-print" id="tedenski-pdf"<% end %>>
        <% if weekly %>
          <h3>Pripravite tedenski planer za tisk</h3>
          <%= render 'calendar_paper_options', weekly: true %>
        <% end %>
        <fieldset class="calendar-layouts">
          <legend>Izberite postavitev PDF</legend>
          <% [['grid', 'min-01', weekly ? 'Skupni tedenski pregled' : 'Mesečna mreža'],
              ['notes', 'min-03', 'Več prostora za zapiske'],
              ['list', 'min-02', weekly ? 'Dan za dnem' : 'Dnevni seznam']].each_with_index do |(layout, design, label), index| %>
            <label>
              <input type="radio" name="calendar-layout" value="<%= design %>" data-calendar-layout <%= 'checked' if index == (weekly ? 2 : 0) %>>
              <%= calendar_layout_preview(layout) %><span><%= label %></span>
            </label>
          <% end %>
        </fieldset>
        <div class="calendar-experience__downloads">
          <div>
            <% unless weekly %><span class="calendar-experience__step">03 / SHRANITE SVOJ KOLEDAR</span><% end %>
            <p data-calendar-save-copy>Vaši zapiski ostanejo v tem brskalniku in se vključijo v izvoz.</p>
          </div>
          <div class="calendar-experience__download-actions">
            <button type="button" class="primary" data-calendar-pdf><%= ui_icon('download') %> Prenesi PDF</button>
            <% unless weekly %><button type="button" data-calendar-xlsx>Excel .xlsx</button><% end %>
            <a href="<%= calendar_print_path(year: selected.year, month: month, date: selected, type: weekly ? 'weekly' : 'monthly') %>" data-calendar-all-designs>Vseh 15 predlog</a>
          </div>
          <output data-calendar-status role="status" aria-live="polite"></output>
        </div>
      </div>
      <div class="calendar-experience__related"><a href="<%= weekly ? '/stevilka-tedna/' : calendar_path(Date.new(year,month,1)) %>" data-calendar-detail><%= weekly ? 'Kako določimo številko tedna?' : 'Odpri podroben mesečni koledar' %> <span aria-hidden="true"><%= ui_icon('arrow') %></span></a><a href="<%= weekly ? '/mesecni-koledar/' : '/tedenski-koledar/' %>"><%= weekly ? 'Mesečni koledar' : 'Tedenski planer' %> <span aria-hidden="true"><%= ui_icon('arrow') %></span></a></div>
    </div>
  </div>
  <% if weekly %>
    <p class="calendar-experience__source">Dela proste dni označujemo po zakonu ZPDPD. Prihodnji datumi sledijo veljavnim pravilom. <a href="/viri-in-metodologija/">Viri in metodologija</a></p>
  <% else %>
    <p class="calendar-experience__source">Dela prosti dnevi sledijo <a href="https://pisrs.si/pregledPredpisa?id=ZAKO865" rel="noopener" target="_blank">veljavnemu zakonu ZPDPD</a>. Preverjeno 21. 10. 2026. Prihodnja leta se lahko spremenijo ob spremembi predpisa. <a href="/viri-in-metodologija/">Viri in metodologija</a></p>
  <% end %>
  <noscript><p class="panel"><%= weekly ? 'Za izbiro tedna, shranjevanje zapiskov in izvoz PDF omogočite JavaScript. Odprete lahko tudi ' : 'Izberite mesec s povezavo ali odprite ' %><a href="<%= calendar_print_path(year:selected.year,month:month,date:selected,type:weekly ? 'weekly' : 'monthly') %>">koledar za tiskanje</a>.<% unless weekly %> Za sprotni predogled, shranjevanje zapiskov in izvoz Excel omogočite JavaScript.<% end %></p></noscript>
</section>
