<% period=Date.new(@year,@month,1);prev=period.prev_month;nxt=period.next_month %><div class="calendar-title"><div class="actions"><% if prev.year>=2026 && !(prev.year==2026&&prev.month<10) %><a class="button square" href="/?year=<%= prev.year %>&month=<%= prev.month %>" aria-label="Prejšnji mesec">‹</a><% end %><h2><%= CalendarEngine::MONTHS[@month-1].capitalize %> <%= @year %></h2><% if nxt.year<=2030 %><a class="button square" href="/?year=<%= nxt.year %>&month=<%= nxt.month %>" aria-label="Naslednji mesec">›</a><% end %><a class="button" href="/">Danes</a></div><a class="button primary" href="<%= page_path=='/' ? '#personal-title' : "/?year=#{@year}&month=#{@month}&date=#{@selected}#personal-title" %>" data-add-event><%= ui_icon('plus') %> Dodaj dogodek</a></div>
<div class="calendar-toolbar"><nav class="tabs" aria-label="Pogled koledarja"><% {'month'=>'Mesec','week'=>'Teden','day'=>'Dan','list'=>'Seznam','year'=>'Leto'}.each do |key,label| %><a class="<%= 'active' if @view==key %>" href="?year=<%= @year %>&month=<%= @month %>&date=<%= @selected %>&view=<%= key %>"><%= label %></a><% end %></nav><form action="/" class="period-form"><label><span class="sr-only">Leto</span><select name="year"><% (2026..2030).each do |y| %><option <%= 'selected' if y==@year %>><%= y %></option><% end %></select></label><label><span class="sr-only">Mesec</span><select name="month"><% CalendarEngine::MONTHS.each_with_index do |m,i| %><option value="<%= i+1 %>" <%= 'selected' if i+1==@month %>><%= m %></option><% end %></select></label><button>Pokaži</button></form></div>
