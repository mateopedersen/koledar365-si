<% image = WebImageCatalog.find(path) %>
<picture><% if image %><source type="image/avif" srcset="<%= image['avif_srcset'] %>" sizes="<%= sizes %>"><% end %><img src="<%= image ? image['src'] : path %>"<% if image %><% if image['srcset'].present? %> srcset="<%= image['srcset'] %>" sizes="<%= sizes %>"<% end %> width="<%= image['width'] %>" height="<%= image['height'] %>"<% end %> alt="<%= alt %>" fetchpriority="high" decoding="async"></picture>
