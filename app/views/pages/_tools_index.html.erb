<article class="tool-workspace tool-directory" data-tools-directory>
  <header class="tool-intro tool-directory-intro">
    <div class="tool-intro__copy">
      <p class="tool-eyebrow"><%= slovenia_flag %> Koledar365</p>
      <h1>Koledarji, planerji in kalkulatorji</h1>
      <p>Poiščite slovenske praznike, načrtujte rok ali izračunajte datum. Vsa orodja lahko uporabljate brez računa.</p>
      <label class="tool-query"><%= ui_icon('search') %><span class="sr-only">Išči med orodji</span><input type="search" data-tool-query placeholder="Poiščite orodje…" autocomplete="off"></label>
    </div>
    <div class="tool-directory-art" aria-hidden="true"><%= page_hero_art('directory') %></div>
  </header>
  <div class="tool-picks">
    <% [['/odstevanje/', 'Naslednji pomemben dan', 'Izberite praznik ali festival', 'pick-next-day'], ['/kalkulator-upokojitve/', 'Kdaj v pokoj?', 'Primerjajte dve poti do starostne pokojnine', 'pick-retirement'], ['/vpisni-koledar/', 'Roki za vpis', 'Srednje in višje strokovne šole', 'pick-admissions']].each do |path, label, description, icon| %>
      <a href="<%= path %>"><%= tool_directory_icon(icon) %><span><strong><%= label %></strong><small><%= description %></small></span></a>
    <% end %>
  </div>
  <div class="tool-index-layout">
    <nav class="tool-category" aria-label="Vrste orodij">
      <a href="#vsa-orodja" aria-current="true" data-tool-category="all"><%= tool_directory_icon('category-all') %><span>Vsa orodja</span></a>
      <% ToolsDirectory::GROUPS.each do |key, (label, icon, _)| %><a href="#<%= key %>" data-tool-category="<%= key %>"><%= tool_directory_icon(icon) %><span><%= label %></span></a><% end %>
    </nav>
    <div id="vsa-orodja">
      <p class="tool-index-count" data-tool-count role="status"><%= ToolsDirectory::GROUPS.values.sum { |_, _, rows| rows.size } %> orodij</p>
      <% ToolsDirectory::GROUPS.each do |key, (label, _, rows)| %>
        <section class="tool-index-group" id="<%= key %>" data-tool-group="<%= key %>">
          <h2><%= label %></h2>
          <div class="tool-index-cards">
            <% rows.each do |path, title, icon, description| %>
              <%= link_to path, data: { tool_card: true, tool_keywords: SlovenianResources::SEARCH_TERMS[path] } do %><%= tool_directory_icon(icon) %><span><strong><%= title %></strong><small><%= description %></small></span><% end %>
            <% end %>
          </div>
        </section>
      <% end %>
      <p class="tool-card-line" data-tool-empty hidden>Ni zadetkov. Poskusite s krajšim izrazom ali izberite drugo vrsto orodja.</p>
    </div>
  </div>
</article>

<details class="tool-block tool-site-index">
  <summary>Kazalo vseh vsebin</summary>
  <% catalog = ExpansionCatalog.pages
     entry_title = ->(page) { catalog.dig(page.path, :title) || page.display_title } %>
  <% directory=Page.published.order(:path).reject { |page| page.path.match?(PagesController::REMOVED_NAME_PATHS) || PublicPagePolicy.redirect(page.path) } %>
  <% directory.group_by { |page| page.path.split('/')[1].to_s }.each do |group,pages| %>
    <% heading=entry_title.call(pages.find { |page| page.path=="/#{group}/" } || pages.first) %>
    <details class="site-directory-group">
      <summary><strong><%= heading %></strong> <span class="muted">· <%= pages.size %></span></summary>
      <nav class="link-grid compact" aria-label="<%= heading %>"><% pages.each do |page| %><a href="<%= page.path %>"><%= entry_title.call(page) %></a><% end %></nav>
    </details>
  <% end %>
</details>
