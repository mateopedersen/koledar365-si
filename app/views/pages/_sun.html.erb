<%
  city_id = @sun_city_id || params[:city].presence || 'ljubljana'
  city_id = 'ljubljana' unless SunEngine.city?(city_id)
  date = (Date.iso8601(params[:date].to_s) rescue @today)
  date = @today unless date.year.between?(1901, 2099)
  sun = SunEngine.calculate(date, city_id)
  city_names = SunEngine::CITIES
  city_catalog = CityCatalog.all.index_by { |city| city.fetch('id') }
%>

<% if page_path == '/soncni-vzhod-in-zahod/' %>
  <section class="sun-masthead" aria-labelledby="sun-title">
    <div class="sun-masthead__copy">
      <span class="sun-kicker"><span aria-hidden="true"></span> SONCE NAD SLOVENIJO</span>
      <h1 id="sun-title">Sončni vzhod in zahod</h1>
      <p>Izberite eno od 69 slovenskih mest, nastavite datum in raziščite pot Sonca od jutranjega svita do večernega mraka.</p>
      <div class="sun-masthead__facts" aria-label="Značilnosti izračuna">
        <span><b>69</b> mest</span><span>lokalni čas <b>Europe/Ljubljana</b></span><span>prosta simulacija</span>
      </div>
    </div>
    <a class="sun-masthead__scroll" href="#izracun"><span aria-hidden="true">↓</span> Izberite mesto in datum</a>
    <div class="sun-masthead__ornament" aria-hidden="true">
      <svg viewBox="0 0 600 220" focusable="false">
        <defs><linearGradient id="masthead-sun" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff4c7"/><stop offset=".55" stop-color="#ff9a66"/><stop offset="1" stop-color="#d82f45"/></linearGradient></defs>
        <path d="M20 197C127 146 203 124 304 125s187 27 276 72" fill="none" stroke="#fff" stroke-opacity=".24" stroke-width="2" stroke-dasharray="4 8"/>
        <path d="M57 194C155 148 221 134 304 135s156 22 241 60" fill="none" stroke="#6da9df" stroke-opacity=".72" stroke-width="1.5"/>
        <circle cx="304" cy="135" r="59" fill="#ec4546" opacity=".12"/><circle cx="304" cy="135" r="42" fill="url(#masthead-sun)"/>
        <path d="M265 145c12-9 28-10 39-2m17-25c9-10 18-13 28-12m-59 48c9-4 17-4 26 1" fill="none" stroke="#fff8db" stroke-width="2" stroke-linecap="round" opacity=".48"/>
        <path d="M25 198h550" stroke="#fff" stroke-opacity=".3"/>
        <circle cx="105" cy="171" r="3" fill="#fff"/><circle cx="478" cy="156" r="3" fill="#e64451"/><circle cx="204" cy="145" r="2" fill="#8dbfea"/>
      </svg>
    </div>
  </section>
<% end %>

<section class="sun-experience" id="izracun" aria-labelledby="sun-experience-title"
  data-sun-experience
  data-latitude="<%= sun[:latitude] %>"
  data-longitude="<%= sun[:longitude] %>"
  data-declination="<%= sun[:declination] %>"
  data-solar-noon="<%= sun[:solar_noon].strftime('%H:%M') %>"
  data-selected-date="<%= date.iso8601 %>"
  data-selected-city="<%= city_id %>">
  <div class="sun-controls">
    <div class="sun-controls__heading">
      <span class="sun-step">01 <i aria-hidden="true"></i> KRAJ IN DATUM</span>
      <h2 id="sun-experience-title">Načrtujte dan po sončni svetlobi</h2>
      <p>Zora, sončni vzhod in zahod se izračunajo za izbrani kraj in datum. Vsi prikazani časi so krajevni.</p>
    </div>
    <form class="sun-form" action="/soncni-vzhod-in-zahod/" method="get" data-sun-form>
      <label for="sun-city">Mesto</label>
      <div class="sun-city-control">
        <select id="sun-city" name="city" data-sun-city>
          <% city_names.each do |id, values| %>
            <option value="<%= id %>" data-lat="<%= values[1] %>" data-lon="<%= values[2] %>" <%= 'selected' if id == city_id %>><%= values[0] %></option>
          <% end %>
        </select>
        <button class="sun-locate" type="button" data-sun-locate aria-label="Poišči najbližje mesto glede na mojo lokacijo" title="Poišči najbližje mesto">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="9" r="2.4"/></svg>
        </button>
      </div>
      <span class="sun-control-help">Izbor lahko poiščete tudi s tipkanjem imena mesta.</span>
      <label for="sun-date">Datum</label>
      <div class="sun-date-row">
        <button type="button" class="sun-date-step" data-sun-prev aria-label="Prejšnji dan">‹</button>
        <input id="sun-date" name="date" type="date" min="1901-01-01" max="2099-12-31" value="<%= date.iso8601 %>" required data-sun-date>
        <button type="button" class="sun-date-step" data-sun-next aria-label="Naslednji dan">›</button>
      </div>
      <button class="sun-submit" type="submit"><span aria-hidden="true">↗</span> Prikaži sončno pot</button>
      <button class="sun-today" type="button" data-sun-live>Danes · trenutni čas</button>
      <p class="sun-form-status" role="status" aria-live="polite" data-sun-status></p>
    </form>
  </div>

  <div class="sun-dashboard">
    <div class="sun-visual-card">
      <div class="sun-visual-card__top">
        <div><span class="sun-step">02 <i aria-hidden="true"></i> SONČNA POT</span><h2 data-sun-heading><%= sun[:name] %> · <%= sl_date(date) %></h2></div>
        <span class="sun-zone"><span aria-hidden="true"></span> Europe/Ljubljana</span>
      </div>
      <div class="sun-scene-wrap">
        <svg class="sun-scene" viewBox="0 0 720 390" role="img" aria-labelledby="sun-scene-title sun-scene-description" data-sun-scene>
          <title id="sun-scene-title">Pot Sonca za <%= sun[:name] %></title>
          <desc id="sun-scene-description">Sonce se premika po izračunani poti nad ilustrativno alpsko panoramo. Barve neba, mrak, svetlobni sij in oblaki se spreminjajo z izbrano uro. Čas lahko izberete z drsnikom.</desc>
          <defs>
            <linearGradient id="sun-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#10264a"/><stop offset=".42" stop-color="#315678"/><stop offset=".78" stop-color="#90717b"/><stop offset="1" stop-color="#eaa079"/></linearGradient>
            <linearGradient id="sun-alpine-range" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#a6bdcc"/><stop offset=".32" stop-color="#587590"/><stop offset="1" stop-color="#253e59"/></linearGradient>
            <linearGradient id="sun-foothills" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#354f65"/><stop offset=".48" stop-color="#1e3b51"/><stop offset="1" stop-color="#142f48"/></linearGradient>
            <linearGradient id="sun-lake" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#527c91" stop-opacity=".9"/><stop offset="1" stop-color="#142f4b"/></linearGradient>
            <linearGradient id="sun-reflection" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff0c6" stop-opacity=".82"/><stop offset=".34" stop-color="#ffb777" stop-opacity=".37"/><stop offset="1" stop-color="#f29272" stop-opacity="0"/></linearGradient>
            <radialGradient id="sun-corona" cx="50%" cy="50%"><stop stop-color="#fffef0" stop-opacity=".86"/><stop offset=".1" stop-color="#fff3d0" stop-opacity=".68"/><stop offset=".28" stop-color="#ffd49a" stop-opacity=".39"/><stop offset=".58" stop-color="#ffad83" stop-opacity=".16"/><stop offset="1" stop-color="#ff8066" stop-opacity="0"/></radialGradient>
            <radialGradient id="sun-disc" cx="36%" cy="25%"><stop stop-color="#fffbe8"/><stop offset=".18" stop-color="#ffe6a2"/><stop offset=".58" stop-color="#ffb34d"/><stop offset=".86" stop-color="#ef762f"/><stop offset="1" stop-color="#ad3d30"/></radialGradient>
            <radialGradient id="sun-limb-shade"><stop offset=".58" stop-color="#fff" stop-opacity="0"/><stop offset=".84" stop-color="#8e342f" stop-opacity=".12"/><stop offset="1" stop-color="#57242e" stop-opacity=".5"/></radialGradient>
            <radialGradient id="sun-horizon-glow" cx="50%" cy="50%"><stop stop-color="#fff0c4" stop-opacity=".82"/><stop offset=".16" stop-color="#ffc28c" stop-opacity=".42"/><stop offset=".48" stop-color="#ef887d" stop-opacity=".18"/><stop offset="1" stop-color="#f18982" stop-opacity="0"/></radialGradient>
            <radialGradient id="sun-airglow" cx="50%" cy="50%"><stop stop-color="#fff5ce" stop-opacity=".54"/><stop offset=".2" stop-color="#ffd19c" stop-opacity=".3"/><stop offset=".5" stop-color="#ff9b7d" stop-opacity=".12"/><stop offset="1" stop-color="#ff8e78" stop-opacity="0"/></radialGradient>
            <linearGradient id="sun-cloud-light" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff" stop-opacity=".74"/><stop offset=".32" stop-color="#edf3f5" stop-opacity=".42"/><stop offset=".74" stop-color="#bac8d0" stop-opacity=".2"/><stop offset="1" stop-color="#8a9cab" stop-opacity=".1"/></linearGradient>
            <linearGradient id="sun-cloud-warm" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#fff4e3" stop-opacity=".68"/><stop offset=".48" stop-color="#ffc39b" stop-opacity=".46"/><stop offset="1" stop-color="#e67770" stop-opacity=".32"/></linearGradient>
            <filter id="sun-atmosphere-blur" x="-35%" y="-80%" width="170%" height="260%"><feGaussianBlur stdDeviation="16"/></filter>
            <filter id="sun-corona-blur" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="12"/></filter>
            <filter id="sun-surface-detail" x="-8%" y="-8%" width="116%" height="116%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="2" seed="17" stitchTiles="stitch" result="granulation"/>
              <feColorMatrix in="granulation" type="saturate" values="0" result="monochrome-granulation"/>
              <feComponentTransfer in="monochrome-granulation" result="surface-grain"><feFuncR type="linear" slope=".68" intercept=".16"/><feFuncG type="linear" slope=".56" intercept=".22"/><feFuncB type="linear" slope=".34" intercept=".25"/><feFuncA type="table" tableValues="0 .18"/></feComponentTransfer>
              <feBlend in="SourceGraphic" in2="surface-grain" mode="soft-light"/>
            </filter>
            <filter id="sun-cloud-blur" x="-25%" y="-50%" width="150%" height="200%"><feGaussianBlur stdDeviation="7"/></filter>
            <clipPath id="sun-disc-clip"><circle r="23"/></clipPath>
            <pattern id="sun-water-lines" width="46" height="10" patternUnits="userSpaceOnUse"><path d="M2 2h23m8 5h11" stroke="#c4d7df" stroke-opacity=".19" stroke-width=".7" stroke-linecap="round"/></pattern>
          </defs>
          <rect width="720" height="390" fill="url(#sun-sky)" data-sun-sky/>
          <ellipse cx="360" cy="294" rx="440" ry="154" fill="url(#sun-horizon-glow)" opacity=".34" data-sun-horizon-glow/>
          <g class="sun-stars" fill="#fff" aria-hidden="true"><circle cx="69" cy="78" r="1.3"/><circle cx="132" cy="128" r=".8"/><circle cx="198" cy="47" r="1.2"/><circle cx="266" cy="95" r=".8"/><circle cx="331" cy="60" r="1"/><circle cx="402" cy="110" r=".8"/><circle cx="489" cy="48" r="1.1"/><circle cx="571" cy="92" r=".8"/><circle cx="641" cy="62" r="1.3"/><circle cx="607" cy="145" r=".7"/><circle cx="90" cy="165" r=".7"/><circle cx="430" cy="70" r=".6"/></g>
          <g class="sun-clouds" data-sun-cloud="upper" transform="translate(0 0)" aria-hidden="true">
            <path d="M18 144c14-14 31-17 49-10 9-18 29-25 47-17 14-15 39-11 48 7 14-1 26 8 30 19-34 5-60 2-86 3-33 2-60 5-88-2Z" fill="#cfdae2" opacity=".2" filter="url(#sun-cloud-blur)"/>
            <path d="M27 139c9-8 21-10 33-6 7-13 22-17 35-11 10-11 28-8 34 5 12-1 22 5 25 12-30 4-62 2-94 5-13 1-23 0-33-5Z" fill="url(#sun-cloud-light)" opacity=".57"/>
            <path data-cloud-warm d="M27 139c9-8 21-10 33-6 7-13 22-17 35-11 10-11 28-8 34 5 12-1 22 5 25 12-30 4-62 2-94 5-13 1-23 0-33-5Z" fill="url(#sun-cloud-warm)" opacity="0"/>
            <path d="M36 138c14-4 24-3 39-1 16 2 26 0 41-3 11-3 22-2 31 1" fill="none" stroke="#fff" stroke-opacity=".46" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M425 119c15-13 32-15 49-8 8-17 27-23 44-15 13-13 36-10 44 7 15-2 27 7 31 18-31 6-62 2-91 5-28 2-52 1-77-7Z" fill="#d5dfe5" opacity=".2" filter="url(#sun-cloud-blur)"/>
            <path d="M434 113c10-8 20-9 32-5 7-12 21-15 33-9 9-10 26-7 32 6 12-1 21 5 24 12-28 3-56 1-84 3-14 1-25 0-37-7Z" fill="url(#sun-cloud-light)" opacity=".52"/>
            <path data-cloud-warm d="M434 113c10-8 20-9 32-5 7-12 21-15 33-9 9-10 26-7 32 6 12-1 21 5 24 12-28 3-56 1-84 3-14 1-25 0-37-7Z" fill="url(#sun-cloud-warm)" opacity="0"/>
            <path d="M448 111c13-3 24-2 36 0 14 2 24 0 37-4 10-2 18-1 26 1" fill="none" stroke="#fff" stroke-opacity=".4" stroke-width="1" stroke-linecap="round"/>
          </g>
          <g class="sun-clouds" data-sun-cloud="lower" transform="translate(0 0)" aria-hidden="true">
            <path d="M175 217c14-15 31-18 49-10 9-18 30-24 47-15 14-13 37-9 44 8 17-2 30 7 35 19-32 8-65 7-98 6-29-1-52 0-77-8Z" fill="#d5dfe5" opacity=".18" filter="url(#sun-cloud-blur)"/>
            <path d="M188 210c10-8 22-9 34-4 7-12 22-16 34-9 10-10 27-6 32 7 14-2 23 4 28 11-26 5-58 4-83 3-16 0-31 0-45-8Z" fill="url(#sun-cloud-light)" opacity=".42"/>
            <path data-cloud-warm d="M188 210c10-8 22-9 34-4 7-12 22-16 34-9 10-10 27-6 32 7 14-2 23 4 28 11-26 5-58 4-83 3-16 0-31 0-45-8Z" fill="url(#sun-cloud-warm)" opacity="0"/>
            <path d="M198 210c17 2 27 0 41-3 15-4 26-3 40 0 12 3 21 2 31 0" fill="none" stroke="#fff" stroke-opacity=".4" stroke-width="1" stroke-linecap="round"/>
            <path d="M496 194c12-12 26-14 41-7 7-15 24-19 38-11 11-11 31-7 37 8 13-1 23 6 27 16-27 5-53 4-80 4-25 0-44-1-63-10Z" fill="#d6e0e7" opacity=".17" filter="url(#sun-cloud-blur)"/>
            <path d="M506 188c8-7 18-7 29-3 6-10 18-12 28-6 8-9 23-5 27 6 12-1 19 4 23 11-23 4-46 3-69 3-15 0-27-2-38-11Z" fill="url(#sun-cloud-light)" opacity=".38"/>
            <path data-cloud-warm d="M506 188c8-7 18-7 29-3 6-10 18-12 28-6 8-9 23-5 27 6 12-1 19 4 23 11-23 4-46 3-69 3-15 0-27-2-38-11Z" fill="url(#sun-cloud-warm)" opacity="0"/>
            <path d="M517 188c12 2 22 0 34-3 11-3 20-2 31 1 10 3 19 2 27 0" fill="none" stroke="#fff" stroke-opacity=".34" stroke-width=".9" stroke-linecap="round"/>
          </g>
          <ellipse cx="360" cy="250" rx="0" ry="0" fill="url(#sun-airglow)" opacity="0" filter="url(#sun-atmosphere-blur)" data-sun-scatter/>
          <path d="M35 300 Q185 299 360 300 T685 300" fill="none" stroke="#fff0d9" stroke-opacity=".42" stroke-width="1.2" stroke-dasharray="2 7" data-sun-horizon-line/>
          <path d="M360 92V300" stroke="#fff" stroke-opacity=".12" stroke-dasharray="3 8"/>
          <path d="" fill="none" stroke="#fff0c2" stroke-opacity=".3" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2 6" data-sun-path/>
          <g class="sun-object" data-sun-object transform="translate(360 160)" aria-hidden="true">
            <circle r="78" fill="url(#sun-corona)" class="sun-corona-halo" filter="url(#sun-corona-blur)"/>
            <circle r="62" fill="url(#sun-corona)" class="sun-corona-pulse"/>
            <circle r="34" fill="#ffe6b4" opacity=".3" filter="url(#sun-corona-blur)"/>
            <circle r="23.5" fill="url(#sun-disc)"/>
            <g clip-path="url(#sun-disc-clip)"><image data-sun-disc-photo href="/images/solar/sdo-hmiic-photosphere-2026-10-21.jpg" x="-25" y="-25" width="50" height="50" preserveAspectRatio="xMidYMid slice" filter="url(#sun-surface-detail)"/><circle r="23" fill="url(#sun-limb-shade)"/>
            </g>
            <circle r="23.5" fill="none" stroke="#fff5d4" stroke-opacity=".74" stroke-width=".65"/>
            <circle r="21.9" fill="none" stroke="#8d392f" stroke-opacity=".29" stroke-width=".8"/>
          </g>
          <g class="sun-alps" aria-hidden="true">
            <path d="M0 307 42 296 80 301 116 291 137 300 174 292 218 302 264 286 300 294 329 275 348 284 360 266 376 283 394 276 429 295 466 282 501 298 545 287 579 300 612 290 653 298 720 292V390H0Z" fill="url(#sun-alpine-range)" opacity=".74"/>
            <path d="m310 291 19-16 19 9 12-18 16 17 18-7 22 19-31-8-13 8-12-11-13 9-18-10-13 9Z" fill="#e9f1f0" opacity=".72"/>
            <path d="M0 321 50 307 94 314 136 305 184 315 228 304 274 314 323 300 365 311 412 301 458 314 505 303 550 315 594 305 643 316 686 304 720 314V390H0Z" fill="url(#sun-foothills)"/>
            <path d="M0 320 50 307 94 314 136 305 184 315 228 304 274 314 323 300 365 311 412 301 458 314 505 303 550 315 594 305 643 316 686 304 720 314" fill="none" stroke="#b4c9ce" stroke-opacity=".46" stroke-width="1.1"/>
            <path d="M0 334 Q170 325 330 337T720 332V390H0Z" fill="url(#sun-lake)" opacity=".78"/>
            <path d="M0 334 Q170 325 330 337T720 332V390H0Z" fill="url(#sun-water-lines)" opacity=".55"/>
            <path d="M0 350 Q102 339 201 350T389 351T565 343T720 352V390H0Z" fill="#18334a" opacity=".78"/>
            <g fill="#102b40" opacity=".94"><path d="m42 351 9-24 9 24h-5l8 15H39l8-15Zm34 1 7-20 8 20h-4l7 14H69l7-14Zm540 2 10-28 10 28h-6l9 17h-27l9-17Zm34-1 8-22 8 22h-5l7 14h-20l7-14Zm-71 4 7-19 7 19h-4l7 12h-18l7-12Z"/></g>
          </g>
          <path d="" fill="none" stroke="url(#sun-reflection)" stroke-width="13" stroke-linecap="round" opacity="0" filter="url(#sun-atmosphere-blur)" data-sun-reflection/>
          <g class="sun-scene-labels" fill="#f4f8fc" font-family="Avenir, 'Avenir Next', system-ui, sans-serif" font-size="11" font-weight="650"><text x="39" y="326">VZHOD</text><text x="626" y="326">ZAHOD</text><text x="360" y="326" text-anchor="middle">JUG · SONČNO POLDNE</text></g>
        </svg>
      </div>
      <div class="sun-timeline">
        <div class="sun-timeline__meta"><span>Izbrana ura</span><output data-sun-clock aria-live="polite">—:—</output><span class="sun-time-note">po slovenskem času</span></div>
        <label class="sr-only" for="sun-time">Izberite čas za prikaz položaja Sonca</label>
        <input id="sun-time" type="range" min="0" max="1439" step="5" value="720" data-sun-time>
        <div class="sun-timeline__ends"><span>00.00 · noč</span><span>12.00 · poldne</span><span>23.55 · noč</span></div>
        <div class="sun-play-row"><p data-sun-position role="status" aria-live="polite">Izračunani položaj Sonca</p><button type="button" data-sun-play aria-pressed="false"><span aria-hidden="true">▶</span> Predvajaj dnevno pot</button></div>
      </div>
          <p class="sun-scene-note">Položaj in azimut Sonca se računata za izbrani trenutek; disk prikazuje NASA/SDO-jevo fotosfero z vidno granulacijo in sončnimi pegami, obrobljeno z atmosfersko sipano svetlobo. Alpska panorama in oblaki so ilustrativni, ne prikazujejo lokalnega reliefa ali dejanskega vremena. Površinska fotografija: NASA/SDO HMI Continuum, 21. 10. 2026.</p>
    </div>

    <aside class="sun-day-card" aria-label="Sončni časi in dnevna svetloba">
      <div class="sun-day-card__head"><span class="sun-step">03 <i aria-hidden="true"></i> SONČNI ČASI ZA <b data-sun-city-name><%= sun[:name] %></b></span><span class="sun-day-number" data-sun-day-number><%= sun[:minutes] / 60 %><small>h</small> <%= (sun[:minutes] % 60) %><small>min svetlobe</small></span></div>
      <div class="sun-event-list">
        <div class="sun-event sun-event--twilight"><span class="sun-event__icon" aria-hidden="true">◌</span><div><small>Jutranji civilni mrak</small><strong data-sun-value="civil-dawn"><%= sun[:civil_dawn].strftime('%H:%M') %></strong></div><small>–6°</small></div>
        <div class="sun-event sun-event--rise"><span class="sun-event__icon" aria-hidden="true">↗</span><div><small>Sončni vzhod</small><strong data-sun-value="sunrise"><%= sun[:rise].strftime('%H:%M') %></strong></div><small>obzorje</small></div>
        <div class="sun-event sun-event--golden"><span class="sun-event__icon" aria-hidden="true">✦</span><div><small>Jutranja zlata ura</small><strong><span data-sun-value="golden-morning-start"><%= sun[:golden_morning_start].strftime('%H:%M') %></span>–<span data-sun-value="golden-morning-end"><%= sun[:golden_morning_end].strftime('%H:%M') %></span></strong></div><small>−4° do +6°</small></div>
        <div class="sun-event sun-event--noon"><span class="sun-event__icon" aria-hidden="true">☼</span><div><small>Sončno poldne</small><strong data-sun-value="solar-noon"><%= sun[:solar_noon].strftime('%H:%M') %></strong></div><small>najvišja lega</small></div>
        <div class="sun-event sun-event--golden"><span class="sun-event__icon" aria-hidden="true">✦</span><div><small>Večerna zlata ura</small><strong><span data-sun-value="golden-evening-start"><%= sun[:golden_evening_start].strftime('%H:%M') %></span>–<span data-sun-value="golden-evening-end"><%= sun[:golden_evening_end].strftime('%H:%M') %></span></strong></div><small>+6° do −4°</small></div>
        <div class="sun-event sun-event--set"><span class="sun-event__icon" aria-hidden="true">↘</span><div><small>Sončni zahod</small><strong data-sun-value="sunset"><%= sun[:set].strftime('%H:%M') %></strong></div><small>obzorje</small></div>
        <div class="sun-event sun-event--twilight"><span class="sun-event__icon" aria-hidden="true">◌</span><div><small>Večerni civilni mrak</small><strong data-sun-value="civil-dusk"><%= sun[:civil_dusk].strftime('%H:%M') %></strong></div><small>–6°</small></div>
      </div>
      <p class="sun-date-caption" data-sun-date-caption><%= sl_date(date) %> · <%= sun[:name] %></p>
      <button class="sun-share" type="button" data-sun-share><span aria-hidden="true">↗</span> Kopiraj povezavo do izračuna</button>
    </aside>
  </div>

  <details class="sun-method">
    <summary>Kako so izračunani sončni časi?</summary>
    <div><p>Izračun Sončevega navideznega položaja temelji na Meeusovih astronomskih enačbah, ki jih kot osnovo navaja tudi NOAA; dogodek se določi z izračunom prehoda čez izbrano višino obzorja. Vzhod in zahod uporabljata standardno višino −0,833° (približek atmosferskega loma in navideznega polmera Sonca); rezultati so zaokroženi na minuto. Zlata ura je prikazana med višinama Sonca −4° in +6°, civilni mrak pa do −6°.</p>
    <p>Časovni pas je <code>Europe/Ljubljana</code>, zato se poletni in zimski čas upoštevata za vsak datum posebej. Koordinate so iz <a href="https://www.gov.si/assets/ministrstva/MOP/Dokumenti/Urbani-razvoj/naselja_s_statusom_mesta.pdf" rel="noopener">uradnega seznama slovenskih naselij s statusom mesta</a>. Sončeva površinska slika je opazovanje <a href="https://sdo.gsfc.nasa.gov/data/channels.php" rel="noopener">NASA/SDO HMI Continuum</a> z dne 21. oktobra 2026; prikazuje izmerjeno fotosfero, ne napovedi za izbrani datum. NOAA pojasnjuje uporabljeno astronomsko osnovo v <a href="https://gml.noaa.gov/grad/solcalc/calcdetails.html" rel="noopener">Solar Calculation Details</a>; časi so primerjani z <a href="https://aa.usno.navy.mil/data/api.html" rel="noopener">USNO-jevo astronomsko API-referenco</a>. Izračunano obzorje je geometrijsko; lokalni teren, nadmorska višina, vreme in dejanski lom svetlobe lahko opazovani trenutek nekoliko spremenijo.</p></div>
  </details>
</section>

<% if page_path == '/soncni-vzhod-in-zahod/' %>
  <section class="sun-city-section" aria-labelledby="sun-cities-title">
    <div class="sun-city-heading"><div><span class="sun-step">04 <i aria-hidden="true"></i> PO MESTIH</span><h2 id="sun-cities-title">Sončni časi v vseh slovenskih mestih</h2><p>Izberite mesto za lasten dnevni lok, vzhod, zahod in trajanje svetlega dela dneva.</p></div>
      <label class="sun-city-search"><span class="sr-only">Filtrirajte seznam mest</span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"/><path d="m15.5 15.5 5 5"/></svg><input type="search" placeholder="Poiščite mesto …" autocomplete="off" data-sun-city-filter></label></div>
    <p class="sun-city-count" data-sun-city-count>69 mest · <a href="/fotografije-in-licence/#fotografije-mest">fotografije, avtorji in licence</a></p>
    <div class="sun-city-grid" data-sun-city-grid>
      <% city_names.each do |id, values| %>
        <% photo = city_catalog.fetch(id).fetch('photo') %>
        <article class="sun-city-link" data-city-name="<%= values[0].downcase %>">
          <a class="sun-city-link__main" tabindex="0" href="/soncni-vzhod-in-zahod/<%= id %>/">
            <%= raw(Rails.root.join('data', 'city-marks', "#{id}.svg").read) %>
            <span class="sun-city-link__copy"><strong><%= values[0] %></strong><small><%= format('%.4f° N · %.4f° E', values[1], values[2]) %></small></span>
            <span class="sun-city-link__arrow" aria-hidden="true">↗</span>
          </a>
          <a class="sun-city-link__credit" tabindex="0" href="/fotografije-in-licence/#<%= id %>" aria-label="Avtor fotografije: <%= photo.fetch('author') %>; licenca: <%= photo.fetch('license') %>; vir in podrobnosti za mesto <%= values[0] %>">
            <span>Foto: <%= photo.fetch('author') %></span><b><%= photo.fetch('license') %></b>
          </a>
        </article>
      <% end %>
    </div>
    <p class="sun-city-empty" hidden data-sun-city-empty>Za iskani niz ni zadetkov. Poskusite z drugim imenom mesta.</p>
  </section>
<% else %>
  <nav class="sun-city-neighbors" aria-label="Druga slovenska mesta">
    <h2>Sončni časi še v drugih mestih</h2>
    <% city_names.each do |id, values| %>
      <% next if id == city_id %>
      <a href="/soncni-vzhod-in-zahod/<%= id %>/"><%= values[0] %></a>
    <% end %>
    <a class="sun-city-neighbors__all" href="/soncni-vzhod-in-zahod/">Vseh 69 mest</a>
  </nav>
<% end %>
