<% month=@page.month || params[:month].to_i;category=ImportantDays::CATEGORIES.key?(params[:category]) ? params[:category] : 'all';query=params[:q].to_s.first(100);events=ImportantDays.filter(@events,month:month,category:category,query:query);view=params[:display]=='calendar' ? 'calendar' : 'list';free_dates=@events.select(&:work_free).map(&:on).to_set;next_event=events.find { |e|e.on>=@today } %>
<section class="panel important-controls"><%= render 'year_selector' %><form method="get" class="filters"><input name="year" type="hidden" value="<%= @year %>"><label>Mesec<select name="month"><option value="0">Vsi meseci</option><% CalendarEngine::MONTHS.each_with_index do |name,i| %><option value="<%= i+1 %>" <%= 'selected' if month==i+1 %>><%= name.capitalize %></option><% end %></select></label><label>Vsebina<select name="category"><% ImportantDays::CATEGORIES.each do |key,label| %><option value="<%= key %>" <%= 'selected' if category==key %>><%= label %></option><% end %></select></label><label>Poišči dan<input name="q" value="<%= query %>" type="search" maxlength="100" placeholder="Npr. dan čebel"></label><label>Pogled<select name="display"><option value="list" <%= 'selected' if view=='list' %>>Seznam</option><option value="calendar" <%= 'selected' if view=='calendar' %>>Koledar</option></select></label><button>Prikaži</button></form><p><%= I18n.t('results',count:events.size) %>. Mednarodni ali kulturni dan sam po sebi ne pomeni dela prostega dne.</p>
<% if next_event %><div class="important-next"><span>Naslednji v izboru</span><a href="<%= event_path(next_event) %>"><strong><%= next_event.title.sub(/\A./,&:upcase) %></strong></a><time datetime="<%= next_event.on %>"><%= I18n.l(next_event.on) %></time><span><%= next_event.on==@today ? 'Danes' : "Čez #{I18n.t('day_count_acc',count:(next_event.on-@today).to_i)}" %></span></div><% end %>
<div class="actions"><a class="button" href="/prazniki/<%= @year %>.ics?<%= {all:1,month:month,category:category,q:query}.to_query %>">Prenesi izbrane dneve ICS</a><button data-print>Natisni izbor</button><a href="/prazniki/<%= @year %>/">Zakonski prazniki →</a></div></section>
<% if events.empty? %><p class="panel empty">V izboru ni dni. Poskusite drug mesec, vrsto ali krajši iskalni izraz.</p><% elsif view=='calendar' %><div class="important-months"><% events.group_by { |e|e.on.month }.each do |m,rows| %><section class="panel"><h2><%= CalendarEngine::MONTHS[m-1].capitalize %> <%= @year %></h2><div class="table-wrap"><table class="important-calendar" aria-label="<%= CalendarEngine::MONTHS[m-1].capitalize %> <%= @year %>: pomembni dnevi"><thead><tr><% CalendarEngine::SHORT_DAYS.each do |day| %><th scope="col"><%= day %></th><% end %></tr></thead><tbody><% CalendarEngine.weeks(@year,m).each do |week| %><tr><% week.each do |date| %><td><% if date.month==m %><a class="important-date" href="<%= calendar_path(date) %>"><%= date.day %></a><% rows.select { |e|e.on==date }.each do |event| %><a class="important-event" href="<%= event_path(event) %>"><%= event.title %></a><% end %><% end %></td><% end %></tr><% end %></tbody></table></div></section><% end %></div>
<% else %><section class="panel"><div class="table-wrap"><table class="data-table" aria-label="Pomembni dnevi in njihov status"><thead><tr><th scope="col">Datum</th><th scope="col">Pomembni dan</th><th scope="col">Vrsta</th><th scope="col">Status dneva</th></tr></thead><tbody><% events.each do |event| %><tr><td><a href="<%= calendar_path(event.on) %>"><%= I18n.l(event.on) %></a><br><small><%= CalendarEngine::DAYS[event.on.cwday-1] %></small></td><td><a href="<%= event_path(event) %>"><strong><%= event.title.sub(/\A./,&:upcase) %></strong></a></td><td><%= ImportantDays::CATEGORIES[ImportantDays.category(event)] %></td><td><%= event.work_free ? 'Dela prost dan' : (free_dates.include?(event.on) ? 'Sovpada z dela prostim dnem' : 'Ni dela prost dan') %></td></tr><% end %></tbody></table></div></section><% end %>
<nav class="period-links panel" aria-labelledby="important-month-links"><h2 id="important-month-links">Pomembni dnevi po mesecih</h2><div><% CalendarEngine::MONTHS.each do |name| %><% target="/pomembni-dnevi/#{name}/" %><a href="<%= target %>" <%= 'aria-current=page' if @page.path==target %>><%= name.capitalize %></a><% end %></div></nav>
<section class="related-topics"><h2>Odkrijte zgodbe za datumi</h2><div class="link-grid"><% Page.where(family:['Özel gün ve mevsimler','Ek önemli gün konuları']).order(:title).each do |page| %><a href="<%= page.path %>"><%= page.title %></a><% end %></div></section>
