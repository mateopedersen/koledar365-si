<% type={'ustvari-koledar'=>'name','prazen-koledar'=>'blank','razpored-izmen'=>'shift','solski-urnik'=>'school','rojstnodnevni-koledar'=>'birthday','dnevni-planer'=>'daily','druzinski-planer'=>'family','koledar-za-tiskanje'=>'annual'}[page_path.split('/').last] %><section class="panel"><form id="planner-options" data-planner-type="<%= type %>"><div class="filters"><label>Leto<select name="year"><% (2027..2030).each do |y| %><option <%= 'selected' if y==@year %>><%= y %></option><% end %></select></label><label>Mesec<select name="month"><% CalendarEngine::MONTHS.each_with_index do |m,i| %><option value="<%= i+1 %>" <%= 'selected' if i+1==@month %>><%= m %></option><% end %></select></label><label>Izbrani datum<input type="date" name="date" value="<%= Date.new(@year==2026 ? 2027:@year,@month,1) %>"></label><label>Vrsta<select name="type"><% PrintCatalog::TYPES.each do |value,label| %><option value="<%= value %>" <%= 'selected' if value==type %>><%= label %></option><% end %></select></label></div><label>Ime ali naslov (neobvezno)<input name="name" maxlength="100" placeholder="Ime: Ana"></label><label>Osebni zapiski (neobvezno)<textarea name="notes" maxlength="2000" rows="2"></textarea></label><% if type=='blank' %><label>Datumi<select name="undated"><option value="1">Brez datumov</option><option value="0">Z datumi izbranega meseca</option></select></label><% end %><p class="muted">Osebne nastavitve shranjujemo samo na tej napravi. Ob izdelavi datoteke se izbrani vnosi pošljejo strežniku; zasebni izvoz je dostopen samo v vaši seji in se izbriše po 7 dneh.</p><button type="button" id="save-planner">Shrani nastavitve</button><output id="planner-message"></output></form>
<% if %w[shift school birthday family daily weekly].include?(type) %><h2>Vnosi v načrt</h2><form id="planner-entry"><div class="filters"><label>Datum<input name="date" type="date" value="2027-01-04" required></label><label>Ura<input name="time" type="time"></label><label>Oseba / učilnica<input name="person" maxlength="80"></label><label>Dogodek / predmet<input name="title" maxlength="120" required></label><label>Koda izmene<input name="code" maxlength="20"></label></div><button>Dodaj vnos</button></form><div id="planner-entries"></div><% end %>
<% if type=='shift' %><h2>Izračun ponavljajočega se razporeda</h2><form class="api-form" id="shift-form" action="/izracun/" method="post"><%= hidden_field_tag :authenticity_token,form_authenticity_token %><input name="tool" type="hidden" value="shift"><div class="filters"><label>Začetek cikla<input type="date" name="from" value="2027-01-04" required></label><label>Konec obdobja<input type="date" name="to" value="2027-01-31" required></label><label>Cikel (ločite z vejico)<input name="cycle" value="D,D,N,N,Prosto,Prosto" required></label><label>Oseba<input name="person" maxlength="80"></label></div><button>Izračunaj razpored</button><output class="result" aria-live="polite"></output></form><% end %>
<% if type=='birthday' %><p>Za rojstni dan 29. februarja v neprestopnem letu dogodek ročno prestavite na 28. februar ali 1. marec; izvornega datuma ne spreminjamo samodejno. Izvoz ICS ohrani letno ponavljanje, če ga izberete v osebnem koledarju.</p><% end %></section><%= render 'designs',type:type %>
