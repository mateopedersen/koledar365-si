<section class="design-section" id="design-gallery" aria-labelledby="design-gallery-title" data-export-options="<%= export_options(type).to_json %>">
  <header class="section-heading"><div><span class="eyebrow"><%= type=='shift' ? 'PREDLOGE ZA VAŠE IZMENE' : type=='school' ? 'PREDLOGE ZA UČENCE IN DIJAKE' : 'ZBIRKA ZA TISKANJE' %></span><h2 id="design-gallery-title"><%= type=='shift' ? '15 predlog za tiskanje razporeda' : type=='school' ? '15 predlog šolskega urnika' : '15 predlog za vaš koledar' %></h2></div><span class="gallery-format-label">PDF + WebP · 600 ppi</span></header>
  <% if type=='school' %><p class="student-gallery-copy">Izberi eno od 15 različnih postavitev za svoj tedenski urnik. Vsaka predloga ima ujemajoči se PDF za tisk in WebP za hiter predogled ali deljenje, podpis Koledar365 ter izvoz v visoki ločljivosti 600 ppi; pred prenosom lahko preveriš svoj osebni predogled in prilagodiš papir ali usmerjenost.</p><% end %>
  <div class="filters design-settings"><label>Papir<select class="export-paper"><option>A4</option><option>A3</option><option>A5</option></select></label><label>Usmerjenost<select class="export-orientation"><option value="portrait">Pokončno</option><option value="landscape">Ležeče</option></select></label></div>
  <div class="design-grid"><% PrintCatalog.designs.each_with_index do |d,index| %><article class="design-card">
    <img src="/predogled/<%= @year==2026 ? 2027:@year %>/<%= d['id'] %>/<%= @person&.slug||'koledar' %>.png?<%= {type:type,month:@month||1}.to_query %>" data-preview-design="<%= d['id'] %>" alt="<%= @person ? "Ime: #{@person.exact}. " : '' %><%= PrintCatalog::TYPES.fetch(type) %> <%= (@year||2027).clamp(2027,2030) %> – <%= d['name_sl'] %>" width="212" height="300" loading="lazy">
    <div><h3><span class="design-number" aria-hidden="true"><%= '%02d' % (index+1) %></span><span class="design-title"><%= d['name_sl'] %></span></h3><p><%= d['color_mode']=='monochrome_bw' ? 'Črno-bela predloga':'Barvna predloga' %> · podpis Koledar365</p>
      <div class="actions"><button class="preview-personal" type="button" data-personal-preview="<%= d['id'] %>">Moj predogled <span aria-hidden="true">↗</span></button><button class="calendar-download-action calendar-download-action--pdf" type="button" data-export="<%= d['id'] %>" data-format="pdf"><%= calendar_file_icon('pdf') %><span class="calendar-download-action__copy"><strong>PDF</strong><small>Prenesi</small></span></button><button class="calendar-download-action calendar-download-action--webp" type="button" data-export="<%= d['id'] %>" data-format="webp"><%= calendar_file_icon('webp') %><span class="calendar-download-action__copy"><strong>WebP</strong><small>Prenesi</small></span></button></div>
      <p class="export-status" role="status"></p>
    </div></article><% end %></div>
</section>
