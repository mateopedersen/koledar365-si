        <g fill="#d8e5f1"><rect x="119" y="118" width="31" height="27" rx="7"/><rect x="164" y="118" width="31" height="27" rx="7"/><rect x="209" y="118" width="31" height="27" rx="7"/><rect x="254" y="118" width="31" height="27" rx="7"/><rect x="119" y="159" width="31" height="27" rx="7"/><rect x="164" y="159" width="31" height="27" rx="7"/><rect x="209" y="159" width="31" height="27" rx="7"/><rect x="254" y="159" width="31" height="27" rx="7"/></g><rect x="209" y="159" width="31" height="27" rx="7" fill="#d9233d"/><path d="m218 172 6 6 11-13" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
