<section class="z-signs" id="znamenja" aria-labelledby="z-signs-title">
  <div class="z-section-heading">
    <h2 id="z-signs-title">Horoskop za vseh 12 znamenj</h2>
  </div>
  <div class="z-filters" role="group" aria-label="Filtriraj znamenja po elementu">
    <% ['Vsa znamenja', 'Ogenj', 'Zemlja', 'Zrak', 'Voda'].each_with_index do |element, index| %>
      <button type="button" data-sign-filter="<%= index.zero? ? 'all' : element %>" aria-pressed="<%= index.zero? %>"><%= element %></button>
    <% end %>
  </div>
  <div class="z-card-grid" role="list">
    <% @horoscope_guide.profiles.each do |sign| %>
      <div class="z-card" role="listitem" data-sign-card="<%= sign['slug'] %>" data-element="<%= sign['element'] %>">
        <a href="/horoskop/<%= sign['slug'] %>/">
          <div class="z-card-art">
            <img src="/horoscope/art/<%= sign['slug'] %>-v1.svg" width="320" height="310" loading="lazy" decoding="async" alt="">
            <span class="z-element"><%= sign['element'] %></span>
          </div>
          <div class="z-card-copy">
            <h3><%= sign['name'] %></h3>
            <p class="z-card-date"><%= sign['dates'] %></p>
            <p class="z-card-excerpt" data-card-copy><%= @horoscope_guide.reading(sign['slug'])['title'] || sign['intro'] %></p>
            <span class="z-card-link">Dnevni horoskop <span class="z-button-icon"><%= ui_icon('chevron-right') %></span></span>
          </div>
        </a>
      </div>
    <% end %>
  </div>
  <p class="z-small-note">Na mejnih dnevih se znamenje lahko razlikuje glede na leto in uro rojstva. <a href="#ascendent">Izračunajte sončno in vzhajajoče znamenje.</a></p>
</section>
