<% if @page.year %>
  <% if (2027..2030).cover?(@year) && !page_path.start_with?('/tedenski-koledar/') %>
    <% download_month = @page.month || 1 %>
    <% download_type = @page.month ? 'monthly' : 'annual' %>
    <% download_date = Date.new(@year, download_month, 1).iso8601 %>
    <% download_query = { year: @year, month: download_month, type: download_type, date: download_date }.to_query %>
    <% download_heading = @page.month ? "Koledar za #{CalendarEngine::MONTHS[download_month - 1]} #{@year}" : "Letni koledar #{@year}" %>
    <aside class="calendar-download-callout" aria-labelledby="calendar-download-title">
      <span class="calendar-download-icon"><%= ui_icon('download') %></span>
      <div class="calendar-download-copy">
        <span class="eyebrow">15 PREDLOG · PDF + WEBP · 600 PPI</span>
        <h2 id="calendar-download-title"><%= download_heading %> za tisk</h2>
        <p>Za to obdobje izberite med 15 predlogami, nato prenesite izbrani koledar kot PDF ali WebP.</p>
      </div>
      <a class="button primary" href="/koledar-za-tiskanje/?<%= download_query %>"><%= ui_icon('download') %> Prikaži predloge</a>
    </aside>
  <% end %>
  <section class="panel"><% if page_path.start_with?('/tedenski-koledar/') %><% @view='week' %><% end %><%= render 'calendar_controls' %><%= render 'calendar_view' %><div class="actions"><button data-print>Natisni</button><a class="button" href="/koledar-za-tiskanje/?year=<%= @year %>&month=<%= @month %>&type=<%= @view=='week' ? 'weekly' : (@page.month ? 'monthly' : 'annual') %>&date=<%= @selected.iso8601 %>">Prenesi PDF in WebP</a><a href="/koledar/<%= @year %>/">Letni pregled</a></div></section>
<% else %><%= render 'year_cards' %><div class="link-grid"><% @children.limit(65).each do |p| %><a href="<%= p.path %>"><%= p.title %></a><% end %></div><% end %>
<% if @page.month %><nav class="actions"><% d=Date.new(@year,@month,1);[d.prev_month,d.next_month].each do |n| %><% if CalendarEngine::YEARS.include?(n.year) %><a href="<%= month_url(n.year,n.month) %>"><%= CalendarEngine::MONTHS[n.month-1] %> <%= n.year %></a><% end %><% end %></nav><% end %>
