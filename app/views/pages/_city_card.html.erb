<% city=CityCatalog.default; city_image=WebImageCatalog.find(city.dig('photo','local_path')) %>
<section class="panel today-panel" id="city-card" data-cities-url="/cities.json" data-weather-state="loading">
  <header class="today-heading">
    <span class="today-location" aria-hidden="true"><svg viewBox="0 0 48 56" fill="none"><defs><linearGradient id="today-pin-red" x1="9" y1="4" x2="37" y2="43" gradientUnits="userSpaceOnUse"><stop stop-color="#ff6673"/><stop offset="1" stop-color="#c9203b"/></linearGradient></defs><ellipse cx="24" cy="51" rx="10" ry="3" fill="#c9203b" opacity=".13"/><path d="M24 3C13.5 3 6 10.4 6 20.2c0 12 18 27.3 18 27.3s18-15.3 18-27.3C42 10.4 34.5 3 24 3Z" fill="url(#today-pin-red)"/><circle cx="24" cy="20" r="7.5" fill="white"/><path d="M12 18a12.5 12.5 0 0 1 10-9" stroke="white" stroke-width="2.5" stroke-linecap="round" opacity=".5"/></svg></span>
    <div><span class="today-eyebrow">Tukaj in zdaj</span><h2>Danes v Sloveniji</h2></div>
    <span class="today-live" title="Krajevni čas v Sloveniji"><i aria-hidden="true"></i> V živo</span>
  </header>
  <figure class="city-photo"><picture><source id="city-photo-avif" type="image/avif" srcset="<%= city_image&.fetch('avif_srcset') %>" sizes="<%= WebImageCatalog::CITY_SIZES %>"><img id="city-photo" src="<%= city_image&.fetch('src') || city.dig('photo','local_path') %>" srcset="<%= city_image&.fetch('srcset') %>" sizes="<%= WebImageCatalog::CITY_SIZES %>" alt="<%= city['name'] %> – pogled na mesto" width="<%= city_image&.fetch('width') || 960 %>" height="<%= city_image&.fetch('height') || 600 %>" fetchpriority="high" decoding="async"></picture><figcaption><span id="city-caption"><%= city['name'] %>, Slovenija</span><a id="city-credit" href="/fotografije-in-licence/#<%= city['id'] %>" aria-label="Avtor in licenca fotografije"><%= ui_icon('info') %></a></figcaption></figure>
  <div class="today-body">
    <p class="today-date" id="city-today"><%= CalendarEngine::DAYS[@today.cwday-1].capitalize %>, <%= sl_date(@today) %></p>
    <div class="time-row">
      <svg class="city-clock" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#f2f6fc" stroke="#d5e1ef"/><circle cx="32" cy="32" r="25" fill="white"/><path d="M32 9v3m23 20h-3M32 55v-3M9 32h3M20.5 12l1.5 2.6m21.5-2.6L42 14.6M52 20.5 49.4 22M52 43.5 49.4 42M43.5 52 42 49.4M20.5 52l1.5-2.6M12 43.5l2.6-1.5M12 20.5l2.6 1.5" stroke="#9cadc3" stroke-width="1.5" stroke-linecap="round"/><path class="clock-hour-hand" d="M32 32V20" stroke="#153355" stroke-width="3.2" stroke-linecap="round"/><path class="clock-minute-hand" d="M32 32V14" stroke="#153355" stroke-width="2.2" stroke-linecap="round"/><path class="clock-second-hand" d="M32 38V11" stroke="#df3e53" stroke-width="1.2" stroke-linecap="round"/><circle cx="32" cy="32" r="3" fill="#df3e53"/></svg>
      <div class="clock-readout"><span class="clock-caption">Krajevni čas</span><div class="clock-digits"><time id="ljubljana-clock" aria-label="Krajevni čas v Sloveniji">—:—</time><span id="city-clock-seconds" aria-hidden="true">00</span></div></div>
      <span class="clock-zone" id="city-zone">Ljubljana</span>
    </div>
    <div class="city-picker"><label for="city-select">Vaše mesto</label><div class="city-select-shell"><%= ui_icon('pin') %><select id="city-select" aria-label="Izberite mesto v Sloveniji"><% CityCatalog.all.each do |c|; image=WebImageCatalog.find(c.dig('photo','local_path')) %><option value="<%= c['id'] %>" data-photo="<%= image&.fetch('src') || c.dig('photo','local_path') %>" data-photo-srcset="<%= image&.fetch('srcset') %>" data-photo-avif="<%= image&.fetch('avif_srcset') %>" data-credit="/fotografije-in-licence/#<%= c['id'] %>" <%= 'selected' if c['id']==city['id'] %>><%= c['name'] %></option><% end %></select><%= ui_icon('chevron-right') %></div></div>
    <details class="weather-details" id="city-weather"><summary><span class="weather-icon" id="weather-icon" aria-hidden="true"><svg class="weather-loading" viewBox="0 0 100 100"><circle cx="50" cy="50" r="23" fill="none" stroke="#dce7f2" stroke-width="4"/><path d="M50 27a23 23 0 0 1 23 23" fill="none" stroke="#7195bb" stroke-width="4" stroke-linecap="round"/></svg></span><span class="weather-summary"><b id="weather-label">Vreme · <%= city['name'] %></b><small id="weather-description">Pridobivamo napoved …</small></span><strong id="weather-temperature">—</strong><%= ui_icon('chevron-right') %></summary><div id="weather-more"><p class="muted">Modelna napoved: MET Norway. Fotografija prikazuje mesto, ne trenutnega vremena.</p></div></details>
    <div class="weather-source"><span class="status-dot" aria-hidden="true"></span><div><small id="weather-updated" role="status">Povezujemo se z vremenskim virom …</small><small id="weather-published">Modelna napoved · MET Norway</small></div><button type="button" id="weather-refresh" aria-label="Osveži vremensko napoved" title="Osveži napoved"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6.1 6.5A8 8 0 0 1 20 12M4 12a8 8 0 0 0 13.9 5.5"/></svg></button></div>
    <a class="line-link" href="/godovi/"><span><%= ui_icon('person') %> Godovi danes</span><%= ui_icon('chevron-right') %></a>
    <a class="card-credit" href="/fotografije-in-licence/">Fotografije, vremenski vir in licence</a>
  </div>
</section>
