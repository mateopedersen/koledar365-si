<section class="panel"><h2 id="personal-title"><%= ui_icon('check') %> Moj dan</h2><p><strong><%= sl_date(@selected) %></strong></p><div id="personal-events" aria-live="polite"></div><details id="event-editor"><summary><%= ui_icon('plus') %> Dodaj dogodek ali opravilo</summary><form id="personal-form"><input type="hidden" name="uid"><label>Naslov<input name="title" required maxlength="160"></label><div class="form-row"><label>Datum<input name="date" type="date" value="<%= @selected %>" required></label><label>Ura<input type="time" name="time"></label></div><label>Vrsta<select name="kind"><option value="event">Dogodek</option><option value="task">Opravilo</option></select></label><label>Koledar<select name="category"><option value="personal">Osebno</option><option value="work">Delo</option><option value="family">Družina</option><option value="school">Šola</option><option value="birthday">Rojstni dnevi</option></select></label><label>Ponavljanje<select name="repeat"><option value="">Brez ponavljanja</option><option value="yearly">Vsako leto</option></select></label><button class="primary">Shrani</button><button type="button" id="cancel-event">Prekliči</button></form></details></section>
<section class="panel"><h2><%= ui_icon('note') %> Zapiski</h2><label class="sr-only" for="day-notes">Zapiski za izbrani dan</label><textarea id="day-notes" rows="3" placeholder="Zapišite svoje načrte …"></textarea><button id="save-notes">Shrani zapiske</button><p id="notes-status" role="status"></p></section><section class="panel task-panel"><h2><%= ui_icon('check') %> Opravila</h2><div id="quick-tasks"></div><form id="quick-task-form"><label class="sr-only" for="quick-task-title">Novo opravilo</label><input id="quick-task-title" maxlength="160" placeholder="Dodaj opravilo …" required><button aria-label="Dodaj opravilo"><%= ui_icon('plus') %></button></form></section><section class="panel"><h2><%= ui_icon('calendar') %> Moj koledar</h2><div class="button-grid"><label class="button file-button"><%= ui_icon('upload') %> Uvozi ICS<input type="file" id="ics-file" accept=".ics,text/calendar"></label><button id="export-ics"><%= ui_icon('download') %> Izvozi ICS</button><button id="backup-data">Shrani varnostno kopijo</button><label class="button file-button">Obnovi kopijo<input type="file" id="restore-data" accept="application/json,.json"></label></div><p class="muted">Shranjeno v tem brskalniku. Pred menjavo naprave izvozite kopijo.</p><p id="personal-status" role="status"></p></section>
