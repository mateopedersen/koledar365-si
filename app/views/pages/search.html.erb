<div class="page-heading"><h1>Iskanje</h1><p><%= @q.blank? ? 'Vpišite ime, leto, mesec, praznik ali orodje.':"Rezultati za »#{@q}«" %></p></div><section class="panel"><% if @results.empty? %><p>Ni zadetkov. Poskusite krajši zapis, drugo ime ali leto od 2027 do 2030.</p><% else %><p><%= t('results',count:@results.size) %></p><ul class="search-results"><% @results.each do |r| %><li><a href="<%= r[:path] %>"><strong><%= r[:title] %></strong><small><%= r[:type] %></small></a></li><% end %></ul><% end %></section>
