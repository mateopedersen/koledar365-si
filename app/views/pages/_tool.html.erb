<% kind={'datumski-kalkulator'=>'date','kalkulator-delovnih-dni'=>'workdays','nacrtovalnik-dopusta'=>'vacation','odstevanje'=>'countdown','stevilka-tedna'=>'week','dan-v-letu'=>'ordinal','prestopno-leto'=>'leap'}[page_path.split('/').last] %>
<% if kind=='date' %>
<section class="panel date-tool" data-date-calculator>
  <div class="date-tool__intro">
    <div><span class="date-tool__eyebrow">HITRI IZRAČUN</span><h2>Izberite vrsto izračuna</h2><p>Vsi datumski izračuni so pripravljeni takoj. Rezultat lahko kopirate ali delite s povezavo.</p></div>
    <% calculator_icon = "#{IllustrationHelper.versioned_svg_url('/visuals/ui-material-v3.svg')}#calculator" %>
    <svg class="date-tool__icon" viewBox="0 0 64 64" aria-hidden="true" xmlns:xlink="http://www.w3.org/1999/xlink"><use href="<%= calculator_icon %>" xlink:href="<%= calculator_icon %>"/></svg>
  </div>
  <form class="date-tool__form" action="/izracun/" method="post" data-date-form>
    <%= hidden_field_tag :authenticity_token,form_authenticity_token %><input type="hidden" name="tool" value="date" data-date-tool>
    <div class="date-tabs" role="tablist" aria-label="Vrsta datumskega izračuna">
      <button type="button" role="tab" aria-selected="true" tabindex="0" id="date-tab-difference" aria-controls="date-pane-difference" data-date-mode="difference"><span class="date-tabs__icon" aria-hidden="true"><%= ui_icon('calendar') %></span>Razlika med datumoma</button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" id="date-tab-add" aria-controls="date-pane-add" data-date-mode="add"><span class="date-tabs__icon" aria-hidden="true"><%= ui_icon('plus') %></span>Prištej ali odštej</button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" id="date-tab-workdays" aria-controls="date-pane-workdays" data-date-mode="workdays"><span class="date-tabs__icon" aria-hidden="true"><%= ui_icon('briefcase') %></span>Delovni dnevi</button>
    </div>
    <fieldset class="date-pane" id="date-pane-difference" role="tabpanel" aria-labelledby="date-tab-difference" data-date-pane="difference">
      <legend class="visually-hidden">Izračun razlike med datumoma</legend>
      <div class="date-fields">
        <label>Začetni datum<input type="date" name="from" value="2027-01-01" required data-date-from></label>
        <button class="date-swap" type="button" aria-label="Zamenjaj začetni in končni datum" data-date-swap>⇄</button>
        <label>Končni datum<input type="date" name="to" value="2027-12-31" required data-date-to></label>
      </div>
      <div class="date-options">
        <label class="date-check"><input type="checkbox" name="inclusive" value="1" data-date-inclusive><span><strong>Vključi oba izbrana dneva</strong><small>Šteje tudi začetni in končni datum.</small></span></label>
        <div class="date-shortcuts" aria-label="Hitri časovni razponi"><span>Hiter izbor</span><button type="button" data-date-preset="7">1 teden</button><button type="button" data-date-preset="30">30 dni</button><button type="button" data-date-preset="90">90 dni</button><button type="button" data-date-preset="365">1 leto</button></div>
      </div>
    </fieldset>
    <fieldset class="date-pane" id="date-pane-add" role="tabpanel" aria-labelledby="date-tab-add" data-date-pane="add" hidden disabled>
      <legend class="visually-hidden">Prištevanje ali odštevanje časa</legend>
      <div class="date-fields date-fields--shift">
        <label>Izhodiščni datum<input type="date" name="from" value="2027-01-01" required data-shift-from></label>
        <label>Število<input type="number" name="delta" value="30" min="-100000" max="100000" step="1" required data-date-delta></label>
        <label>Časovna enota<select name="unit" data-date-unit><option value="days">dni</option><option value="weeks">tednov</option><option value="months">mesecev</option></select></label>
      </div>
      <p class="date-hint">Negativno število odšteje čas. Pri mesecih, ki nimajo izbranega dne, uporabimo zadnji dan tega meseca.</p>
    </fieldset>
    <fieldset class="date-pane" id="date-pane-workdays" role="tabpanel" aria-labelledby="date-tab-workdays" data-date-pane="workdays" hidden disabled>
      <legend class="visually-hidden">Štetje delovnih dni</legend>
      <div class="date-fields">
        <label>Začetni datum<input type="date" name="from" value="2027-01-01" min="2027-01-01" max="2030-12-31" required data-work-from></label>
        <button class="date-swap" type="button" aria-label="Zamenjaj začetni in končni datum" data-work-swap>⇄</button>
        <label>Končni datum<input type="date" name="to" value="2027-12-31" min="2027-01-01" max="2030-12-31" required data-work-to></label>
      </div>
      <div class="date-options date-options--work">
        <div class="date-weekdays" role="group" aria-label="Dnevi, ki jih štejemo kot delovne">
          <% CalendarEngine::DAYS.each_with_index do |d,i| %><label><input type="checkbox" name="weekdays[]" value="<%= i+1 %>" <%= 'checked' if i<5 %>><span><%= %w[P T S Č P S N][i] %></span><small><%= d %></small></label><% end %>
        </div>
        <div class="date-fields date-fields--hours"><label>Ure na dan<input type="number" min="0" max="24" step="0.25" name="hours" value="8" required data-work-hours></label><label class="date-check date-check--compact"><input type="checkbox" name="exclude_holidays" value="1" checked><span><strong>Izloči dela proste praznike</strong><small>Slovenski prazniki za leta 2027–2030</small></span></label></div>
      </div>
      <div class="date-boundaries"><label class="date-check date-check--compact"><input type="checkbox" name="include_start" value="1" checked><span><strong>Vključi začetni datum</strong></span></label><label class="date-check date-check--compact"><input type="checkbox" name="include_end" value="1" checked><span><strong>Vključi končni datum</strong></span></label></div>
      <p class="date-hint">Delovnih dni in zakonsko dela prostih praznikov je na voljo za leta 2027–2030.</p>
    </fieldset>
    <div class="date-submit-row"><button class="primary date-submit" type="submit" data-date-submit><span aria-hidden="true">✦</span> Izračunaj</button><span>Rezultat se posodobi tukaj na strani.</span></div>
  </form>
  <section class="date-result" aria-label="Rezultat datumskega izračuna" aria-live="polite" data-date-result>
    <div class="date-result__top"><div><span class="date-result__eyebrow" data-result-label>VAŠ REZULTAT</span><h2 data-result-title>Razlika med datumoma</h2><p data-result-summary>Izberite datuma in pritisnite Izračunaj.</p></div><div class="date-result__actions"><button type="button" class="date-copy date-copy--secondary" data-copy-result>Kopiraj rezultat</button><button type="button" class="date-copy" data-copy-link>Kopiraj povezavo</button></div></div>
    <div class="date-result__main"><strong data-result-primary>—</strong><span data-result-caption>Izračun bo prikazan tukaj.</span></div>
    <div class="date-result__stats">
      <div><span data-stat-label="one">Tedni + dnevi</span><strong data-stat="one">—</strong></div>
      <div><span data-stat-label="two">Polni meseci + dnevi</span><strong data-stat="two">—</strong></div>
      <div><span data-stat-label="three">Začetni dan</span><strong data-stat="three">—</strong></div>
      <div><span data-stat-label="four">Končni dan</span><strong data-stat="four">—</strong></div>
    </div>
    <p class="date-result__note" data-result-note hidden></p>
  </section>
</section>
<section class="date-guide" aria-label="Navodila za datumski kalkulator">
  <div class="date-guide__copy"><span class="date-guide__eyebrow">PREPROSTO IN NATANČNO</span><h2>En kalkulator za vse pomembne datume</h2><p>Preverite, koliko časa je med dogodki, načrtujte rok ali izračunajte delovne ure. Izberite način, vnesite datume in rezultat takoj dobite v jasnih enotah.</p>
    <ul class="date-benefits"><li><span>✓</span> Dnevi, tedni in koledarski meseci na enem mestu</li><li><span>✓</span> Izbirno štetje obeh mejnih datumov</li><li><span>✓</span> Delovni dnevi z upoštevanjem slovenskih praznikov</li><li><span>✓</span> Deljiva povezava do vaših nastavitev</li></ul>
  </div>
  <div class="date-guide__aside"><div class="date-guide__number">01 <span>→</span> 02</div><h3>Kako uporabiti kalkulator?</h3><ol><li>Izberite eno od treh orodij.</li><li>Vnesite datum ali časovno obdobje.</li><li>Rezultat kopirajte ali shranite kot povezavo.</li></ol><a href="/viri-in-metodologija/">Preberite, kako računamo <span aria-hidden="true">↗</span></a></div>
</section>
<section class="date-faq">
  <h2>Pogosta vprašanja o datumskih izračunih</h2>
  <% date_calculator_faq.each do |question,answer| %><details><summary><%= question %></summary><p><%= answer %></p></details><% end %>
</section>
<section class="date-related"><h2>Več koledarskih orodij</h2><div><a href="/kalkulator-delovnih-dni/"><strong>Kalkulator delovnih dni</strong><span>Pregled delovnih dni v izbranem letu.</span></a><a href="/odstevanje/"><strong>Odštevanje do datuma</strong><span>Spremljajte, koliko časa ostane do dogodka.</span></a><a href="/stevilka-tedna/"><strong>Številka tedna</strong><span>Preverite teden in pripadajoče datume.</span></a></div></section>
<% elsif kind=='workdays' %>
<section class="workday-tool" data-workday-calculator aria-labelledby="workday-tool-title">
  <div class="workday-tool__intro">
    <div><span class="workday-tool__eyebrow"><span aria-hidden="true">▦</span> ORODJE ZA NAČRTOVANJE</span><h2 id="workday-tool-title">Roki in delovne dni, izračunani po slovenskem koledarju</h2><p>Preštejte delovne dni med datumoma ali poiščite datum po določenem številu delovnih dni. Prilagodite svoj urnik in po želji izključite slovenske dela proste praznike.</p></div>
    <div class="workday-tool__quick-facts" aria-label="Značilnosti kalkulatorja"><span><strong>01</strong> obdobje</span><span><strong>02</strong> datum roka</span><span><strong>2027–2030</strong> koledar</span></div>
  </div>

  <div class="workday-tool__workspace">
    <div class="workday-tool__calculator">
      <div class="workday-tool__tabs" role="tablist" aria-label="Vrsta izračuna delovnih dni">
        <button type="button" role="tab" id="wdc-tab-range" aria-selected="true" aria-controls="wdc-panel-range" data-wdc-mode="range"><span aria-hidden="true">↔</span><span><strong>Dnevi med datumoma</strong><small>Obdobje, ure in prazniki</small></span></button>
        <button type="button" role="tab" id="wdc-tab-shift" aria-selected="false" aria-controls="wdc-panel-shift" data-wdc-mode="shift" tabindex="-1"><span aria-hidden="true">→</span><span><strong>Datum čez delovne dni</strong><small>Rok naprej ali nazaj</small></span></button>
      </div>

      <div class="workday-tool__panel" id="wdc-panel-range" role="tabpanel" aria-labelledby="wdc-tab-range" data-wdc-panel="range">
        <form action="/izracun/" method="post" data-wdc-form="range">
          <%= hidden_field_tag :authenticity_token,form_authenticity_token %><input type="hidden" name="tool" value="workdays">
          <div class="wdc-date-row">
            <label>Od <input type="date" name="from" value="2027-01-01" min="2027-01-01" max="2030-12-31" required data-wdc-from></label>
            <span class="wdc-date-row__connector" aria-hidden="true">→</span>
            <label>Do <input type="date" name="to" value="2027-12-31" min="2027-01-01" max="2030-12-31" required data-wdc-to></label>
          </div>
          <div class="wdc-presets" aria-label="Hitro izberi obdobje"><span>Hitri izbor</span><button type="button" data-wdc-preset="week">7 dni</button><button type="button" data-wdc-preset="month">30 dni</button><button type="button" data-wdc-preset="quarter">90 dni</button><button type="button" data-wdc-preset="year">Celo leto</button></div>
          <fieldset class="wdc-weekdays"><legend>Kateri dnevi so za vas delovni?</legend><div><% CalendarEngine::DAYS.each_with_index do |day,index| %><label><input type="checkbox" name="weekdays[]" value="<%= index+1 %>" <%= 'checked' if index<5 %>><span><%= CalendarEngine::SHORT_DAYS[index].capitalize %></span></label><% end %></div></fieldset>
          <div class="wdc-settings">
            <label class="wdc-hours">Delovnih ur na dan<input type="number" name="hours" min="0" max="24" step="0.25" value="8" inputmode="decimal" required></label>
            <label class="wdc-check"><input type="checkbox" name="exclude_holidays" value="1" checked><span><strong>Izključi dela proste praznike</strong><small>Uporabi uradni slovenski koledar</small></span></label>
          </div>
          <div class="wdc-boundaries"><span>Mejna datuma</span><label><input type="checkbox" name="include_start" value="1" checked><span>Vključi začetek</span></label><label><input type="checkbox" name="include_end" value="1" checked><span>Vključi konec</span></label></div>
          <button class="wdc-submit" type="submit"><span aria-hidden="true">✦</span> Izračunaj obdobje <b aria-hidden="true">→</b></button>
        </form>
      </div>

      <div class="workday-tool__panel" id="wdc-panel-shift" role="tabpanel" aria-labelledby="wdc-tab-shift" data-wdc-panel="shift" hidden>
        <form action="/izracun/" method="post" data-wdc-form="shift">
          <%= hidden_field_tag :authenticity_token,form_authenticity_token %><input type="hidden" name="tool" value="workday_shift">
          <div class="wdc-date-row wdc-date-row--shift"><label>Izhodiščni datum<input type="date" name="from" value="2027-01-01" min="2027-01-01" max="2030-12-31" required></label><label>Število delovnih dni<input type="number" name="delta" min="-1000" max="1000" step="1" value="10" required inputmode="numeric"></label></div>
          <p class="wdc-hint">Pozitivno število poišče datum naprej, negativno pa nazaj. Izhodiščni datum se ne šteje; začne se z naslednjim koledarskim dnem.</p>
          <fieldset class="wdc-weekdays"><legend>Kateri dnevi so za vas delovni?</legend><div><% CalendarEngine::DAYS.each_with_index do |day,index| %><label><input type="checkbox" name="weekdays[]" value="<%= index+1 %>" <%= 'checked' if index<5 %>><span><%= CalendarEngine::SHORT_DAYS[index].capitalize %></span></label><% end %></div></fieldset>
          <label class="wdc-check wdc-check--single"><input type="checkbox" name="exclude_holidays" value="1" checked><span><strong>Izključi dela proste praznike</strong><small>Upošteva le praznike, ki so po zakonu dela prosti.</small></span></label>
          <button class="wdc-submit" type="submit"><span aria-hidden="true">✦</span> Poišči datum <b aria-hidden="true">→</b></button>
        </form>
      </div>
    </div>

    <aside class="wdc-result" data-wdc-result aria-live="polite" aria-atomic="true">
      <div class="wdc-result__top"><span class="wdc-result__icon" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M8 4v5m16-5v5M5 12h22M7 7h18a2 2 0 0 1 2 2v17H5V9a2 2 0 0 1 2-2Z"/><path d="m11 19 3 3 7-7"/></svg></span><span class="workday-tool__eyebrow">VAŠ IZRAČUN</span></div>
      <h2 data-wdc-title>Pregled vašega obdobja</h2><p class="wdc-result__summary" data-wdc-summary>Vnesite datuma in urnik, nato izberite »Izračunaj obdobje«.</p>
      <div class="wdc-result__primary"><strong data-wdc-primary>—</strong><span data-wdc-caption>delovnih dni</span></div>
      <div class="wdc-result__stats"><div><span data-wdc-label="calendar">Koledarski dnevi</span><strong data-wdc-stat="calendar">—</strong></div><div><span data-wdc-label="hours">Skupaj delovnih ur</span><strong data-wdc-stat="hours">—</strong></div><div><span data-wdc-label="holidays">Izločeni prazniki</span><strong data-wdc-stat="holidays">—</strong></div></div>
      <p class="wdc-result__detail" data-wdc-detail>Rezultat se prikaže tukaj in ga lahko kopirate ali delite.</p>
      <div class="wdc-result__actions"><button type="button" data-wdc-copy>⧉ Kopiraj rezultat</button><button type="button" data-wdc-share>↗ Deli izračun</button></div>
      <p class="wdc-result__status" data-wdc-status role="status"></p>
    </aside>
  </div>

  <div class="workday-tool__trust"><span aria-hidden="true">✓</span><p><strong>Ločimo praznik od prostega dne.</strong> Nekateri državni prazniki v Sloveniji niso dela prosti. Kalkulator odšteje samo uradno določene dela proste praznike in jih ne prenese na ponedeljek, če padejo na vikend. <a href="https://www.gov.si/teme/drzavni-prazniki-in-dela-prosti-dnevi/" target="_blank" rel="noopener">Preverite seznam GOV.SI ↗</a></p></div>
</section>

<section class="wdc-guide" aria-label="Kako uporabljati kalkulator delovnih dni">
  <div><span class="workday-tool__eyebrow">VEČ KOT EN SAM SEŠTEVEK</span><h2>Načrtujte roke, izmene in dopust z manj ugibanja</h2><p>Kalkulator je namenjen hitremu informativnemu štetju. Nastavite svoj delovni teden — na primer tudi soboto — ter število ur na dan. Deljene povezave ohranijo izbrani način in vnose, da lahko rezultat pošljete naprej.</p></div>
  <div class="wdc-guide__links"><a href="/delovni-dnevi/"><span>▦</span><strong>Letni pregled</strong><small>Primerjajte delovne dneve po mesecih.</small><b aria-hidden="true">↗</b></a><a href="/nacrtovalnik-dopusta/"><span>✦</span><strong>Načrtovalnik dopusta</strong><small>Odkrijte, kako s prazniki sestaviti daljši oddih.</small><b aria-hidden="true">↗</b></a><a href="/prazniki/"><span>◇</span><strong>Slovenski prazniki</strong><small>Oglejte si datume in uradni status praznikov.</small><b aria-hidden="true">↗</b></a></div>
</section>
<section class="wdc-faq"><h2>Najpogostejša vprašanja</h2><details><summary>Kaj šteje kot delovni dan v tem izračunu?</summary><p>Privzeto so to dnevi od ponedeljka do petka. Izberete lahko svoj urnik, nato pa se pri vključenem prazničnem filtru odštejejo zakonsko določeni dela prosti dnevi, ki padejo na izbrani delovni dan.</p></details><details><summary>Ali se praznik, ki pade na soboto ali nedeljo, prenese?</summary><p>Kalkulator praznika ne prenese samodejno na ponedeljek. V Sloveniji niso vsi državni prazniki dela prosti dnevi; upoštevamo koledar dela prostih dni, objavljen na GOV.SI.</p></details><details><summary>Ali je rezultat uradni izračun zakonskega roka ali dopusta?</summary><p>Ne. Orodje poda informativno štetje po izbranih pravilih. Predpisani roki, kolektivne pogodbe, izmenski urniki in pravila delodajalca lahko uporabljajo drugačna pravila.</p></details></section>

<% else %><section class="panel tool-panel"><form class="api-form" action="/izracun/" method="post"><%= hidden_field_tag :authenticity_token,form_authenticity_token %><input type="hidden" name="tool" value="<%= kind %>">
<% if %w[date workdays].include?(kind) %><div class="form-row"><label>Začetni datum<input type="date" name="from" value="2027-01-01" required></label><label>Končni datum<input type="date" name="to" value="2027-12-31" required></label></div>
<% if kind=='workdays' %><fieldset><legend>Delovni dnevi v tednu</legend><% CalendarEngine::DAYS.each_with_index do |d,i| %><label class="check"><input type="checkbox" name="weekdays[]" value="<%= i+1 %>" <%= 'checked' if i<5 %>><%= d %></label><% end %></fieldset><label>Dnevne ure<input type="number" min="0" max="24" step="0.25" name="hours" value="8" required></label><label class="check"><input type="checkbox" name="exclude_holidays" value="1" checked>Izloči zakonske dela proste dneve</label><label class="check"><input type="checkbox" name="include_start" value="1" checked>Vključi začetni datum</label><label class="check"><input type="checkbox" name="include_end" value="1" checked>Vključi končni datum</label>
<% else %><label class="check"><input type="checkbox" name="inclusive" value="1">Vključi tudi končni dan v razliko</label><div class="form-row"><label>Dodaj ali odštej<input name="delta" type="number" value="0" min="-100000" max="100000"></label><label>Enota<select name="unit"><option value="days">Dnevi</option><option value="weeks">Tedni</option><option value="months">Meseci</option></select></label></div><% end %>
<% elsif kind=='vacation' %><label>Leto<select name="year"><% (2027..2030).each do |y| %><option><%= y %></option><% end %></select></label><label>Največ dni dopusta<input type="number" name="budget" value="3" min="0" max="20" required></label><p>Izračun uporablja delovni teden ponedeljek–petek.</p>
<% else %><label>Datum<input type="date" name="date" value="<%= @selected %>" required></label><% if kind=='countdown' %><div class="form-row"><label>Ura<input type="time" name="time" value="00:00" required></label><label>Časovni pas<select name="zone"><% %w[Europe/Ljubljana Europe/London America/New_York Asia/Tokyo UTC].each do |zone| %><option><%= zone %></option><% end %></select></label></div><p>Deljena povezava vsebuje samo datum, uro in časovni pas.</p><output id="live-countdown" class="countdown-display" aria-live="off"></output><button type="button" id="share-countdown" hidden>Kopiraj povezavo</button><% end %><% end %><button class="primary">Izračunaj</button><output class="result" aria-live="polite"></output></form><p><a href="/viri-in-metodologija/">Kako računamo</a></p></section>
<% end %>
