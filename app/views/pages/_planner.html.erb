<% type={'ustvari-koledar'=>'name','prazen-koledar'=>'blank','razpored-izmen'=>'shift','solski-urnik'=>'school','rojstnodnevni-koledar'=>'birthday','dnevni-planer'=>'daily','druzinski-planer'=>'family','koledar-za-tiskanje'=>'annual'}[page_path.split('/').last] || 'weekly';type=params[:type] if PrintCatalog::TYPES.key?(params[:type]) %>
<% if type=='school' %><%= render 'student_timetable' %><% end %>
<% if type=='shift' %>
<%= render 'shift_schedule' %>
<% else %>
<% if type=='family' %><%= render 'family_planner' %><% end %>
<div class="download-workspace" data-download-workspace>
<section class="panel planner-workbench gallery-context<%= ' student-print-bridge' if type=='school' %>" <%= 'hidden' if type=='school' %>>
  <%= render 'context_heading', title: 'Prilagodite svoj koledar', expand: 'Razširi nastavitve' %>
  <div class="context-content" id="gallery-context-content">
  <form id="planner-options" data-planner-type="<%= type %>">
    <div class="filters">
      <label>Leto<select name="year"><% (2027..2030).each do |y| %><option <%= 'selected' if y==@year %>><%= y %></option><% end %></select></label>
      <label>Mesec<select name="month"><% CalendarEngine::MONTHS.each_with_index do |m,i| %><option value="<%= i+1 %>" <%= 'selected' if i+1==@month %>><%= m %></option><% end %></select></label>
      <label>Izbrani datum<input type="date" name="date" min="2027-01-01" max="2030-12-31" value="<%= @selected&.year==@year && @year!=2026 ? @selected : Date.new(@year==2026 ? 2027 : @year,@month,1) %>" required></label>
      <label>Vrsta<select name="type"><% PrintCatalog::TYPES.each do |value,label| %><option value="<%= value %>" <%= 'selected' if value==type %>><%= label %></option><% end %></select></label>
    </div>
    <details class="planner-advanced"><summary>Ime, zapiski in dodatne možnosti</summary>
    <label>Ime (neobvezno)<input name="name" maxlength="100" placeholder="Ana"></label>
    <label>Osebni zapiski (neobvezno)<textarea name="notes" maxlength="2000" rows="2"></textarea></label>
    <div class="filters" data-planner-fields="blank">
      <label>Datumi<select name="undated"><option value="1">Brez datumov</option><option value="0">Z datumi</option></select></label>
      <label>Razporeditev<select name="blank_layout"><option value="monthly">Mesečna mreža</option><option value="weekly">Tedenski načrt</option></select></label>
      <label>Prostor za zapiske<select name="ruling"><option value="lined">Črte</option><option value="plain">Brez črt</option><option value="dotted">Pike</option></select></label>
    </div>
    <div data-planner-fields="birthday"><label>29. februar v neprestopnem letu<select name="leap_policy"><option value="feb28">28. februar</option><option value="march1">1. marec</option><option value="leap_only">Samo prestopna leta</option></select></label><p>Izvirni rojstni datum ostane shranjen. Izvoz ICS vsebuje izbrane rojstne dneve za leta 2027–2030.</p></div>
    <div data-planner-fields="daily" class="filters"><label>Prva ura<input name="start_hour" type="number" min="0" max="23" value="7" required></label><label>Zadnja ura<input name="end_hour" type="number" min="0" max="23" value="21" required></label></div>
    <details class="photo-upload"><summary>Dodajte svojo fotografijo</summary><p>JPEG, PNG ali WebP do 20 MB, najmanj 900 × 600 slikovnih pik. Fotografija se natisne v glavi koledarja pri najmanj 600 ppi. Podatke o lokaciji odstranimo.</p><label>Fotografija<input id="calendar-photo" type="file" accept="image/jpeg,image/png,image/webp"></label><input type="hidden" name="photo_token" value=""><button id="remove-photo" type="button" hidden>Odstrani fotografijo</button><output id="photo-status" role="status"></output></details>
    <p class="muted">Vnosi ostanejo na tej napravi. Za osebni predogled in prenos jih pošljemo strežniku; fotografije in zasebne izvoze izbrišemo po sedmih dneh.</p>
    </details>
    <button type="button" id="save-planner">Shrani nastavitve</button><output id="planner-message" role="status"></output>
  </form>
  <details class="planner-inputs"><summary>Dodajte obveznosti ali osebne vnose</summary><p>Dodajte obveznosti, izmene, predmete ali rojstne dneve. Kratek pregled v mreži dopolnjuje celoten seznam vseh vnosov v PDF-ju.</p>
    <form id="planner-entry"><input type="hidden" name="entry_id"><div class="filters">
      <label>Datum<input name="date" type="date" value="2027-01-04" required></label>
      <label>Začetek<input name="time" type="time"></label><label>Konec<input name="end_time" type="time"></label>
      <label>Odmor (minute)<input name="break" type="number" min="0" max="1440" step="1"></label>
      <label>Oseba<input name="person" maxlength="80"></label><label>Naslov / predmet<input name="title" maxlength="200" required></label>
      <label>Koda izmene<input name="code" maxlength="20"></label><label>Učilnica<input name="room" maxlength="80"></label>
    </div><label>Opombe<input name="notes" maxlength="200"></label><label class="check"><input name="done" type="checkbox" value="1">Opravljeno</label><div data-planner-fields="school"><label class="check"><input id="repeat-school" type="checkbox">Ponovi vsak teden na isti dan</label><label>Do datuma<input id="repeat-school-until" type="date" value="2027-06-24"></label></div><div class="actions"><button id="save-planner-entry">Dodaj vnos</button><button id="cancel-planner-entry" type="button" hidden>Prekliči urejanje</button></div></form>
    <p class="muted">Konec pred začetkom pomeni naslednji dan. ICS ohrani celotno časovno obdobje; odmor je zapisan v opisu.</p>
    <div id="planner-entries" aria-live="polite"></div>
    <div class="actions planner-backup-actions"><button id="planner-ics" type="button">Izvozi vnose ICS</button><button id="planner-backup" type="button">Varnostna kopija</button><label class="file-button">Obnovi kopijo<input id="planner-restore" type="file" accept="application/json,.json"></label></div><output id="planner-entry-status" role="status"></output>
  </details>
  <section data-planner-fields="shift"><h2>Ponavljajoči se razpored</h2><form class="api-form" id="shift-form" action="/izracun/" method="post"><%= hidden_field_tag :authenticity_token,form_authenticity_token %><input name="tool" type="hidden" value="shift"><div class="filters"><label>Začetek cikla<input type="date" name="from" value="2027-01-04" required></label><label>Konec obdobja<input type="date" name="to" value="2027-01-31" required></label><label>Cikel (ločite z vejico)<input name="cycle" value="D,D,N,N,Prosto,Prosto" required></label><label>Oseba<input name="person" maxlength="80"></label></div><p>Izračun zamenja trenutne vnose. Po potrebi prej shranite varnostno kopijo.</p><button>Izračunaj razpored</button><output class="result" aria-live="polite"></output></form></section>
</div>
</section>
<%= render 'designs',type:type %>
</div>
<% end %>
